---
import BaseLayout from '../layouts/BaseLayout.astro';
import BildungstraegerPage from '../components/sections/BildungstraegerPage.astro';
import { istVeroeffentlicht } from '../data/bildungstraeger';

const lang = 'de';
const title = 'Zugelassener Bildungsträger nach AZAV';
const description =
  'Die WAMOCON Academy GmbH ist durch die GZQ GmbH als Bildungsträger nach AZAV zugelassen. Was das bedeutet und wie der Weg zum Bildungsgutschein abläuft.';
// noindex, solange die Zertifikatsnummer in src/data/bildungstraeger.ts fehlt.
const noindex = !istVeroeffentlicht();
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  noindex={noindex}
>
  <BildungstraegerPage lang={lang} />
</BaseLayout>
