---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AcademyHome from '../../components/sections/AcademyHome.astro';
import { pageMeta } from '../../data/academy';
import { academyFaq } from '../../data/faq';
import FaqSection from '../../components/ui/FaqSection.astro';

const lang = 'en';
const isDe = lang === 'de';
const origin = (Astro.site ?? new URL('https://test-it-academy.com')).origin;
const faq = academyFaq[lang];

const courseSchema = [
  {
    '@type': 'Course',
    name: isDe
      ? 'ISTQB Certified Tester Foundation Level (CTFL) 4.0'
      : 'ISTQB Certified Tester Foundation Level (CTFL) 4.0',
    description: isDe
      ? 'Vorbereitungskurs auf die ISTQB-Zertifizierung Certified Tester Foundation Level 4.0. Vermittelt Testgrundlagen, Testentwurfsverfahren, Testmanagement und Testwerkzeuge mit vielen Praxisbeispielen.'
      : 'Preparation course for the ISTQB Certified Tester Foundation Level 4.0 certification. Covers testing fundamentals, test-design techniques, test management and test tools with extensive practical examples.',
    provider: { '@id': `${origin}/#organization` },
    inLanguage: isDe ? 'de-DE' : 'en-GB',
    educationalCredentialAwarded: 'ISTQB Certified Tester Foundation Level 4.0',
    teaches: ['Software testing fundamentals', 'Test design techniques', 'Test management', 'Test tools'],
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: ['onsite', 'online'],
      courseWorkload: 'P3D',
      location: {
        '@type': 'Place',
        name: 'WAMOCON Academy GmbH',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Mergenthalerallee 79–81',
          postalCode: '65760',
          addressLocality: 'Eschborn',
          addressCountry: 'DE',
        },
      },
    },
  },
  {
    '@type': 'Course',
    name: 'ISTQB Agile Tester 1.0',
    description: isDe
      ? 'Zertifizierungstraining für Softwaretests in agilen Projekten nach dem ISTQB-Lehrplan Agile Tester 1.0, einschließlich Testen in Scrum-Teams.'
      : 'Certification training for software testing in agile projects following the ISTQB Agile Tester 1.0 syllabus, including testing within Scrum teams.',
    provider: { '@id': `${origin}/#organization` },
    inLanguage: isDe ? 'de-DE' : 'en-GB',
    educationalCredentialAwarded: 'ISTQB Certified Tester Agile Tester',
    teaches: ['Agile testing', 'Testing in Scrum', 'Agile test techniques'],
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: ['onsite', 'online'],
      location: {
        '@type': 'Place',
        name: 'WAMOCON Academy GmbH',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Mergenthalerallee 79–81',
          postalCode: '65760',
          addressLocality: 'Eschborn',
          addressCountry: 'DE',
        },
      },
    },
  },
  {
    '@type': 'Course',
    name: isDe ? '360° Booster System' : '360-degree Booster System',
    description: isDe
      ? 'Strukturiertes Einstiegsprogramm in den Beruf des Softwaretesters. Verbindet die ISTQB-Zertifizierungsvorbereitung mit praktischer Projektreife und Mentoring durch Trainer aus laufenden IT-Projekten.'
      : 'Structured career-entry programme for software testers. Combines ISTQB certification preparation with practical project readiness and mentoring from trainers working on live IT projects.',
    provider: { '@id': `${origin}/#organization` },
    inLanguage: isDe ? 'de-DE' : 'en-GB',
    teaches: ['Software testing career entry', 'Test design', 'Defect management'],
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: ['onsite', 'online'],
      location: {
        '@type': 'Place',
        name: 'WAMOCON Academy GmbH',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Mergenthalerallee 79–81',
          postalCode: '65760',
          addressLocality: 'Eschborn',
          addressCountry: 'DE',
        },
      },
    },
  },
];

---

<BaseLayout title={pageMeta[lang].title} description={pageMeta[lang].description} lang={lang} schema={courseSchema}>
  <AcademyHome lang={lang} />
  <FaqSection
    heading={faq.heading}
    intro={faq.intro}
    items={faq.items}
    lang={lang}
    bylineName="Dipl.-Ing. Waleri Moretz"
    bylineRole="Managing Director, WAMOCON Academy GmbH — ISTQB-accredited training provider"
    lastReviewed="2026-07-22"
   
  />
</BaseLayout>
