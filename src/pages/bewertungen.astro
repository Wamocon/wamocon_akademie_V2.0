---
import BaseLayout from '../layouts/BaseLayout.astro';
import AcademyPage from '../components/sections/AcademyPage.astro';
import { pages } from '../data/academy';

const lang = 'de';
const page = pages.reviews[lang];
---

<BaseLayout title={page.title} description={page.lead} lang={lang} image={pages.reviews.image}>
  <AcademyPage lang={lang} pageKey="reviews" />
</BaseLayout>
