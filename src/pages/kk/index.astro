---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AcademyHome from '../../components/sections/AcademyHome.astro';
import { pageMeta } from '../../data/academy';
import { academyFaq } from '../../data/faq';
import { courseInstancesFor, offersFor } from '../../data/catalog';
import FaqSection from '../../components/ui/FaqSection.astro';

const lang = 'kk';
const origin = (Astro.site ?? new URL('https://test-it-academy.com')).origin;
const faq = academyFaq[lang];

const location = {
  '@type': 'Place',
  name: 'WAMOCON Academy GmbH',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mergenthalerallee 79–81',
    postalCode: '65760',
    addressLocality: 'Eschborn',
    addressCountry: 'DE',
  },
};

const courseSchema = [
  {
    '@type': 'Course',
    name: 'ISTQB Certified Tester Foundation Level (CTFL) 4.0',
    description:
      'ISTQB Certified Tester Foundation Level 4.0 сертификаттауына дайындық курсы. Тестілеу негіздерін, тест жобалау әдістерін, тестілеуді басқаруды және тестілеу құралдарын көптеген тәжірибелік мысалмен береді.',
    provider: { '@id': `${origin}/#organization` },
    inLanguage: 'kk-KZ',
    educationalCredentialAwarded: 'ISTQB Certified Tester Foundation Level 4.0',
    teaches: ['Software testing fundamentals', 'Test design techniques', 'Test management', 'Test tools'],
    ...(offersFor('ctfl40', origin) ? { offers: offersFor('ctfl40', origin) } : {}),
    hasCourseInstance: courseInstancesFor('ctfl40', {
      '@type': 'CourseInstance',
      courseMode: ['onsite', 'online'],
      courseWorkload: 'P3D',
      location,
    }),
  },
  {
    '@type': 'Course',
    name: 'ISTQB Agile Tester 1.0',
    description:
      'ISTQB Agile Tester 1.0 оқу бағдарламасы бойынша икемді жобалардағы тестілеуге арналған сертификаттау тренингі, оның ішінде Scrum командаларындағы тестілеу.',
    provider: { '@id': `${origin}/#organization` },
    inLanguage: 'kk-KZ',
    educationalCredentialAwarded: 'ISTQB Certified Tester Agile Tester',
    teaches: ['Agile testing', 'Testing in Scrum', 'Agile test techniques'],
    ...(offersFor('agileTester10', origin) ? { offers: offersFor('agileTester10', origin) } : {}),
    hasCourseInstance: courseInstancesFor('agileTester10', {
      '@type': 'CourseInstance',
      courseMode: ['onsite', 'online'],
      location,
    }),
  },
  {
    '@type': 'Course',
    name: '360° Booster System',
    description:
      'Тестілеуші мамандығына құрылымды түрде кірістіретін бағдарлама. ISTQB сертификаттауына дайындықты нақты жобаға дайын болумен және тәжірибеде істеп жүрген тестілеу менеджерлерінің тәлімгерлігімен ұштастырады.',
    provider: { '@id': `${origin}/#organization` },
    inLanguage: 'kk-KZ',
    teaches: ['Software testing career entry', 'Test design', 'Defect management'],
    ...(offersFor('booster360', origin) ? { offers: offersFor('booster360', origin) } : {}),
    hasCourseInstance: courseInstancesFor('booster360', {
      '@type': 'CourseInstance',
      courseMode: ['onsite', 'online'],
      location,
    }),
  },
];
---

<BaseLayout title={pageMeta[lang].title} description={pageMeta[lang].description} lang={lang} schema={courseSchema}>
  <AcademyHome lang={lang} />
  <FaqSection
    heading={faq.heading}
    intro={faq.intro}
    items={faq.items}
    lang={lang}
    bylineName="Dipl.-Ing. Waleri Moretz"
    bylineRole="WAMOCON Academy GmbH атқарушы директоры, ISTQB аккредиттеген оқыту провайдері"
    lastReviewed="2026-07-22"
  />
</BaseLayout>
