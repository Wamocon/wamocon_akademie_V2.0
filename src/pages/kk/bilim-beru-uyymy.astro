---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BildungstraegerPage from '../../components/sections/BildungstraegerPage.astro';
import { istVeroeffentlicht } from '../../data/bildungstraeger';

const lang = 'kk';
// Muttersprachliche Prüfung offen
const title = 'AZAV бойынша рұқсат алған білім беру ұйымы';
// Muttersprachliche Prüfung offen
const description =
  'WAMOCON Academy GmbH GZQ GmbH-тан AZAV бойынша білім беру ұйымы ретінде рұқсат алды. Бұл нені білдіретіні және Bildungsgutschein арқылы қаржыландыру қалай жүретіні.';
// noindex until the certificate number is entered in src/data/bildungstraeger.ts.
const noindex = !istVeroeffentlicht();
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  noindex={noindex}
>
  <BildungstraegerPage lang={lang} />
</BaseLayout>
