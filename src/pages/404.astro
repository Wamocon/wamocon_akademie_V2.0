---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'de';
---

<BaseLayout title="Fehler 404" description="Die gewünschte Seite wurde nicht gefunden." lang={lang} noindex>
  <section class="not-found page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__copy">
        <h1>Fehler 404</h1>
        <p>Die gewünschte Seite wurde nicht gefunden.</p>
        <a href="/">Startseite</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found h1 { margin: 0 0 1.25rem; color: var(--color-text); }
  .not-found p { color: var(--color-muted); }
  .not-found a { display: inline-flex; margin-top: 1.5rem; color: var(--color-accent); font-weight: var(--fw-semibold); }
</style>
