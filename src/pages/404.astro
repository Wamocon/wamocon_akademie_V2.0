---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'de';
---

<BaseLayout title="Fehler 404" description="Die gewünschte Seite wurde nicht gefunden." lang={lang}>
  <section class="not-found surface-light">
    <div class="container">
      <span class="eyebrow">Fehler 404</span>
      <h1>Fehler 404</h1>
      <p>Die gewünschte Seite wurde nicht gefunden.</p>
      <a href="/">Startseite</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 70vh; padding-block: clamp(6rem, 12vw, 10rem); }
  .not-found h1 { margin: 1rem 0; color: var(--color-text-dark); }
  .not-found p { color: var(--color-muted-dark); }
  .not-found a { display: inline-flex; margin-top: 1.5rem; color: var(--color-accent); font-weight: var(--fw-semibold); }
</style>
