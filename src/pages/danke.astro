---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'de';
---

<BaseLayout title="Danke" description="Vielen Dank für Ihre Anfrage bei WAMOCON Academy." lang={lang} noindex>
  <section class="thank-you page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__copy">
        <h1>Danke</h1>
        <p>Ihre Anfrage wurde gesendet. Wir melden uns schnellstmöglich bei Ihnen.</p>
        <a href="/">Zur Startseite</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you h1 { margin: 0 0 1.25rem; color: var(--color-text); }
  .thank-you p { max-width: 54ch; color: var(--color-muted); }
  .thank-you a { display: inline-flex; margin-top: 1.5rem; color: var(--color-accent); font-weight: var(--fw-semibold); }
</style>
