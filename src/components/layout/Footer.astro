---
import { assets } from '../../data/academy';
import { company, legalNav, nav, ui, type Lang } from '../../i18n/config';
import OfficeMap from '../ui/OfficeMap.astro';

interface Props { lang: Lang; showContact?: boolean; }

const { lang, showContact = true } = Astro.props;
const t = (key: keyof (typeof ui)['de']) => ui[lang][key];
const year = new Date().getFullYear();
const primaryLinks = nav.filter((item) => ['home', 'courses', 'certification', 'ditele'].includes(item.key));
const aboutLinks = nav.find((item) => item.key === 'about-group')?.children ?? [];
const labels = lang === 'de'
  ? { title: 'Kontakt', location: 'Standort:', phone: 'Telefon:', email: 'E-Mail:', hours: 'Öffnungszeiten:', follow: 'Folgen Sie uns auf\nsozialen Medien' }
  : { title: 'Contact us', location: 'Location:', phone: 'Phone:', email: 'E-Mail:', hours: 'Opening hours:', follow: 'Follow us on\nsocial media' };
const privacySettings = lang === 'de' ? 'Datenschutzeinstellungen' : 'Privacy settings';
const socialLinks = [
  { label: 'YouTube', href: company.social.youtube, icon: '/images/icon-youtube.svg' },
  { label: 'LinkedIn', href: company.social.linkedin, icon: '/images/icon-linkedin.svg' },
  { label: 'Instagram', href: company.social.instagram, icon: '/images/icon-instagram.svg' },
  { label: 'Facebook', href: company.social.facebook, icon: '/images/icon-facebook.svg' },
];
const aiNotice = lang === 'de'
  ? 'Texte, Bilder, Videos, Audios und Grafiken, die hier bereitgestellt werden, können teilweise mit Künstlicher Intelligenz (KI) erstellt worden sein. Jeder generierte Inhalt wurde sorgfältig überprüft, um Qualität und Genauigkeit sicherzustellen. Mit diesem Hinweis erfüllen wir unsere Transparenzpflicht.'
  : 'Texts, images, videos, audio and graphics provided here may have been created in part using artificial intelligence (AI). Every generated item has been carefully reviewed to ensure quality and accuracy. This notice fulfils our transparency obligation.';
---

{showContact && (
<section class="footer-contact container" aria-labelledby="footer-contact-title">
    <div class="footer-contact__copy" data-reveal>
      <h2 id="footer-contact-title">{labels.title}</h2>
      <p class="footer-contact__company">{company.name}</p>
      <address>
        <strong>{labels.location}</strong>
        <span>{company.street}<br />{company.city}</span>
        <strong>{labels.phone}</strong>
        <a href={company.phoneHref}>{company.phone}</a>
        <strong>{labels.email}</strong>
        <a href={company.emailHref}>{company.email}</a>
        <strong>{labels.hours}</strong>
        <span>{company.hours[lang].map((line) => <>{line}<br /></>)}</span>
      </address>
      <div class="footer-contact__socials">
        <span>{labels.follow.split('\n').map((line) => <>{line}<br /></>)}</span>
        <ul>
          {socialLinks.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
                <img src={social.icon} alt="" width="31" height="31" loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <figure class="footer-contact__image" data-reveal>
      <img src={assets.workspace} alt={lang === 'de' ? 'Arbeitsplatz der WAMOCON Academy' : 'WAMOCON Academy workplace'} width="1680" height="1120" loading="lazy" />
      <figcaption><span>G</span> 5.0<small>★★★★★</small></figcaption>
    </figure>
</section>
)}

<OfficeMap lang={lang} compact />

<footer class="footer">
  <div class="footer__bottom container">
    <div class="footer__brand">
      <img src={assets.footerLogo} alt="WAMOCON Academy" width="180" height="180" loading="lazy" />
      <p>© {year} {company.name}.<br />{t('footer.rights')}</p>
    </div>
    <nav aria-label={t('footer.navigation')}>
      {primaryLinks.map((item) => <a href={item[lang].href}>{item[lang].label}</a>)}
    </nav>
    <nav aria-label={lang === 'de' ? 'Über die Academy' : 'About the Academy'}>
      {aboutLinks.map((item) => <a href={item[lang].href}>{item[lang].label}</a>)}
    </nav>
    <nav aria-label={lang === 'de' ? 'Rechtliches' : 'Legal'}>
      <a href={legalNav.privacy[lang].href}>{legalNav.privacy[lang].label}</a>
      <a href={legalNav.imprint[lang].href}>{legalNav.imprint[lang].label}</a>
      <button class="footer__privacy" type="button" data-open-consent-settings>{privacySettings}</button>
    </nav>
  </div>
  <p class="footer__ai-notice container">{aiNotice}</p>
</footer>

<style>
  .footer { background: #101010; }
  .footer-contact { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: 70px; align-items: center; padding-block: 90px 65px; background: #101010; }
  .footer-contact__copy h2 { margin-bottom: 8px; font-size: 38px; }
  .footer-contact__company { margin-bottom: 22px; color: #fff; font-size: 16px; }
  .footer-contact address { display: grid; font-style: normal; }
  .footer-contact address strong { margin-top: 9px; color: #ff0b00; font-size: 14px; font-weight: 400; }
  .footer-contact address span,
  .footer-contact address a { color: #fff; font-size: 15px; line-height: 1.45; }
  .footer-contact__socials { display: flex; align-items: center; gap: 9px; margin-top: 18px; }
  .footer-contact__socials > span { margin-right: 4px; color: #ff0b00; font-size: 13px; line-height: 1.15; }
  .footer-contact__socials ul {
    display: flex !important;
    flex-flow: row nowrap !important;
    align-items: center;
    gap: 9px;
    width: auto;
  }
  .footer-contact__socials li { display: block; flex: 0 0 auto; }
  .footer-contact__socials a,
  .footer-contact__socials img { display: block; width: 31px; height: 31px; }
  .footer-contact__socials a { border-radius: 50%; transition: transform var(--dur-fast) var(--ease-out); }
  .footer-contact__socials a:hover { transform: translateY(-2px); }
  .footer-contact__image { position: relative; min-height: 450px; overflow: hidden; }
  .footer-contact__image > img { width: 100%; height: 100%; min-height: 450px; object-fit: cover; }
  .footer-contact__image figcaption { position: absolute; left: 24px; bottom: 20px; display: grid; grid-template-columns: auto 1fr; padding: 5px 8px; border: 2px solid #171717; background: #fff; color: #111; font-size: 20px; line-height: 1; }
  .footer-contact__image figcaption span { margin-right: 4px; color: #4285f4; font-weight: 700; }
  .footer-contact__image figcaption small { grid-column: 1 / -1; color: #ff0b00; font-size: 10px; letter-spacing: 1px; }
  .footer__bottom { display: grid; grid-template-columns: 1.25fr 1fr 1fr .8fr; gap: clamp(2rem, 5vw, 5.5rem); max-width: var(--container-max); padding-block: clamp(3rem, 6vw, 5.5rem); color: #fff; font-size: 13px; }
  .footer__brand img { width: min(145px, 45vw); height: auto; margin-bottom: 20px; }
  .footer__bottom nav { display: grid; align-content: start; gap: 12px; }
  .footer__bottom a { color: #fff; }
  .footer__bottom a:hover { color: var(--color-accent); }
  .footer__privacy { width: fit-content; color: #fff; font-size: inherit; text-align: left; text-decoration: underline; text-underline-offset: .22em; }
  .footer__privacy:hover { color: var(--color-accent); }
  .footer__ai-notice { max-width: 1100px; margin: 0 auto; padding-bottom: clamp(2rem, 5vw, 4rem); color: rgba(255,255,255,.68); font-size: .78rem; line-height: 1.6; text-align: center; }
  @media (max-width: 820px) {
    .footer-contact { grid-template-columns: 1fr; gap: 45px; padding-block: 70px 45px; }
    .footer-contact__image,
    .footer-contact__image > img { min-height: 330px; }
    .footer__bottom { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .footer__bottom { grid-template-columns: 1fr; } }
</style>
