---
import { assets } from '../../data/academy';
import { company, legalNav, nav, ui, type Lang } from '../../i18n/config';
import { pick } from '../../i18n/utils';
import OfficeMap from '../ui/OfficeMap.astro';
import LeadForm from '../sections/LeadForm.astro';

interface Props { lang: Lang; showContact?: boolean; }

const { lang, showContact = true } = Astro.props;
const t = (key: keyof (typeof ui)['de']) => ui[lang][key];
const year = new Date().getFullYear();
const primaryLinks = nav.filter((item) => ['home', 'courses', 'certification', 'ditele'].includes(item.key));
const aboutLinks = nav.find((item) => item.key === 'about-group')?.children ?? [];
const labels = pick(lang, {
  de: {
    title: 'Kontakt', location: 'Standort:', phone: 'Telefon:', email: 'E-Mail:',
    hours: 'Öffnungszeiten:', follow: 'Folgen Sie uns auf\nsozialen Medien',
    privacySettings: 'Cookie-Einstellungen',
    aboutNav: 'Über die Academy', legalNav: 'Rechtliches',
    workplaceAlt: 'Arbeitsplatz der WAMOCON Academy',
    ratingLabel: 'Google-Bewertung: 5,0 von 5 Sternen',
    rating: '5,0',
    ctaTitle: 'Lieber direkt schreiben?',
    ctaText: 'Senden Sie uns Ihre Nachricht – wir melden uns zeitnah bei Ihnen.',
    ctaButton: 'Kontakt aufnehmen',
    close: 'Schließen',
    aiNotice: 'Einzelne grafische Elemente dieser Website (abstrakte Illustrationen und 3D-Renderings) wurden mit Hilfe künstlicher Intelligenz erstellt. Alle Fotografien von Personen, Räumen und Veranstaltungen sind echte Aufnahmen und nicht KI-generiert. Die redaktionellen Texte dieser Website werden von einem Menschen geprüft und verantwortet. Der Chat-Assistent ist ein KI-System: Seine Antworten werden automatisch auf Basis der Inhalte dieser Website erzeugt, sind nicht vorab redaktionell geprüft und können Fehler enthalten.',
  },
  en: {
    title: 'Contact us', location: 'Location:', phone: 'Phone:', email: 'E-Mail:',
    hours: 'Opening hours:', follow: 'Follow us on\nsocial media',
    privacySettings: 'Cookie settings',
    aboutNav: 'About the Academy', legalNav: 'Legal',
    workplaceAlt: 'WAMOCON Academy workplace',
    ratingLabel: 'Google rating: 5.0 out of 5 stars',
    rating: '5.0',
    ctaTitle: 'Prefer to write directly?',
    ctaText: 'Send us your message – we will get back to you promptly.',
    ctaButton: 'Get in touch',
    close: 'Close',
    aiNotice: 'Some graphical elements on this website (abstract illustrations and 3D renderings) were created with the help of artificial intelligence. All photographs of people, places and events are genuine and not AI-generated. The editorial texts on this website are reviewed and approved by a human. The chat assistant is an AI system: its answers are generated automatically from the content of this website, are not reviewed in advance and may contain errors.',
  },
});
const privacySettings = labels.privacySettings;
const socialLinks = [
  { label: 'YouTube', href: company.social.youtube, icon: '/images/icon-youtube.svg' },
  { label: 'LinkedIn', href: company.social.linkedin, icon: '/images/icon-linkedin.svg' },
  { label: 'Instagram', href: company.social.instagram, icon: '/images/icon-instagram.svg' },
  { label: 'Facebook', href: company.social.facebook, icon: '/images/icon-facebook.svg' },
];
const aiNotice = labels.aiNotice;
---

{showContact && (
<section class="footer-contact container" aria-labelledby="footer-contact-title">
    <div class="footer-contact__copy" data-reveal>
      <h2 id="footer-contact-title">{labels.title}</h2>
      <p class="footer-contact__company">{company.name}</p>
      <address>
        <strong>{labels.location}</strong>
        <span>{company.street}<br />{company.city}</span>
        <strong>{labels.phone}</strong>
        <a href={company.phoneHref}>{company.phone}</a>
        <strong>{labels.email}</strong>
        <a href={company.emailHref}>{company.email}</a>
        <strong>{labels.hours}</strong>
        <span>{company.hours[lang].map((line) => <>{line}<br /></>)}</span>
      </address>
      <div class="footer-contact__socials">
        <span>{labels.follow.split('\n').map((line) => <>{line}<br /></>)}</span>
        <ul>
          {socialLinks.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
                <img src={social.icon} alt="" width="31" height="31" loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <figure class="footer-contact__image" data-reveal>
      <img src={assets.workspace} alt={labels.workplaceAlt} width="1680" height="1120" loading="lazy" />
      <figcaption aria-label={labels.ratingLabel}>
        <span class="google-rating__top" aria-hidden="true">
          <svg class="google-rating__mark" viewBox="0 0 48 48" role="img">
            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.3-.4-3.5Z" />
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4c-7.7 0-14.3 4.3-17.7 10.7Z" />
            <path fill="#4CAF50" d="M24 44c5.1 0 9.8-2 13.3-5.2l-6.1-5.2A11.9 11.9 0 0 1 12.9 28.5l-6.5 5C9.7 39.7 16.3 44 24 44Z" />
            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3a12 12 0 0 1-4.1 5.6l6.1 5.2C36.9 39.2 44 34 44 24c0-1.2-.1-2.3-.4-3.5Z" />
          </svg>
          <strong>{labels.rating}</strong>
        </span>
        <span class="google-rating__stars" aria-hidden="true">★★★★★</span>
      </figcaption>
    </figure>
</section>
)}

{showContact && (
  <div class="footer-cta">
    <div class="footer-cta__inner">
      <div class="footer-cta__copy">
        <strong>{labels.ctaTitle}</strong>
        <span>{labels.ctaText}</span>
      </div>
      <button class="footer-cta__btn" type="button" data-contact-open>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5h16v14H4z" stroke-linejoin="round"/><path d="M4 6l8 6 8-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {labels.ctaButton}
      </button>
    </div>
  </div>
)}

{showContact && (
  <div class="footer-modal" id="wma-contact-modal" hidden>
    <div class="footer-modal__overlay" data-contact-close></div>
    <div class="footer-modal__dialog" role="dialog" aria-modal="true" aria-label={labels.ctaButton}>
      <button class="footer-modal__close" type="button" data-contact-close aria-label={labels.close}>&times;</button>
      <LeadForm lang={lang} type="contact" compact title={labels.ctaButton} anchorId={null} />
    </div>
  </div>
)}

<OfficeMap lang={lang} compact />

<footer class="footer">
  <div class="footer__bottom container">
    <div class="footer__brand">
      <img src={assets.logo} alt="WAMOCON Academy" width="220" height="174" loading="lazy" />
      <p>© {year} {company.name}.<br />{t('footer.rights')}</p>
    </div>
    <nav aria-label={t('footer.navigation')}>
      {primaryLinks.map((item) => <a href={item[lang].href}>{item[lang].label}</a>)}
    </nav>
    <nav aria-label={labels.aboutNav}>
      {aboutLinks.map((item) => <a href={item[lang].href}>{item[lang].label}</a>)}
    </nav>
    <nav aria-label={labels.legalNav}>
      <a href={legalNav.privacy[lang].href}>{legalNav.privacy[lang].label}</a>
      <a href={legalNav.imprint[lang].href}>{legalNav.imprint[lang].label}</a>
      <a href={legalNav.accessibility[lang].href}>{legalNav.accessibility[lang].label}</a>
      <button class="footer__privacy" type="button" data-open-consent-settings>{privacySettings}</button>
    </nav>
  </div>
  <p class="footer__ai-notice container">{aiNotice}</p>
</footer>

<style>
  .footer { background: #101010; }
  /* Direct-contact CTA bar (mirrors wamocon.com), shown under the contact block. */
  .footer-cta { background: #101010; padding: 0 clamp(16px, 4vw, 40px) clamp(24px, 3vw, 44px); }
  .footer-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    max-width: 1600px;
    margin-inline: auto;
    padding: clamp(1.5rem, 3vw, 2.2rem) clamp(1.6rem, 3vw, 2.4rem);
    background: linear-gradient(120deg, rgba(255, 11, 0, 0.14), transparent 70%), #171717;
    border: 1px solid rgba(255, 11, 0, 0.32);
    border-radius: var(--radius-md);
  }
  .footer-cta__copy { display: grid; gap: 0.35rem; }
  .footer-cta__copy strong { font-size: var(--fs-h4); color: #fff; }
  .footer-cta__copy span { color: rgba(255, 255, 255, 0.72); max-width: 62ch; line-height: 1.5; }
  .footer-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: 0 0 auto;
    min-height: 54px;
    padding: 0 clamp(1.5rem, 3vw, 2.2rem);
    background: #ff0b00;
    color: #fff;
    font-weight: 600;
    font-size: var(--fs-body);
    border-radius: 999px;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .footer-cta__btn:hover { background: #e90a00; transform: translateY(-2px); }
  @media (max-width: 620px) {
    .footer-cta__inner { flex-direction: column; align-items: flex-start; }
    .footer-cta__btn { width: 100%; justify-content: center; }
  }

  /* Contact form modal opened by the CTA button. */
  .footer-modal { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: clamp(1rem, 4vw, 2rem); }
  .footer-modal[hidden] { display: none; }
  .footer-modal__overlay { position: absolute; inset: 0; background: rgba(6, 6, 6, 0.72); backdrop-filter: blur(8px) saturate(120%); -webkit-backdrop-filter: blur(8px) saturate(120%); }
  .footer-modal__dialog { position: relative; z-index: 1; width: min(560px, 100%); max-height: 92vh; overflow-y: auto; scrollbar-width: none; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.9); animation: footer-modal-in var(--dur-med) var(--ease-out); }
  @keyframes footer-modal-in { from { opacity: 0; transform: translateY(12px) scale(.98); } }
  @media (prefers-reduced-motion: reduce) { .footer-modal__dialog { animation: none; } }
  .footer-modal__dialog::-webkit-scrollbar { width: 0; height: 0; display: none; }
  .footer-modal__close { position: absolute; z-index: 2; top: 14px; right: 14px; width: 40px; height: 40px; display: grid; place-items: center; border: 1px solid var(--border-subtle); border-radius: var(--radius-pill); background: rgba(255, 255, 255, 0.06); color: rgba(255, 255, 255, 0.75); font-size: var(--fs-lead); line-height: 1; transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .footer-modal__close:hover, .footer-modal__close:focus-visible { border-color: var(--color-accent); background: rgba(244, 14, 14, .14); color: #fff; transform: rotate(90deg); }
  /* Reuse LeadForm inside the modal: just the form, no image / curves / section padding. */
  .footer-modal__dialog :global(.lead-section) { padding: 0; background: transparent; }
  .footer-modal__dialog :global(.lead-section__grid) { width: 100%; grid-template-columns: 1fr; min-height: 0; padding: clamp(1.75rem, 4vw, 2.5rem); background: transparent; }
  .footer-modal__dialog :global(.lead-section__image),
  .footer-modal__dialog :global(.lead-section__curve) { display: none; }
  .footer-modal__dialog :global(.lead-form) { padding: 0; }
  .footer-modal__dialog :global(.lead-form h2) { font-size: var(--fs-h3); }
  .footer-contact { display: grid; grid-template-columns: minmax(360px, 500px) minmax(0, 820px); justify-content: center; gap: clamp(48px, 5vw, 88px); align-items: center; max-width: 1600px; padding: clamp(42px, 4vw, 64px) clamp(36px, 4vw, 80px); background: #101010; }
  .footer-contact__copy { width: 100%; max-width: 500px; justify-self: end; padding-top: 5px; }
  .footer-contact__copy h2 { margin-bottom: clamp(14px, 1vw, 20px); font-size: var(--fs-h1); }
  .footer-contact__company { margin-bottom: clamp(22px, 1.5vw, 30px); color: #fff; font-size: var(--fs-h4); line-height: 1.35; }
  .footer-contact address { display: grid; font-style: normal; }
  .footer-contact address strong { margin-top: clamp(14px, .9vw, 18px); color: #ff0b00; font-size: var(--fs-h5); font-weight: 500; line-height: 1.3; }
  .footer-contact address strong:first-child { margin-top: 0; }
  .footer-contact address span,
  .footer-contact address a { color: #fff; font-size: var(--fs-h4); line-height: 1.36; }
  .footer-contact__socials { display: flex; align-items: center; gap: clamp(16px, 1.2vw, 24px); margin-top: clamp(24px, 1.6vw, 32px); }
  .footer-contact__socials > span { flex: 0 0 auto; color: #ff0b00; font-size: var(--fs-lead); line-height: 1.25; }
  .footer-contact__socials ul {
    display: flex !important;
    flex-flow: row nowrap !important;
    align-items: center;
    gap: clamp(12px, .85vw, 20px);
    width: auto;
  }
  .footer-contact__socials li { display: block; flex: 0 0 auto; }
  .footer-contact__socials a,
  .footer-contact__socials img { display: block; width: clamp(38px, 2.3vw, 44px); height: clamp(38px, 2.3vw, 44px); }
  .footer-contact__socials a { border-radius: 50%; transition: transform var(--dur-fast) var(--ease-out); }
  .footer-contact__socials a:hover { transform: translateY(-2px); }
  .footer-contact__image { position: relative; width: 100%; max-width: 820px; justify-self: start; overflow: hidden; }
  .footer-contact__image > img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .footer-contact__image figcaption { position: absolute; left: 3.6%; bottom: 4.5%; display: flex; width: 122px; height: 84px; flex-direction: column; justify-content: center; padding: 9px 10px; border: 2px solid #fff; background: #050505; color: #fff; line-height: 1; box-shadow: 0 8px 24px rgb(0 0 0 / .32); }
  .google-rating__top { display: flex; align-items: center; gap: 6px; }
  .google-rating__mark { width: 32px; height: 32px; flex: 0 0 auto; }
  .google-rating__top strong { font-size: var(--fs-h3); font-weight: 700; letter-spacing: -.04em; }
  .google-rating__stars { display: block; margin-top: 7px; color: #ff0b00; font-size: var(--fs-body); letter-spacing: 1px; white-space: nowrap; }
  .footer__bottom { display: grid; grid-template-columns: 1.25fr 1fr 1fr .8fr; gap: clamp(2rem, 5vw, 5.5rem); max-width: var(--container-max); padding-block: clamp(3rem, 6vw, 5.5rem); color: #fff; font-size: var(--fs-body); }
  .footer__brand img { width: min(180px, 50vw); height: auto; margin-bottom: 20px; }
  .footer__bottom nav { display: grid; align-content: start; gap: 12px; }
  .footer__bottom a { color: #fff; }
  .footer__bottom a:hover { color: var(--color-accent); }
  .footer__privacy { width: fit-content; color: #fff; font-size: inherit; text-align: left; text-decoration: underline; text-underline-offset: .22em; }
  .footer__privacy:hover { color: var(--color-accent); }
  /* Centred at the foot of the page: it is a site-wide disclosure, not part of
     any one footer column, so it reads as a closing line rather than a stray
     left-aligned paragraph. */
  .footer__ai-notice { max-width: 160ch; margin-inline: auto; padding-top: clamp(1.25rem, 3vw, 2rem); padding-bottom: clamp(2rem, 5vw, 4rem); border-top: 1px solid var(--border-subtle); color: rgba(255,255,255,.62); font-size: var(--fs-sm); line-height: 1.7; text-align: center; text-wrap: pretty; }
  @media (max-width: 900px) {
    .footer-contact { grid-template-columns: 1fr; gap: 38px; max-width: 760px; padding: 60px clamp(20px, 5vw, 40px) 36px; }
    .footer-contact__copy,
    .footer-contact__image { max-width: none; justify-self: stretch; }
    .footer-contact__copy { padding-top: 0; }
    .footer-contact__copy h2 { font-size: var(--fs-h1); }
    .footer-contact__company { font-size: var(--fs-h4); }
    .footer-contact address strong { font-size: var(--fs-h4); }
    .footer-contact address span,
    .footer-contact address a { font-size: var(--fs-h4); }
    .footer-contact__socials > span { font-size: var(--fs-h4); }
    .footer__bottom { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .footer-contact { padding-top: 48px; }
    .footer-contact__socials { align-items: flex-start; flex-direction: column; }
    .footer-contact__socials ul { gap: 14px; }
    .footer__bottom { grid-template-columns: 1fr; }
  }
</style>

<script>
  const contactModal = document.getElementById('wma-contact-modal');
  if (contactModal) {
    const openContact = () => { contactModal.hidden = false; document.body.style.overflow = 'hidden'; };
    const closeContact = () => { contactModal.hidden = true; document.body.style.overflow = ''; };
    // The old inline "Beratung erhalten" form (#beratung) was replaced by this modal,
    // so any remaining links to that anchor open the contact modal instead.
    document.querySelectorAll<HTMLElement>('[data-contact-open], a[href="#beratung"]').forEach((btn) =>
      btn.addEventListener('click', (event) => { event.preventDefault(); openContact(); }),
    );
    contactModal.querySelectorAll<HTMLElement>('[data-contact-close]').forEach((btn) => btn.addEventListener('click', closeContact));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !contactModal.hidden) closeContact(); });
  }
</script>
