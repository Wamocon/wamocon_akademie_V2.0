---
import { assets } from '../../data/academy';
import { nav, ui, type Lang, type NavLink } from '../../i18n/config';
import { getAlternateLangUrl } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const altHref = getAlternateLangUrl(currentPath, lang);
const homeHref = lang === 'de' ? '/' : '/en/';
const t = (key: keyof (typeof ui)['de']) => ui[lang][key];

// Language options for the switcher dropdown. The active language links to the
// current page (a no-op); the other links to its translated equivalent.
const languages = [
  { code: 'de', label: 'Deutsch', short: 'DE', href: lang === 'de' ? currentPath : altHref },
  { code: 'en', label: 'English', short: 'EN', href: lang === 'en' ? currentPath : altHref },
] as const;

const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const isActive = (item: NavLink) => {
  const path = normalize(currentPath);
  if (normalize(item[lang].href) === path) return true;
  return item.children?.some((child) => normalize(child[lang].href) === path) ?? false;
};
---

<header class="site-header" id="site-header">
  <div class="site-header__inner container">
    <a class="site-header__logo" href={homeHref} aria-label="WAMOCON Academy">
      <img src={assets.logo} alt="WAMOCON Academy" width="220" height="174" />
    </a>

    <nav class="site-header__nav" id="primary-nav" aria-label={t('footer.navigation')}>
      <ul class="site-header__list">
        {
          nav.map((item) => (
            <li class:list={['site-header__item', { 'has-children': item.children?.length }]}>
              <a
                class:list={['site-header__link', { 'is-active': isActive(item) }]}
                href={item[lang].href}
                aria-current={isActive(item) ? 'page' : undefined}
              >
                {item[lang].label}
              </a>
              {item.children && (
                <ul class="site-header__submenu">
                  {item.children.map((child) => (
                    <li>
                      <a
                        class:list={['site-header__submenu-link', { 'is-active': isActive(child) }]}
                        href={child[lang].href}
                      >
                        {child[lang].label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        class="site-header__toggle"
        type="button"
        id="nav-toggle"
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label={t('nav.menu')}
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
      >
        <span></span><span></span><span></span>
      </button>
      <div class="site-header__langswitch" data-lang-switch>
        <button
          type="button"
          class="site-header__lang"
          id="lang-switch-button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={t('lang.label')}
        >
          <svg class="site-header__globe" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18" />
          </svg>
          <span>{lang.toUpperCase()}</span>
          <svg class="site-header__caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <ul class="site-header__langmenu" role="menu" aria-labelledby="lang-switch-button">
          {languages.map((l) => (
            <li role="none">
              <a
                role="menuitem"
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                class:list={['site-header__langoption', { 'is-active': l.code === lang }]}
                aria-current={l.code === lang ? 'true' : undefined}
              >
                <span>{l.label}</span>
                {l.code === lang && (
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    width: 100%;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 0;
    background: transparent;
    transition: background var(--dur-med), border-color var(--dur-med), box-shadow var(--dur-med);
  }

  .site-header.is-scrolled,
  .site-header.is-menu-open {
    background: rgba(13, 13, 13, 0.96);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 180px;
    gap: 1.25rem;
    max-width: var(--container-max);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    width: 180px;
    flex: 0 0 auto;
  }

  .site-header__logo img {
    width: 100%;
    height: auto;
  }

  .site-header__nav {
    position: absolute;
    left: 50%;
    display: flex;
    justify-content: center;
    transform: translateX(-50%);
  }

  .site-header__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 1.5vw, 26px);
  }

  .site-header__item {
    position: relative;
  }

  .site-header__link,
  .site-header__submenu-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.2rem 0;
    color: var(--color-muted);
    font-size: clamp(0.95rem, 0.85vw, 1.05rem);
    font-weight: var(--fw-regular);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-header__link:hover,
  .site-header__link.is-active,
  .site-header__submenu-link:hover,
  .site-header__submenu-link.is-active {
    color: var(--color-accent);
  }

  .has-children > .site-header__link::after {
    content: '';
    width: 6px;
    height: 6px;
    margin-left: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }

  .site-header__submenu {
    position: absolute;
    top: calc(100% + 0.3rem);
    left: 0;
    min-width: 235px;
    padding: 0.45rem;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background: rgba(15, 17, 21, 0.98);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.28);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      visibility var(--dur-fast);
  }

  .site-header__item:hover .site-header__submenu,
  .site-header__item:focus-within .site-header__submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .site-header__submenu-link {
    width: 100%;
    border-radius: var(--radius-sm);
  }

  .site-header__submenu-link:hover,
  .site-header__submenu-link.is-active {
    background: rgba(255, 255, 255, 0.07);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.75rem;
  }

  /* ---- language switcher (shows the active language + dropdown) ---- */
  .site-header__langswitch { position: relative; }
  .site-header__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 80px;
    height: 40px;
    padding: 0 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background: #0d0d0d;
    color: #fff;
    font-size: clamp(1rem, 0.8vw, 1.12rem);
    font-weight: var(--fw-semibold);
    cursor: pointer;
  }
  .site-header__lang:hover,
  .site-header__lang[aria-expanded='true'] { color: var(--color-accent); border-color: var(--color-accent); }
  .site-header__globe { flex: 0 0 auto; }
  .site-header__caret { transition: transform var(--dur-fast) var(--ease-out); }
  .site-header__lang[aria-expanded='true'] .site-header__caret { transform: rotate(180deg); }
  .site-header__langmenu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    min-width: 168px;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: rgba(15, 17, 21, 0.98);
    border: 1px solid var(--color-line);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), visibility var(--dur-fast);
  }
  .site-header__langswitch.is-open .site-header__langmenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .site-header__langoption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.7rem;
    color: var(--color-muted);
    font-size: 0.98rem;
  }
  .site-header__langoption:hover { background: rgba(255, 255, 255, 0.07); color: #fff; }
  .site-header__langoption.is-active { color: var(--color-accent); font-weight: var(--fw-semibold); }

  .site-header__toggle {
    display: none;
    width: 24px;
    height: 24px;
    place-items: center;
  }

  .site-header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    margin: 4px auto;
    background: var(--color-accent-surface);
    transition: transform var(--dur-fast), opacity var(--dur-fast);
  }

  @media (max-width: 1279px) {
    .site-header__inner {
      min-height: 84px;
    }

    .site-header__logo {
      width: 120px;
    }

    .site-header__toggle {
      display: block;
    }

    .site-header__nav {
      position: fixed;
      inset: 84px 0 auto 0;
      max-height: calc(100vh - 84px);
      overflow-y: auto;
      padding: 1rem var(--container-pad) 1.5rem;
      border-bottom: 1px solid var(--color-line);
      background: rgba(13, 13, 13, 0.99);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-12px);
      transition:
        opacity var(--dur-med) var(--ease-out),
        transform var(--dur-med) var(--ease-out),
        visibility var(--dur-med);
    }

    .site-header__nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .site-header__list {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .site-header__item {
      border-bottom: 1px solid var(--color-line);
    }

    .site-header__link {
      width: 100%;
      min-height: 54px;
      padding: 0;
      font-size: 1.05rem;
    }

    .site-header__submenu {
      position: static;
      min-width: 0;
      padding: 0 0 0.8rem 0.9rem;
      border: 0;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .site-header__submenu-link {
      min-height: 38px;
      padding-inline: 0;
    }

    body.nav-open {
      overflow: hidden;
    }

    .site-header__lang { min-width: 54px; height: 36px; font-size: 0.85rem; }
    .site-header__langmenu { min-width: 150px; }
  }

  @media (max-width: 460px) {
    .site-header__inner {
      gap: 0.65rem;
    }

    .site-header__logo { width: 104px; }

    .site-header__actions {
      gap: 0.45rem;
    }

    .site-header__toggle {
      min-width: 24px;
      width: 24px;
      height: 24px;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  const setMenuState = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? toggle.dataset.labelClose || '' : toggle.dataset.labelOpen || '');
    document.body.classList.toggle('nav-open', open);
    header?.classList.toggle('is-menu-open', open);
  };
  const closeMenu = () => setMenuState(false);
  window.addEventListener('scroll', syncHeader, { passive: true });
  syncHeader();
  toggle?.addEventListener('click', () => {
    setMenuState(!nav?.classList.contains('is-open'));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.classList.contains('is-open')) {
      closeMenu();
      toggle?.focus();
    }
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1280) closeMenu();
  }, { passive: true });

  // Language dropdown: toggle on click, close on outside click / Escape.
  const langSwitch = document.querySelector('[data-lang-switch]');
  const langButton = document.getElementById('lang-switch-button');
  const closeLang = () => {
    langSwitch?.classList.remove('is-open');
    langButton?.setAttribute('aria-expanded', 'false');
  };
  langButton?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = langSwitch?.classList.toggle('is-open');
    langButton.setAttribute('aria-expanded', String(Boolean(open)));
  });
  document.addEventListener('click', (event) => {
    if (langSwitch && !langSwitch.contains(event.target as Node)) closeLang();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLang();
  });
</script>
