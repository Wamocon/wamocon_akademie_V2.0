---
import { assets } from '../../data/academy';
import { nav, ui, type Lang, type NavLink } from '../../i18n/config';
import { getAlternateLangUrl } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const altHref = getAlternateLangUrl(currentPath, lang);
const homeHref = lang === 'de' ? '/' : '/en/';
const t = (key: keyof (typeof ui)['de']) => ui[lang][key];

const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const isActive = (item: NavLink) => {
  const path = normalize(currentPath);
  if (normalize(item[lang].href) === path) return true;
  return item.children?.some((child) => normalize(child[lang].href) === path) ?? false;
};
---

<header class="site-header" id="site-header">
  <div class="site-header__inner container">
    <a class="site-header__logo" href={homeHref} aria-label="WAMOCON Academy">
      <img src={assets.logo} alt="WAMOCON Academy" width="220" height="174" />
    </a>

    <nav class="site-header__nav" id="primary-nav" aria-label={t('footer.navigation')}>
      <ul class="site-header__list">
        {
          nav.map((item) => (
            <li class:list={['site-header__item', { 'has-children': item.children?.length }]}>
              <a
                class:list={['site-header__link', { 'is-active': isActive(item) }]}
                href={item[lang].href}
                aria-current={isActive(item) ? 'page' : undefined}
              >
                {item[lang].label}
              </a>
              {item.children && (
                <ul class="site-header__submenu">
                  {item.children.map((child) => (
                    <li>
                      <a
                        class:list={['site-header__submenu-link', { 'is-active': isActive(child) }]}
                        href={child[lang].href}
                      >
                        {child[lang].label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        class="site-header__toggle"
        type="button"
        id="nav-toggle"
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label={t('nav.menu')}
      >
        <span></span><span></span><span></span>
      </button>
      <a class="site-header__lang" href={altHref} aria-label={t('lang.label')}>
        {t('lang.switch')}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 1px solid var(--color-line);
    background: rgba(15, 17, 21, 0.88);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 86px;
    gap: 1.25rem;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    width: 164px;
    flex: 0 0 auto;
  }

  .site-header__logo img {
    width: 100%;
    height: auto;
  }

  .site-header__nav {
    display: flex;
    justify-content: center;
    flex: 1;
  }

  .site-header__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.35rem, 1vw, 1.1rem);
  }

  .site-header__item {
    position: relative;
  }

  .site-header__link,
  .site-header__submenu-link {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0.2rem 0.55rem;
    color: var(--color-muted);
    font-size: 0.92rem;
    font-weight: var(--fw-regular);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-header__link:hover,
  .site-header__link.is-active,
  .site-header__submenu-link:hover,
  .site-header__submenu-link.is-active {
    color: #fff;
  }

  .has-children > .site-header__link::after {
    content: '';
    width: 6px;
    height: 6px;
    margin-left: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }

  .site-header__submenu {
    position: absolute;
    top: calc(100% + 0.3rem);
    left: 0;
    min-width: 235px;
    padding: 0.45rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: rgba(15, 17, 21, 0.98);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.28);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      visibility var(--dur-fast);
  }

  .site-header__item:hover .site-header__submenu,
  .site-header__item:focus-within .site-header__submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .site-header__submenu-link {
    width: 100%;
    border-radius: var(--radius-sm);
  }

  .site-header__submenu-link:hover,
  .site-header__submenu-link.is-active {
    background: rgba(255, 255, 255, 0.07);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.75rem;
  }

  .site-header__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 42px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: #fff;
    font-weight: var(--fw-semibold);
  }

  .site-header__toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    place-items: center;
  }

  .site-header__toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin: 3px auto;
    background: #fff;
    transition: transform var(--dur-fast), opacity var(--dur-fast);
  }

  @media (max-width: 1080px) {
    .site-header__inner {
      min-height: 76px;
    }

    .site-header__logo {
      width: 138px;
      max-width: 42vw;
    }

    .site-header__toggle {
      display: grid;
    }

    .site-header__nav {
      position: fixed;
      inset: 76px 0 auto 0;
      max-height: calc(100vh - 76px);
      overflow-y: auto;
      padding: 1rem var(--container-pad) 1.5rem;
      border-bottom: 1px solid var(--color-line);
      background: rgba(15, 17, 21, 0.98);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-12px);
      transition:
        opacity var(--dur-med) var(--ease-out),
        transform var(--dur-med) var(--ease-out),
        visibility var(--dur-med);
    }

    .site-header__nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .site-header__list {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .site-header__item {
      border-bottom: 1px solid var(--color-line);
    }

    .site-header__link {
      width: 100%;
      min-height: 54px;
      padding: 0;
      font-size: 1.05rem;
    }

    .site-header__submenu {
      position: static;
      min-width: 0;
      padding: 0 0 0.8rem 0.9rem;
      border: 0;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .site-header__submenu-link {
      min-height: 38px;
      padding-inline: 0;
    }

    body.nav-open {
      overflow: hidden;
    }
  }

  @media (max-width: 460px) {
    .site-header__inner {
      gap: 0.65rem;
    }

    .site-header__logo {
      width: 132px;
    }

    .site-header__actions {
      gap: 0.45rem;
    }

    .site-header__lang,
    .site-header__toggle {
      min-width: 40px;
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-open', open);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('nav-open');
    });
  });
</script>
