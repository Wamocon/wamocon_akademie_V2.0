---
import type { Lang } from '../../i18n/config';
import { pick } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = pick(lang, {
  de: {
    heading: '360° Büro Tour',
    text: 'Erkunden Sie unser Büro virtuell. Öffnen Sie die interaktive 360°-Ansicht in Google Maps.',
    cta: 'In Google Maps öffnen',
    notice: 'Die 360°-Ansicht wird erst nach Ihrer Zustimmung von Google Maps geladen.',
    load: '360°-Ansicht laden',
  },
  en: {
    heading: '360° Office tour',
    text: 'Explore our office virtually. Open the interactive 360° view in Google Maps.',
    cta: 'Open in Google Maps',
    notice: 'The 360° view loads from Google Maps only after your consent.',
    load: 'Load 360° view',
  },
});
const heading = copy.heading;
const text = copy.text;
const cta = copy.cta;
const embedUrl = 'https://www.google.com/maps/embed?pb=!4v1782479371000!6m8!1m7!1sCAoSHENJQUJJaENVc3VTMzZndWlqazhoTlB1TmlkN1k.!2m2!1d50.1350963!2d8.5722177!3f0!4f-20!5f0.7820865974627469';
const mapsUrl = 'https://www.google.com/maps/@?api=1&map_action=pano&pano=CAoSHENJQUJJaENVc3VTMzZndWlqazhoTlB1TmlkN1k.&heading=0&pitch=-20&fov=80';
---

<section class="office-tour section" aria-labelledby="office-tour-title">
  <div class="container">
    <div class="office-tour__header" data-reveal>
      <div><span class="office-tour__badge">360°</span><h2 id="office-tour-title">{heading}</h2></div>
      <p>{text}</p>
    </div>
    <div class="office-tour__frame" data-external-media data-reveal>
      <iframe data-consent-src={embedUrl} title={heading} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen hidden></iframe>
      <div class="office-tour__notice" data-external-media-notice>
        <p>{copy.notice}</p>
        <button type="button" data-external-media-load>{copy.load}</button>
      </div>
    </div>
    <a class="office-tour__link" href={mapsUrl} target="_blank" rel="noopener noreferrer">{cta}</a>
  </div>
</section>

<style>
  .office-tour { position: relative; overflow: hidden; background: var(--color-bg); }
  .office-tour::after {
    content: '';
    position: absolute;
    top: 4%;
    /* Offset from the container edge, not the viewport. The section is
       full-bleed, so a plain `right: -80px` pinned this to the screen edge —
       ~846px away from the tour content on a 3800px monitor, and clipped. */
    right: calc(var(--page-gutter) - 80px);
    width: clamp(190px, 14vw, 300px);
    aspect-ratio: 1;
    background: url('/images/academy/tild3730-6132-4863-b462-623032303533__group_11.png') center / contain no-repeat;
    opacity: 0.5;
    pointer-events: none;
    transform: rotate(232deg);
    animation: tour-object-drift 9s ease-in-out infinite;
  }
  .office-tour > .container { position: relative; z-index: 1; }
  .office-tour__header {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(360px, 1.35fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .office-tour__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 40px;
    margin-bottom: 1rem;
    border: 1px solid var(--color-accent);
    font-weight: var(--fw-bold);
  }
  .office-tour h2 { font-size: var(--fs-h1); }
  .office-tour p { max-width: 760px; color: var(--color-muted); font-size: var(--fs-lead); }
  .office-tour__frame {
    position: relative;
    width: 100%;
    height: clamp(440px, 45vw, 720px);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
  }
  .office-tour__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .office-tour__frame iframe[hidden] { display: none; }
  .office-tour__notice {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 16px;
    padding: 28px;
    color: #fff;
    text-align: center;
  }
  .office-tour__notice p {
    max-width: 440px;
    font-size: var(--fs-body);
    line-height: 1.45;
  }
  .office-tour__notice button {
    justify-self: center;
    min-height: 48px;
    padding-inline: 24px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-surface);
    color: #fff;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
  }
  .office-tour__link {
    display: inline-flex;
    min-height: 48px;
    margin-top: 1.25rem;
    padding-inline: 1.5rem;
    align-items: center;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
  }
  .office-tour__link:hover { background: var(--color-accent-surface); }
  @keyframes tour-object-drift { 0%, 100% { transform: translate3d(0, 0, 0) rotate(232deg); } 50% { transform: translate3d(-14px, 16px, 0) rotate(240deg); } }
  @media (max-width: 780px) {
    .office-tour__header { grid-template-columns: 1fr; align-items: start; }
    .office-tour__frame { height: auto; min-height: 300px; aspect-ratio: 4 / 3; }
    .office-tour::after { display: none; }
  }
  @media (min-width: 2200px) {
    .office-tour__header { grid-template-columns: minmax(520px, 0.55fr) minmax(0, 1.45fr); }
    .office-tour__frame { height: min(34vw, 900px); }
    .office-tour::after { width: min(13vw, 420px); }
  }
  @media (max-width: 480px) {
    .office-tour__frame { min-height: 390px; aspect-ratio: 3 / 4; }
    .office-tour__link { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .office-tour::after { animation: none; }
  }
</style>
