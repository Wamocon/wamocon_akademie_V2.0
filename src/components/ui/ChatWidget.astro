---
/**
 * WAMOCON Academy website assistant.
 *
 * EU AI Act Art. 50(1): a person must be informed that they are interacting
 * with an AI system, so the disclosure sits in the panel itself, not behind a
 * link. The browser only ever talks to /api/chat — the model endpoint and API
 * key stay server-side, and answers are grounded in this website's content.
 *
 * NOTE ON STYLES: the stylesheet below is `is:global`, namespaced under `.cw`.
 * Astro's scoped styles work by stamping a `data-astro-cid-*` attribute onto
 * markup it renders, but chat messages are created at runtime with
 * createElement and never receive that attribute — scoped rules would simply
 * not apply to them, leaving every message after the first unstyled.
 */
import { legalNav, type Lang } from '../../i18n/config';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const t = {
  de: {
    open: 'Chat mit dem Academy-Assistenten öffnen',
    close: 'Chat schließen',
    title: 'Academy Assistent',
    status: 'Antwortet in Sekunden',
    badge: 'KI',
    disclosure: 'Sie chatten mit einem KI-Assistenten, nicht mit einem Menschen. Er antwortet nur auf Basis dieser Website und kann Fehler machen.',
    intro: 'Hallo! Ich beantworte Fragen zur WAMOCON Academy auf Basis dieser Website. Was möchten Sie wissen?',
    placeholder: 'Ihre Frage zur Academy …',
    send: 'Senden',
    sources: 'Quellen',
    privacy: 'Datenschutz',
    error: 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut.',
    warming: 'Der Assistent startet gerade, einen Moment bitte …',
    resize: 'Fenstergröße ändern (ziehen oder Pfeiltasten)',
    suggestions: ['Welche Kurse bietet ihr an?', 'Was ist die ISTQB®-Zertifizierung?', 'Wie kann ich euch erreichen?'],
  },
  en: {
    open: 'Open chat with the Academy assistant',
    close: 'Close chat',
    title: 'Academy Assistant',
    status: 'Replies in seconds',
    badge: 'AI',
    disclosure: 'You are chatting with an AI assistant, not a human. It answers only from this website and can make mistakes.',
    intro: 'Hi! I answer questions about WAMOCON Academy based on this website. What would you like to know?',
    placeholder: 'Your question about the Academy …',
    send: 'Send',
    sources: 'Sources',
    privacy: 'Privacy policy',
    error: 'Something went wrong. Please try again.',
    warming: 'The assistant is starting up, one moment please …',
    resize: 'Resize window (drag or arrow keys)',
    suggestions: ['Which courses do you offer?', 'What is the ISTQB® certification?', 'How can I contact you?'],
  },
}[lang];

const privacyHref = legalNav.privacy[lang].href;
---

<div class="cw" data-chat-widget data-lang={lang}>
  <button type="button" class="cw__launcher" data-chat-open aria-expanded="false" aria-controls="cw-panel" aria-label={t.open}>
    <span class="cw__ring" aria-hidden="true"></span>
    {/* Speech bubble carrying the Academy A. Same bubble silhouette as the
        WAMOCON group site, which carries the W — one family, and the letter
        tells the visitor which site they are on. Drawn as strokes rather than
        a text glyph so it stays crisp at any size and needs no webfont. */}
    <svg class="cw__ic cw__ic--chat" viewBox="0 0 28 28" width="27" height="27" aria-hidden="true" fill="none">
      <path d="M14 3.6c5.8 0 10.4 3.6 10.4 8.2 0 4.5-4.6 8.2-10.4 8.2-1.1 0-2.2-.1-3.2-.4l-4.9 2.8 1-3.8c-2.3-1.5-3.4-3.8-3.4-6.8 0-4.6 4.7-8.2 10.5-8.2Z"
            stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M10.4 14.6 14 8.9l3.6 5.7M11.6 12.7h4.8"
            stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <svg class="cw__ic cw__ic--close" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  <section class="cw__panel" id="cw-panel" data-chat-panel hidden aria-label={t.title}>
    <button type="button" class="cw__grip" data-chat-resize aria-label={t.resize} title={t.resize}>
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path d="M3.5 9.5l6-6M3.5 13l9.5-9.5" />
      </svg>
    </button>

    <header class="cw__head">
      <span class="cw__avatar" aria-hidden="true">
        <svg viewBox="0 0 28 28" width="17" height="17" fill="none">
          <path d="M9.5 16.4 14 8.2l4.5 8.2M11.3 13.7h5.4"
                stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="cw__id">
        <strong>{t.title}<em class="cw__badge">{t.badge}</em></strong>
        <small><i class="cw__live" aria-hidden="true"></i>{t.status}</small>
      </span>
      <button type="button" class="cw__x" data-chat-close aria-label={t.close}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    {/* EU AI Act Art. 50 transparency — always visible, never behind a link. */}
    <p class="cw__note">{t.disclosure} <a href={privacyHref}>{t.privacy}</a></p>

    <div class="cw__log" data-chat-log role="log" aria-live="polite" aria-atomic="false"></div>

    <div class="cw__tips" data-chat-suggestions>
      {t.suggestions.map((s) => (
        <button type="button" class="cw__tip" data-chat-suggestion={s}>{s}</button>
      ))}
    </div>

    <form class="cw__form" data-chat-form>
      <label class="cw__sr" for="cw-input">{t.placeholder}</label>
      <input id="cw-input" class="cw__input" type="text" name="message" maxlength="500" autocomplete="off" placeholder={t.placeholder} data-chat-input />
      <button type="submit" class="cw__send" data-chat-send aria-label={t.send}>
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" /></svg>
      </button>
    </form>
  </section>
</div>

<script define:vars={{ strings: t }}>
  // @ts-nocheck
  (() => {
    const root = document.querySelector('[data-chat-widget]');
    if (!root) return;
    const lang = root.dataset.lang || 'de';
    const panel = root.querySelector('[data-chat-panel]');
    const launcher = root.querySelector('[data-chat-open]');
    const log = root.querySelector('[data-chat-log]');
    const form = root.querySelector('[data-chat-form]');
    const input = root.querySelector('[data-chat-input]');
    const sendBtn = root.querySelector('[data-chat-send]');
    const tips = root.querySelector('[data-chat-suggestions]');
    const grip = root.querySelector('[data-chat-resize]');

    // The Academy A, matching the launcher and the header avatar.
    const AVATAR = 'M9.5 16.4 14 8.2l4.5 8.2M11.3 13.7h5.4';

    let busy = false;
    let warmed = false;
    const scrollDown = () => { log.scrollTop = log.scrollHeight; };

    function avatarEl() {
      const av = document.createElement('span');
      av.className = 'cw-row__av';
      av.setAttribute('aria-hidden', 'true');
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', '0 0 28 28');
      svg.setAttribute('width', '14');
      svg.setAttribute('height', '14');
      svg.setAttribute('fill', 'none');
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', AVATAR);
      path.setAttribute('stroke', 'currentColor');
      path.setAttribute('stroke-width', '2.3');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      svg.appendChild(path);
      av.appendChild(svg);
      return av;
    }

    /** A chat bubble. Model output is set as text, never as HTML. */
    function addMessage(role, text) {
      const row = document.createElement('div');
      row.className = `cw-row cw-row--${role}`;
      if (role === 'bot') row.appendChild(avatarEl());
      const bubble = document.createElement('div');
      bubble.className = 'cw-bubble';
      bubble.textContent = text;
      row.appendChild(bubble);
      log.appendChild(row);
      scrollDown();
      return { row, bubble };
    }

    /** Animated dots while the model is generating. */
    function addTyping() {
      const row = document.createElement('div');
      row.className = 'cw-row cw-row--bot';
      const bubble = document.createElement('div');
      bubble.className = 'cw-bubble cw-bubble--typing';
      for (let i = 0; i < 3; i++) bubble.appendChild(document.createElement('i'));
      row.append(avatarEl(), bubble);
      log.appendChild(row);
      scrollDown();
      return { row, bubble };
    }

    function addSources(sources) {
      if (!sources || !sources.length) return;
      const wrap = document.createElement('div');
      wrap.className = 'cw-src';
      const label = document.createElement('span');
      label.className = 'cw-src__label';
      label.textContent = strings.sources;
      wrap.appendChild(label);
      for (const s of sources) {
        const a = document.createElement('a');
        a.className = 'cw-src__link';
        a.href = s.url;
        a.textContent = s.title || s.url;
        wrap.appendChild(a);
      }
      log.appendChild(wrap);
      scrollDown();
    }

    addMessage('bot', strings.intro);

    // The model takes ~30s to load into VRAM when cold; warming as soon as the
    // panel opens means it is usually ready by the time a question is typed.
    function warm() {
      if (warmed) return;
      warmed = true;
      fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ warm: true }),
      }).catch(() => {});
    }

    function setOpen(open) {
      panel.hidden = !open;
      launcher.setAttribute('aria-expanded', String(open));
      root.classList.toggle('is-open', open);
      if (open) { warm(); scrollDown(); if (window.innerWidth > 480) input.focus(); }
    }

    launcher.addEventListener('click', () => setOpen(panel.hidden));
    root.querySelector('[data-chat-close]').addEventListener('click', () => { setOpen(false); launcher.focus(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { setOpen(false); launcher.focus(); }
    });

    tips.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-chat-suggestion]');
      if (!btn) return;
      input.value = btn.dataset.chatSuggestion;
      form.requestSubmit();
    });

    /* ---- resizable panel -------------------------------------------------
       The panel is pinned bottom-right, so the grip lives top-left and dragging
       up/left enlarges it. Size is clamped to the viewport and remembered. */
    const SIZE_KEY = 'wamocon-academy-chat-size';
    const MIN_W = 320, MIN_H = 380;
    const maxW = () => Math.min(760, window.innerWidth - 32);
    const maxH = () => Math.min(880, window.innerHeight - 120);

    function applySize(w, h) {
      const cw = Math.max(MIN_W, Math.min(w, maxW()));
      const ch = Math.max(MIN_H, Math.min(h, maxH()));
      panel.style.width = `${cw}px`;
      panel.style.height = `${ch}px`;
      return { w: cw, h: ch };
    }
    const remember = (w, h) => {
      try { localStorage.setItem(SIZE_KEY, JSON.stringify({ w: Math.round(w), h: Math.round(h) })); } catch {}
    };

    try {
      const saved = JSON.parse(localStorage.getItem(SIZE_KEY) || 'null');
      if (saved && saved.w && saved.h && window.innerWidth > 480) applySize(saved.w, saved.h);
    } catch {}

    let drag = null;
    grip.addEventListener('pointerdown', (e) => {
      if (window.innerWidth <= 480) return;      // full-width sheet on phones
      e.preventDefault();
      const r = panel.getBoundingClientRect();
      drag = { x: e.clientX, y: e.clientY, w: r.width, h: r.height };
      try { grip.setPointerCapture(e.pointerId); } catch {}
      panel.classList.add('is-resizing');
    });
    grip.addEventListener('pointermove', (e) => {
      if (!drag) return;
      // Inverted deltas: dragging up/left must grow the panel.
      applySize(drag.w + (drag.x - e.clientX), drag.h + (drag.y - e.clientY));
    });
    const endDrag = (e) => {
      if (!drag) return;
      drag = null;
      panel.classList.remove('is-resizing');
      try { grip.releasePointerCapture(e.pointerId); } catch {}
      const r = panel.getBoundingClientRect();
      remember(r.width, r.height);
    };
    grip.addEventListener('pointerup', endDrag);
    grip.addEventListener('pointercancel', endDrag);

    // Keyboard alternative, so resizing is not mouse-only.
    grip.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 80 : 32;
      const moves = { ArrowLeft: [step, 0], ArrowRight: [-step, 0], ArrowUp: [0, step], ArrowDown: [0, -step] };
      if (!moves[e.key]) return;
      e.preventDefault();
      const r = panel.getBoundingClientRect();
      const [dw, dh] = moves[e.key];
      const size = applySize(r.width + dw, r.height + dh);
      remember(size.w, size.h);
    });

    window.addEventListener('resize', () => {
      if (!panel.style.width) return;
      applySize(parseFloat(panel.style.width), parseFloat(panel.style.height));
    });

    /* ---- asking ---------------------------------------------------------- */
    async function ask(question) {
      if (busy || !question) return;
      busy = true;
      input.value = '';
      tips.hidden = true;
      sendBtn.disabled = true;
      addMessage('user', question);
      const typing = addTyping();

      const call = () => fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lang, message: question }),
      });

      try {
        let res = await call();
        // 504 = the model is still loading into VRAM. Say so, then retry once.
        if (res.status === 504) {
          typing.bubble.classList.remove('cw-bubble--typing');
          typing.bubble.textContent = strings.warming;
          await new Promise((r) => setTimeout(r, 12000));
          res = await call();
        }
        const data = await res.json().catch(() => ({}));
        typing.row.remove();
        addMessage('bot', data.answer || strings.error);
        if (data.ok && !data.refused) addSources(data.sources);
      } catch {
        typing.row.remove();
        addMessage('bot', strings.error);
      } finally {
        busy = false;
        sendBtn.disabled = false;
        input.focus();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value.trim().slice(0, 500));
    });
  })();
</script>

<style is:global>
  /* Namespaced under .cw and global on purpose — see the note in the frontmatter.
     Colours, radii, shadows and motion all come from the site's design tokens so
     the assistant reads as part of the Academy, not a bolted-on third party. */
  .cw {
    --cw-bg: var(--color-bg-elevated);
    --cw-bg-2: #232326;
    --cw-line: var(--border-subtle);
    --cw-grad: linear-gradient(140deg, #ff4d2d, var(--color-accent) 58%, #b80000);
    position: fixed;
    right: clamp(0.85rem, 2vw, 1.6rem);
    bottom: clamp(0.85rem, 2vw, 1.6rem);
    z-index: calc(var(--z-modal) + 2);
    font-family: var(--font-sans);
  }

  /* ---------- launcher ---------- */
  .cw__launcher {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px; height: 60px;
    padding: 0;
    border: none;
    border-radius: 50%;
    color: #fff;
    background: var(--cw-grad);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    cursor: pointer;
    transition: transform var(--dur-med) var(--ease-out), box-shadow var(--dur-med) var(--ease-out);
  }
  .cw__launcher:hover { transform: translateY(-3px) scale(1.04); box-shadow: 0 18px 42px rgba(0, 0, 0, 0.58); }
  .cw__launcher:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .cw__ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    animation: cw-ping 2.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    pointer-events: none;
  }
  @keyframes cw-ping {
    0% { transform: scale(0.9); opacity: 0.55; }
    70%, 100% { transform: scale(1.28); opacity: 0; }
  }
  .cw__ic--close { display: none; }
  .cw.is-open .cw__ic--chat { display: none; }
  .cw.is-open .cw__ic--close { display: block; }
  .cw.is-open .cw__ring { display: none; }

  /* ---------- panel ---------- */
  .cw__panel {
    position: absolute;
    right: 0;
    bottom: calc(60px + 0.9rem);
    display: flex;
    flex-direction: column;
    width: min(400px, calc(100vw - 1.7rem));
    height: min(600px, calc(100dvh - 7rem));
    background: var(--cw-bg);
    border: 1px solid var(--cw-line);
    border-radius: var(--radius-lg);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.62);
    overflow: hidden;
    animation: cw-in 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cw__panel[hidden] { display: none; }
  .cw__panel.is-resizing { animation: none; user-select: none; }
  @keyframes cw-in {
    from { opacity: 0; transform: translateY(14px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }

  /* Drag grip: panel is pinned bottom-right, so it sits top-left. */
  .cw__grip {
    position: absolute;
    top: 0; left: 0;
    z-index: 3;
    display: grid; place-items: center;
    width: 28px; height: 28px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg) 0 14px 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.32);
    cursor: nwse-resize;
    touch-action: none;
  }
  .cw__grip:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .cw__grip:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }

  .cw__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 0.9rem 0.85rem 2.1rem;
    background: linear-gradient(180deg, rgba(244, 14, 14, 0.15), transparent);
    border-bottom: 1px solid var(--cw-line);
  }
  .cw__avatar {
    flex: 0 0 auto;
    display: grid; place-items: center;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--cw-grad);
    color: #fff;
  }
  .cw__id { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .cw__id strong { display: flex; align-items: center; gap: 0.4rem; color: #fff; font-size: var(--fs-sm); font-weight: var(--fw-semibold); line-height: 1.2; }
  .cw__id small { display: flex; align-items: center; gap: 0.35rem; color: var(--color-text-subtle); font-size: var(--fs-2xs); }
  .cw__badge {
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-surface);
    color: #fff;
    font-size: 0.6rem;
    font-style: normal;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-wide);
  }
  .cw__live {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #35c759;
    animation: cw-pulse 2.4s ease-out infinite;
  }
  @keyframes cw-pulse {
    0% { box-shadow: 0 0 0 0 rgba(53, 199, 89, 0.55); }
    70%, 100% { box-shadow: 0 0 0 7px rgba(53, 199, 89, 0); }
  }
  .cw__x {
    margin-left: auto;
    display: grid; place-items: center;
    width: 32px; height: 32px;
    border: 0; border-radius: 50%;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
  }
  .cw__x:hover { background: rgba(255, 255, 255, 0.09); color: #fff; }

  .cw__note {
    margin: 0;
    padding: 0.6rem 0.95rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--cw-line);
    color: var(--color-text-subtle);
    font-size: var(--fs-2xs);
    line-height: 1.5;
  }
  .cw__note a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.2em; }

  /* ---------- transcript ---------- */
  .cw__log {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    scrollbar-width: thin;
  }
  .cw-row { display: flex; align-items: flex-end; gap: 0.5rem; max-width: 100%; }
  .cw-row--user { justify-content: flex-end; }
  .cw-row__av {
    flex: 0 0 auto;
    display: grid; place-items: center;
    width: 26px; height: 26px;
    margin-bottom: 2px;
    border-radius: 50%;
    background: var(--cw-grad);
    color: #fff;
  }
  .cw-bubble {
    max-width: 78%;
    padding: 0.68rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  .cw-row--bot .cw-bubble {
    background: var(--cw-bg-2);
    color: rgba(255, 255, 255, 0.92);
    border-bottom-left-radius: 5px;
  }
  .cw-row--user .cw-bubble {
    background: var(--cw-grad);
    color: #fff;
    border-bottom-right-radius: 5px;
  }

  .cw-bubble--typing { display: flex; align-items: center; gap: 4px; padding: 0.85rem 0.9rem; }
  .cw-bubble--typing i {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    animation: cw-bounce 1.3s ease-in-out infinite;
  }
  .cw-bubble--typing i:nth-child(2) { animation-delay: 0.16s; }
  .cw-bubble--typing i:nth-child(3) { animation-delay: 0.32s; }
  @keyframes cw-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.45; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  /* Source pills sit under the answer, indented to align with the bubble. */
  .cw-src {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: -0.3rem 0 0 34px;
  }
  .cw-src__label {
    margin-right: 0.1rem;
    color: var(--color-text-subtle);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .cw-src__link {
