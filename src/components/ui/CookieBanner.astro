---
import { legalNav, type Lang } from '../../i18n/config';
import { pick } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = pick(lang, {
  de: {
    label: 'Datenschutzeinstellungen',
    title: 'Ihre Privatsphäre, Ihre Entscheidung',
    text: 'Wir verwenden technisch notwendige Speicherungen. Externe Medien von Google und YouTube laden wir nur mit Ihrer Einwilligung. Sie können Ihre Auswahl jederzeit im Footer ändern.',
    accept: 'Alle akzeptieren', reject: 'Alle ablehnen', settings: 'Einstellungen',
    settingsTitle: 'Datenschutzeinstellungen', necessary: 'Technisch notwendig',
    necessaryText: 'Erforderlich für Einwilligungsverwaltung, Sicherheit und die von Ihnen angeforderte Formularfunktion.',
    media: 'Externe Medien', mediaText: 'Erlaubt Inhalte von YouTube und Google Maps. Dabei können Daten in die USA übertragen werden.',
    always: 'Immer aktiv', save: 'Auswahl speichern', cancel: 'Abbrechen', privacy: 'Datenschutzerklärung',
  },
  en: {
    label: 'Privacy settings',
    title: 'Your privacy, your choice',
    text: 'We use technically necessary storage. External media from Google and YouTube is loaded only with your consent. You can change your choice at any time in the footer.',
    accept: 'Accept all', reject: 'Reject all', settings: 'Settings',
    settingsTitle: 'Privacy settings', necessary: 'Strictly necessary',
    necessaryText: 'Required for consent management, security and the form function you request.',
    media: 'External media', mediaText: 'Allows content from YouTube and Google Maps. Data may be transferred to the United States.',
    always: 'Always active', save: 'Save selection', cancel: 'Cancel', privacy: 'Privacy policy',
  },
});
const privacyHref = legalNav.privacy[lang].href;
---

<aside class="consent" data-consent-root data-lang={lang} role="dialog" aria-modal="true" aria-labelledby="consent-title" hidden>
  <div class="consent__panel" data-consent-summary tabindex="-1">
    <p class="consent__eyebrow">{copy.label}</p>
    <h2 id="consent-title">{copy.title}</h2>
    <p class="consent__text">{copy.text}</p>
    <div class="consent__actions">
      <button class="consent__btn consent__btn--primary" type="button" data-consent-accept>{copy.accept}</button>
      <button class="consent__btn consent__btn--secondary" type="button" data-consent-reject>{copy.reject}</button>
    </div>
    <div class="consent__meta">
      <button class="consent__quiet" type="button" data-consent-settings>{copy.settings}</button>
      <a class="consent__privacy" href={privacyHref}>{copy.privacy}</a>
    </div>
  </div>

  <div class="consent__panel" data-consent-details tabindex="-1" hidden>
    <h2 id="consent-settings-title">{copy.settingsTitle}</h2>
    <div class="consent__option">
      <div class="consent__optionText"><strong>{copy.necessary}</strong><p>{copy.necessaryText}</p></div>
      <span class="consent__always">{copy.always}</span>
    </div>
    <label class="consent__option consent__option--toggle" for="consent-external-media">
      <div class="consent__optionText"><strong>{copy.media}</strong><p>{copy.mediaText}</p></div>
      <span class="consent__switch">
        <input id="consent-external-media" type="checkbox" data-consent-media />
        <span class="consent__track" aria-hidden="true"></span>
      </span>
    </label>
    <div class="consent__actions">
      <button class="consent__btn consent__btn--primary" type="button" data-consent-save>{copy.save}</button>
      <button class="consent__btn consent__btn--secondary" type="button" data-consent-cancel>{copy.cancel}</button>
    </div>
    <div class="consent__meta">
      <a class="consent__privacy" href={privacyHref}>{copy.privacy}</a>
    </div>
  </div>
</aside>

<style>
  .consent {
    position: fixed; inset: 0; z-index: calc(var(--z-modal) + 10);
    display: grid; place-items: end center;
    padding: clamp(1rem, 3vw, 2rem);
    background: rgb(0 0 0 / .6);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    animation: consent-scrim var(--dur-med) var(--ease-out) both;
  }
  .consent[hidden], .consent [hidden] { display: none; }

  .consent__panel {
    box-sizing: border-box;
    position: relative;
    width: min(560px, 100%); max-width: 100%;
    max-height: calc(100dvh - 4rem); overflow-y: auto;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    color: #fff;
    box-shadow: 0 24px 64px -12px rgb(0 0 0 / .7);
    animation: consent-rise var(--dur-med) var(--ease-out) both;
  }
  /* The panel is a programmatic focus target for screen readers, not a tab stop,
     so it must not inherit the global red :focus-visible ring from global.css. */
  .consent__panel:focus { outline: none; }
  /* CI hairline: ties the panel to the brand without three competing red boxes. */
  .consent__panel::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 2px;
    background: var(--color-accent);
  }

  .consent__eyebrow { margin-bottom: .45rem; color: var(--color-accent); font-size: .7rem; font-weight: var(--fw-semibold); letter-spacing: .1em; text-transform: uppercase; }
  .consent h2 { margin-bottom: .55rem; font-size: clamp(1.15rem, 2.2vw, 1.4rem); font-weight: var(--fw-semibold); line-height: 1.25; }
  .consent__text { max-width: 46ch; color: var(--color-muted); font-size: .875rem; line-height: 1.6; }

  .consent__actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: .625rem; margin-top: 1.4rem; }
  .consent__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 46px; padding: .6rem 1rem;
    border: 1.5px solid transparent; border-radius: var(--radius-pill);
    font-size: .875rem; font-weight: var(--fw-semibold); line-height: 1.2;
    text-align: center; text-wrap: balance;
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  /* --color-accent-surface, not --color-accent: white on #f40e0e is 4.27:1 and fails AA. */
  .consent__btn--primary { background: var(--color-accent-surface); color: #fff; }
  .consent__btn--primary:hover { background: var(--color-accent-surface-hover); }
  .consent__btn--secondary { border-color: var(--border-strong); background: transparent; color: #fff; }
  .consent__btn--secondary:hover { border-color: #fff; background: rgb(255 255 255 / .07); }

  .consent__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; margin-top: 1rem; }
  .consent__quiet {
    display: inline-flex; align-items: center; min-height: 24px;
    color: var(--color-muted); font-size: .8rem; font-weight: var(--fw-medium);
    text-decoration: underline; text-underline-offset: .22em; text-decoration-color: rgb(255 255 255 / .3);
    transition: color var(--dur-fast) var(--ease-out), text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .consent__quiet:hover { color: #fff; text-decoration-color: currentColor; }
  /* min-height keeps this standalone link at the WCAG 2.2 24px target size. */
  .consent__privacy {
    display: inline-flex; align-items: center; min-height: 24px;
    color: var(--color-text-subtle); font-size: .8rem;
    text-decoration: underline; text-underline-offset: .22em; text-decoration-color: rgb(255 255 255 / .3);
    transition: color var(--dur-fast) var(--ease-out), text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .consent__privacy:hover { color: #fff; text-decoration-color: currentColor; }

  /* One shared ring so keyboard focus never reads as a different button style. */
  .consent :is(button, a, input):focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  .consent__option { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: center; padding: 1rem 0; border-top: 1px solid var(--border-subtle); }
  .consent__option--toggle { cursor: pointer; }
  .consent__optionText strong { display: block; margin-bottom: .25rem; font-size: .875rem; font-weight: var(--fw-semibold); }
  .consent__optionText p { color: var(--color-muted); font-size: .8rem; line-height: 1.55; }
  .consent__always { color: var(--color-text-subtle); font-size: .75rem; font-weight: var(--fw-medium); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }

  .consent__switch { position: relative; flex: none; display: inline-grid; place-items: center; width: 46px; height: 28px; }
  .consent__switch input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .consent__track { pointer-events: none; display: block; width: 46px; height: 28px; border: 1px solid var(--border-strong); border-radius: 999px; background: rgb(255 255 255 / .08); transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
  .consent__track::after { content: ''; position: absolute; top: 50%; left: 4px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transform: translateY(-50%); transition: transform var(--dur-fast) var(--ease-out); }
  .consent__switch input:checked + .consent__track { border-color: var(--color-accent-surface); background: var(--color-accent-surface); }
  .consent__switch input:checked + .consent__track::after { transform: translate(18px, -50%); }
  .consent__switch input:focus-visible + .consent__track { outline: 2px solid #fff; outline-offset: 2px; }

  @keyframes consent-scrim { from { opacity: 0; } to { opacity: 1; } }
  @keyframes consent-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  @media (max-width: 620px) {
    .consent { place-items: end stretch; padding: 0; }
    .consent__panel { max-height: 92dvh; border-width: 1px 0 0; }
    .consent__actions { grid-template-columns: 1fr; }
  }
</style>

<script>
  const STORAGE_KEY = 'wamocon-academy-consent-v1';
  const root = document.querySelector<HTMLElement>('[data-consent-root]');
  const summary = root?.querySelector<HTMLElement>('[data-consent-summary]');
  const details = root?.querySelector<HTMLElement>('[data-consent-details]');
  const mediaToggle = root?.querySelector<HTMLInputElement>('[data-consent-media]');
  let current = { externalMedia: false };

  const read = () => {
    try {
      const value = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (value?.version === 1 && typeof value.externalMedia === 'boolean') return value;
    } catch {}
    return null;
  };

  const applyExternalMedia = (allowed: boolean) => {
    document.querySelectorAll<HTMLElement>('iframe[data-consent-src], img[data-consent-src]').forEach((element) => {
      const src = element.dataset.consentSrc;
      if (!src) return;
      const requiresPlay = element.dataset.consentMode === 'manual';

      // Consent permits an external provider to load. It must never be treated as
      // a request to play every video on the current page.
      if (allowed && requiresPlay) return;

      if (allowed) {
        if (!element.getAttribute('src')) element.setAttribute('src', src);
        element.hidden = false;
      } else if (element.tagName === 'IFRAME') {
        element.removeAttribute('src');
        element.hidden = true;
      } else {
        const placeholder = element.dataset.consentPlaceholder;
        if (placeholder) element.setAttribute('src', placeholder);
        else element.removeAttribute('src');
      }
      const container = element.closest<HTMLElement>('[data-external-media]');
      const notice = container?.querySelector<HTMLElement>('[data-external-media-notice], .ditele-test__video-consent');
      if (notice) notice.hidden = allowed && !requiresPlay;
      container?.classList.toggle('is-loaded', allowed && !requiresPlay);
    });
    document.documentElement.dataset.externalMediaConsent = allowed ? 'granted' : 'denied';
    window.dispatchEvent(new CustomEvent('wamocon:consent', { detail: { externalMedia: allowed } }));
  };

  const stopManualPlayback = () => {
    document.querySelectorAll<HTMLIFrameElement>('iframe[data-consent-mode="manual"]').forEach((iframe) => {
      iframe.removeAttribute('src');
      iframe.hidden = true;
      const container = iframe.closest<HTMLElement>('[data-external-media]');
      const notice = container?.querySelector<HTMLElement>('[data-external-media-notice], .ditele-test__video-consent');
      const stopButton = container?.querySelector<HTMLButtonElement>('[data-external-media-stop], [data-stop-external-media]');
      if (notice) notice.hidden = false;
      if (stopButton) stopButton.hidden = true;
      container?.classList.remove('is-loaded');
    });
  };

  // Focus is returned here on close so reopening from the footer does not dump
  // keyboard users back at the top of the document.
  let lastFocused: HTMLElement | null = null;

  const close = () => {
    if (root) root.hidden = true;
    lastFocused?.focus();
    lastFocused = null;
  };
  const open = () => {
    if (root?.hidden !== false) lastFocused = document.activeElement as HTMLElement | null;
  };
  // The dialog name must point at the heading that is actually visible, so it
  // follows the panel swap instead of referencing a hidden element.
  const showSummary = () => { if (!root || !summary || !details) return; open(); root.hidden = false; summary.hidden = false; details.hidden = true; root.setAttribute('aria-labelledby', 'consent-title'); summary.focus(); };
  const showSettings = () => { if (!root || !summary || !details) return; open(); root.hidden = false; summary.hidden = true; details.hidden = false; root.setAttribute('aria-labelledby', 'consent-settings-title'); if (mediaToggle) mediaToggle.checked = current.externalMedia; details.focus(); };
  const save = (externalMedia: boolean) => {
    current = { externalMedia };
    hasChoice = true;
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ version: 1, externalMedia, savedAt: new Date().toISOString() })); } catch {}
    applyExternalMedia(externalMedia);
    close();
  };

  const stored = read();
  let hasChoice = Boolean(stored);
  if (stored) { current = { externalMedia: stored.externalMedia }; applyExternalMedia(current.externalMedia); }
  else showSummary();

  // Escape from the detail view steps back rather than dismissing, so a user
  // mid-way through granular settings does not lose the panel. Escaping the
  // summary without a choice persists nothing: external media stays denied by
  // default and the banner returns on the next visit.
  const dismiss = () => {
    if (details && !details.hidden && !hasChoice) showSummary();
    else close();
  };

  const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled])';
  root?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { event.preventDefault(); dismiss(); return; }
    if (event.key !== 'Tab') return;
    const panel = details && !details.hidden ? details : summary;
    const items = [...(panel?.querySelectorAll<HTMLElement>(FOCUSABLE) ?? [])].filter((el) => el.offsetParent !== null);
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;
    if (event.shiftKey && (active === first || active === panel)) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && active === last) { event.preventDefault(); first.focus(); }
  });

  root?.querySelector('[data-consent-accept]')?.addEventListener('click', () => save(true));
  root?.querySelector('[data-consent-reject]')?.addEventListener('click', () => save(false));
  root?.querySelector('[data-consent-settings]')?.addEventListener('click', showSettings);
  root?.querySelector('[data-consent-save]')?.addEventListener('click', () => save(Boolean(mediaToggle?.checked)));
  root?.querySelector('[data-consent-cancel]')?.addEventListener('click', () => hasChoice ? close() : showSummary());
  document.querySelectorAll('[data-open-consent-settings]').forEach((button) => button.addEventListener('click', showSettings));
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('[data-external-media-load], [data-load-external-media]')) save(true);
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopManualPlayback();
  });
  window.addEventListener('pagehide', stopManualPlayback);

  Object.assign(window, {
    wamoconConsent: {
      hasExternalMedia: () => current.externalMedia,
      open: showSettings,
      grantExternalMedia: () => save(true),
    },
  });
</script>
