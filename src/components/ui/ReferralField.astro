---
/**
 * Aufgabe 11: freiwillige Selbstauskunft zur Herkunft der Anfrage.
 *
 * Es gibt auf der Website keine Messung. Diese Angabe ist damit die einzige
 * Herkunftsquelle, die unabhaengig von Einwilligung und Werbeblockern
 * funktioniert — und sie laesst sich nicht rueckwirkend erheben.
 *
 * Kein Pflichtfeld. Die Auswahlliste hat eine Freitextoption: bei „Sonstiges"
 * erscheint ein zusaetzliches Textfeld.
 */
import { pick } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
  /** Muss je Formular eindeutig sein: eine Seite kann mehrere Formulare tragen. */
  id: string;
}

const { lang, id } = Astro.props;

const copy = pick(lang, {
  de: {
    label: 'Wie bist du auf uns aufmerksam geworden?',
    optional: 'optional',
    placeholder: 'Bitte auswählen',
    otherLabel: 'Woher genau?',
    otherPlaceholder: 'Kurz beschreiben',
    options: [
      ['google', 'Google-Suche'],
      ['recommendation', 'Empfehlung'],
      ['instagram', 'Instagram'],
      ['directory', 'Bildungsportal oder Verzeichnis'],
      ['agency', 'Arbeitsagentur oder Jobcenter'],
      ['known', 'Wir kennen uns bereits'],
      ['other', 'Sonstiges'],
    ],
  },
  en: {
    label: 'How did you hear about us?',
    optional: 'optional',
    placeholder: 'Please select',
    otherLabel: 'Where exactly?',
    otherPlaceholder: 'Brief description',
    options: [
      ['google', 'Google search'],
      ['recommendation', 'Recommendation'],
      ['instagram', 'Instagram'],
      ['directory', 'Education portal or directory'],
      ['agency', 'Employment agency or job centre'],
      ['known', 'We already know each other'],
      ['other', 'Other'],
    ],
  },
});
const otherId = `${id}-other`;
---

<label class="referral-field">
  <span>{copy.label} <em>({copy.optional})</em></span>
  <select name="referral" id={id} data-referral-select data-referral-other={otherId}>
    <option value="">{copy.placeholder}</option>
    {copy.options.map(([value, label]) => <option value={value}>{label}</option>)}
  </select>
</label>
<label class="referral-field referral-field--other" id={`${otherId}-wrap`} hidden>
  <span>{copy.otherLabel}</span>
  <input type="text" name="referralOther" id={otherId} placeholder={copy.otherPlaceholder} maxlength="120" />
</label>

<script>
  // Das Freitextfeld erscheint nur bei "Sonstiges" und wird sonst geleert, damit
  // keine verwaiste Eingabe mitgeschickt wird.
  document.querySelectorAll('select[data-referral-select]').forEach((select) => {
    if (!(select instanceof HTMLSelectElement)) return;
    const otherId = select.dataset.referralOther;
    if (!otherId) return;
    const wrap = document.getElementById(`${otherId}-wrap`);
    const input = document.getElementById(otherId);
    const sync = () => {
      const isOther = select.value === 'other';
      if (wrap) wrap.hidden = !isOther;
      if (!isOther && input instanceof HTMLInputElement) input.value = '';
    };
    select.addEventListener('change', sync);
    sync();
  });
</script>

<style>
  /* Uebernimmt bewusst die Masse der bestehenden Formularfelder, damit sich am
     Layout nichts aendert. */
  .referral-field {
    display: grid;
    gap: 6px;
    color: #fff;
    font-size: var(--fs-sm);
    line-height: 1.3;
  }

  .referral-field em {
    color: rgba(255, 255, 255, 0.62);
    font-style: normal;
  }

  .referral-field select,
  .referral-field input {
    width: 100%;
    min-height: 52px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-text-dark);
    font-family: inherit;
    font-size: var(--fs-body);
  }

  .referral-field select {
    appearance: none;
    padding-right: 44px;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-text-dark) 50%),
      linear-gradient(135deg, var(--color-text-dark) 50%, transparent 50%);
    background-position: calc(100% - 22px) 23px, calc(100% - 16px) 23px;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }
</style>
