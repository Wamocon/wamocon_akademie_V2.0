---
import coursePopupCopy from '../../../audit/course-popup-copy.json';
import { legalNav, nav, thanksHref, type Lang } from '../../i18n/config';
import { pick } from '../../i18n/utils';
import VideoEmbed from '../ui/VideoEmbed.astro';
import { coursePopupActions, coursePopupBlocks, coursePopupCategory } from '../../data/coursePopup';
import RichText from '../ui/RichText.astro';
import { programAssets, programContent, programCourses } from '../../data/programs';

interface Props {
  lang: Lang;
}

type PopupRecord = {
  hook: string;
  title: string;
  description: string;
  links: Array<{ text: string; href: string }>;
};

const { lang } = Astro.props;
const content = programContent[lang];
const courses = programCourses[lang];
const heroAccentLines = pick(lang, {
  de: ['Bildungsprogramme', 'für Softwaretester:'],
  en: ['Educational programs', 'for software testers:'],
});
const coursePopups = (coursePopupCopy as PopupRecord[]).filter((popup) => popup.hook.endsWith(`-${lang}`));
const popupId = (hook: string) => `course-${hook.replace('#popup:', '').replace(/[^a-z0-9-]+/gi, '-').toLowerCase()}`;
const redirect = thanksHref[lang];
const questionHook = pick(lang, {
  de: '#popup:eine-Frage-stellen',
  en: '#popup:eine-Frage-stellen-en',
});
const registrationHook = pick(lang, {
  de: '#popup:myform',
  en: '#popup:myform-en',
});
const scheduleHook = pick(lang, {
  de: '#popup:Termine',
  en: '#popup:Termine-en',
});
const normalizePopupHref = (href: string) => {
  if (href === '#order') return registrationHook;
  // Course records author the ask-a-question link with the German hook; every
  // non-German locale rewrites it to its own dialog.
  if (lang !== 'de' && href === '#popup:eine-Frage-stellen') return questionHook;
  return href;
};
const certificationHref = nav.find((item) => item.key === 'certification')![lang].href;
const privacyHref = legalNav.privacy[lang].href;
const c = pick(lang, {
  de: {
    privacyLabel: 'Datenschutzerklärung',
    formNoticeStart:
      'Ihre Anfrage an die WAMOCON Academy GmbH ist unverbindlich und stellt keinen Kauf dar. Informationen zur Verarbeitung Ihrer Daten finden Sie in der ',
    scheduleMonths: [['In Planung', ['Neue Kurstermine werden bekannt gegeben.']]],
    consultationAlt: 'Persönliche Beratung bei der WAMOCON Academy',
    scrollHint: 'Nach unten scrollen ↓',
    askQuestion: 'Eine Frage stellen',
    yourQuestion: 'Ihre Frage',
    videoNotice: 'Dieses Video wird erst nach Ihrer Zustimmung von YouTube geladen.',
    videoLoad: 'YouTube-Video laden',
  },
  en: {
    privacyLabel: 'privacy policy',
    formNoticeStart:
      'Your inquiry to WAMOCON Academy GmbH is non-binding and does not constitute a purchase. Information about the processing of your data can be found in the ',
    scheduleMonths: [['Planned', ['New course dates will be announced.']]],
    consultationAlt: 'Personal consultation at WAMOCON Academy',
    scrollHint: 'Scroll down ↓',
    askQuestion: 'Ask a question',
    yourQuestion: 'Your question',
    videoNotice: 'This video loads from YouTube only after your consent.',
    videoLoad: 'Load YouTube video',
  },
});
const privacyLabel = c.privacyLabel;
const formNoticeStart = c.formNoticeStart;
const scheduleMonths = c.scheduleMonths as Array<[string, string[]]>;
---

<section class="page-hero program-hero">
  <div class="program-hero__media page-hero__art" aria-hidden="true">
    <img
        class="program-hero__accreditation"
        src={programAssets.accreditation}
        alt="Hessen, ISTQB Accredited Training Provider und International Software Testing Qualifications Board"
        width="1400"
        height="450"
      />
    <img class="program-hero__art program-hero__art--small" src={programAssets.hero} alt="" width="1680" height="1670" loading="eager" aria-hidden="true" />
    <img class="program-hero__art program-hero__art--large" src={programAssets.hero} alt="" width="1680" height="1670" loading="eager" aria-hidden="true" />
  </div>
  <div class="program-shell program-hero__layout page-hero__inner">
    <div class="program-hero__copy page-hero__copy" data-reveal>
      <h1>
        <span class="program-hero__headline-accent">
          {heroAccentLines.map((line) => <span class="program-hero__headline-line">{line}</span>)}
        </span>
        <span class="program-hero__headline-rest">{content.heroRest}</span>
      </h1>
      <p>{content.lead}</p>
    </div>
  </div>
</section>

<section class="program-section program-benefits">
  <div class="program-shell">
    <h2><span>{content.benefitsTitle.split(' ')[0]}</span> {content.benefitsTitle.split(' ').slice(1).join(' ')}</h2>
    <div class="program-benefits__grid">
      {content.benefits.map(([title, text]) => (
        <article data-reveal>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="program-section program-catalog">
  <div class="program-shell">
    <div class="course-group course-group--individual">
      <h2>{content.individualTitle}</h2>
      <div class="course-grid course-grid--individual">
        {courses.individual.map((course) => (
          <a
            class="course-card"
            href={course.hook}
            data-course-popup={popupId(course.hook)}
            aria-haspopup="dialog"
            aria-controls={popupId(course.hook)}
            data-reveal
          >
            <span class="course-card__format">{course.format}</span>
            <strong>{course.title}</strong>
            <span class="course-card__duration">{course.duration}</span>
          </a>
        ))}
      </div>
      <img class="course-group__curve" src={programAssets.accentCurve} alt="" width="2228" height="1724" loading="lazy" />
    </div>

    <div class="course-group course-group--team">
      <h2>{content.teamTitle}</h2>
      <div class="course-grid">
        {courses.team.map((course) => (
          <a
            class="course-card"
            href={course.hook}
            data-course-popup={popupId(course.hook)}
            aria-haspopup="dialog"
            aria-controls={popupId(course.hook)}
            data-reveal
          >
            <span class="course-card__format">{course.format}</span>
            <strong>{course.title}</strong>
            <span class="course-card__duration">{course.duration}</span>
          </a>
        ))}
      </div>
    </div>

    <figure class="program-network" data-reveal>
      <img src={programAssets.network} alt="ISTQB Lern- und Teamkurse im Überblick" width="1440" height="715" loading="lazy" />
      <figcaption>{content.networkText}</figcaption>
    </figure>
  </div>
</section>

<section class="program-section program-dates">
  <div class="program-shell">
    <h2>{content.datesTitle}</h2>
    <div class:list={['program-dates__grid', { 'program-dates__grid--single': content.dates.length === 1 }]}>
      {content.dates.map((date) => (
        <article class="date-column" data-reveal>
          <h3>{date.month}</h3>
          <ul>
            {date.rows.map(([day, status]) => <li><span>{day}</span><strong>{status}</strong></li>)}
          </ul>
        </article>
      ))}
    </div>
    <a class="program-button" href={scheduleHook} data-dialog-hook={popupId(scheduleHook)}>{content.moreDetails}</a>
  </div>
</section>

<section class="program-section program-advice" id="beratung">
  <div class="program-shell">
    <div class="program-advice__panel">
      <div class="program-advice__image-wrap" data-reveal>
        <img src={programAssets.consultation} alt={c.consultationAlt} width="1600" height="900" loading="lazy" />
        <img class="program-advice__curve" src={programAssets.accentCurve} alt="" width="2228" height="1724" loading="lazy" aria-hidden="true" />
      </div>
      <div class="program-advice__content" data-reveal>
        <h2>{content.adviceTitle}</h2>
        <p>{content.adviceText}</p>
        <form class="program-form js-lead-form" data-redirect={redirect}>
          <input type="hidden" name="type" value="courses" />
          <input type="hidden" name="lang" value={lang} />
          <input class="program-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
          <label><span>{content.form.name}</span><input type="text" name="name" placeholder={content.form.name} autocomplete="name" required /></label>
          <label><span>{content.form.phone}</span><input type="tel" name="phone" placeholder={content.form.phone} autocomplete="tel" /></label>
          <label><span>{content.form.email}</span><input type="email" name="email" placeholder={content.form.email} autocomplete="email" required /></label>
          <p class="program-form__notice">{formNoticeStart}<a href={privacyHref}>{privacyLabel}</a>.</p>
          <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
          <button class="program-button" type="submit">{content.form.submit}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="program-section program-future">
  <div class="program-shell program-future__grid">
    <div class="program-future__copy" data-reveal>
      <h2><a href={certificationHref}><span class="program-future__eyebrow">{content.futureTitleAccent}</span>{content.futureTitleRest}</a></h2>
      <p>{content.futureIntro}</p>
      <p>{content.futureText}</p>
    </div>
    <div class="program-future__media" data-reveal>
      <img class="program-future__diploma" src={programAssets.diploma} alt="Abschlusskappe und Zertifikat" width="1280" height="1280" loading="lazy" />
      <img class="program-future__certification" src={programAssets.certification} alt="ISTQB Accredited Training Provider" width="726" height="450" loading="lazy" />
    </div>
  </div>
</section>

<section class="program-section program-steps">
  <div class="program-shell">
    <h2><span>{content.stepsTitle.split(' ').slice(0, 3).join(' ')}</span> {content.stepsTitle.split(' ').slice(3).join(' ')}</h2>
    <ol class="program-steps__grid">
      {content.steps.map((step, index) => (
        <li data-reveal>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{step}</p>
        </li>
      ))}
    </ol>
    <div class="program-prep">
      {content.prep.map(([title, text]) => (
        <article data-reveal>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="program-section program-webinar">
  <div class="program-shell program-webinar__grid">
    <div class="program-webinar__copy" data-reveal>
      <h2>{content.webinarTitle}</h2>
      <h3>{content.webinarIntroTitle}</h3>
      <p>{content.webinarIntro}</p>
      <ul>
        {content.webinarItems.map(([title, text]) => (
          <li>
            <strong>{title}</strong>
            <span>{text}</span>
          </li>
        ))}
      </ul>
      <p class="program-webinar__closing">{content.webinarClosing}</p>
    </div>
    <div class="program-webinar__media" data-reveal>
      <img src={programAssets.webinar} alt="Softwaretester bei der Arbeit" width="1680" height="1118" loading="lazy" />
      <div class="program-webinar__actions">
        <a class="program-button" href={certificationHref}>{content.moreDetails}</a>
        <a class="program-button program-button--outline" href="#zeropopup" data-dialog-hook="program-video-popup">{content.video}</a>
      </div>
    </div>
  </div>
</section>

{coursePopups.map((popup) => (
  <dialog class="course-dialog" id={popupId(popup.hook)} aria-labelledby={`${popupId(popup.hook)}-title`}>
    <article class="course-dialog__panel">
      <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}>
        <span aria-hidden="true">×</span>
      </button>
      <p class="course-dialog__eyebrow">{coursePopupCategory(popup.hook, lang)}</p>
      <h2 id={`${popupId(popup.hook)}-title`}>{popup.title}</h2>
      <div class="course-dialog__content">
        {coursePopupBlocks(popup.description, lang, popup.links).map((block) => (
          block.type === 'heading'
            ? <h3><RichText parts={block.parts} /></h3>
            : block.type === 'list'
              ? <ul>{block.items.map((item) => <li><RichText parts={item} /></li>)}</ul>
              : <p><RichText parts={block.parts} /></p>
        ))}
      </div>
      <div class="course-dialog__actions">
        {coursePopupActions(popup.links).map((link, index) => (
          <a
            class:list={['program-button', { 'program-button--outline': index > 0 }]}
            href={normalizePopupHref(link.href)}
            data-dialog-hook={normalizePopupHref(link.href).startsWith('#popup:') ? popupId(normalizePopupHref(link.href)) : undefined}
          >{link.text}</a>
        ))}
      </div>
    </article>
    <span class="course-dialog__scrollhint" aria-hidden="true">{c.scrollHint}</span>
  </dialog>
))}

<dialog class="course-dialog form-dialog" id={popupId(questionHook)} aria-labelledby="question-dialog-title">
  <article class="course-dialog__panel">
    <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}><span aria-hidden="true">×</span></button>
    <h2 id="question-dialog-title">{c.askQuestion}</h2>
    <form class="program-form js-lead-form" data-redirect={redirect}>
      <input type="hidden" name="type" value="question" /><input type="hidden" name="lang" value={lang} />
      <input class="program-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
      <label><span>{content.form.name}</span><input type="text" name="name" placeholder={content.form.name} autocomplete="name" required /></label>
      <label><span>{content.form.email}</span><input type="email" name="email" placeholder={content.form.email} autocomplete="email" required /></label>
      <label><span>{c.yourQuestion}</span><textarea name="message" placeholder={c.yourQuestion} rows="5" required></textarea></label>
      <p class="program-form__notice">{formNoticeStart}<a href={privacyHref}>{privacyLabel}</a>.</p>
      <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
      <button class="program-button" type="submit">{content.form.submit}</button>
    </form>
  </article>
</dialog>

<dialog class="course-dialog form-dialog advice-dialog" id={popupId(registrationHook)} aria-labelledby="registration-dialog-title">
  <article class="course-dialog__panel">
    <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}><span aria-hidden="true">×</span></button>
    <div class="advice-dialog__grid">
      <div class="advice-dialog__content">
        <h2 id="registration-dialog-title">{content.adviceTitle}</h2>
        <p>{content.adviceText}</p>
        <form class="program-form js-lead-form" data-redirect={redirect}>
          <input type="hidden" name="type" value="courses" /><input type="hidden" name="lang" value={lang} />
          <input class="program-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
          <label><span>{content.form.name}</span><input type="text" name="name" placeholder={content.form.name} autocomplete="name" required /></label>
          <label><span>{content.form.phone}</span><input type="tel" name="phone" placeholder={content.form.phone} autocomplete="tel" /></label>
          <label><span>{content.form.email}</span><input type="email" name="email" placeholder={content.form.email} autocomplete="email" required /></label>
          <p class="program-form__notice">{formNoticeStart}<a href={privacyHref}>{privacyLabel}</a>.</p>
          <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
          <button class="program-button" type="submit">{content.form.submit}</button>
        </form>
      </div>
      <figure class="advice-dialog__media">
        <img class="advice-dialog__photo" src={programAssets.consultation} alt={c.consultationAlt} />
        <img class="advice-dialog__curve advice-dialog__curve--top" src={programAssets.accentCurve} alt="" aria-hidden="true" />
        <img class="advice-dialog__curve advice-dialog__curve--bottom" src={programAssets.accentCurve} alt="" aria-hidden="true" />
      </figure>
    </div>
  </article>
</dialog>

<dialog class="course-dialog schedule-dialog" id={popupId(scheduleHook)} aria-labelledby="schedule-dialog-title">
  <article class="course-dialog__panel">
    <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}><span aria-hidden="true">×</span></button>
    <h2 id="schedule-dialog-title">{content.datesTitle}</h2>
    <div class="schedule-dialog__grid">
      {scheduleMonths.map(([month, days]) => <section><h3>{month}</h3><ul>{days.map((day) => <li>{day}</li>)}</ul></section>)}
    </div>
  </article>
</dialog>

<dialog class="course-dialog video-dialog" id="program-video-popup" aria-label={content.video}>
  <article class="course-dialog__panel">
    <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}><span aria-hidden="true">×</span></button>
    <VideoEmbed
      videoId="Q_0mtjo8GAU"
      title={content.video}
      poster={programAssets.consultation}
      lang={lang}
    />
  </article>
</dialog>

<style>
  .program-shell {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .program-section {
    position: relative;
    padding-block: clamp(4.5rem, 8vw, 8rem);
    overflow: hidden;
    background: #0d0d0d;
  }

  .program-section:nth-of-type(even) {
    background: #101010;
  }

  .program-section h2 {
    font-size: var(--fs-h1);
  }

  .program-section h2 span,
  .program-prep h3 {
    color: var(--color-accent);
  }

  /* Hero geometry is owned by .page-hero in global.css. */
  .program-hero {
    background: #0d0d0d;
  }

  .program-hero h1 {
    /* German compounds such as "Bildungsprogramme" are long single tokens, so
       the heading must be allowed to hyphenate rather than overflow. */
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
  }

  .program-hero__headline-accent {
    display: block;
    color: var(--color-accent);
  }

  .program-hero__headline-line,
  .program-hero__headline-rest {
    display: block;
  }

  .program-hero__headline-rest {
    color: #fff;
  }

  .program-hero p {
    color: rgba(255, 255, 255, 0.84);
  }

  .program-hero__accreditation {
    position: absolute;
    z-index: 3;
    right: clamp(28px, 4vw, 72px);
    bottom: clamp(72px, 13vh, 150px);
    width: clamp(285px, 20vw, 390px);
    height: auto;
    margin: 0;
  }

  /* Box comes from .page-hero__art. */

  .program-hero__art {
    position: absolute;
    height: auto;
    transform-origin: 56% 48%;
    animation: program-art-drift 11s ease-in-out infinite;
  }

  /* Decorative renders are sized from the hero's HEIGHT, not the viewport
     width. A vw-sized square overflowed the frame on wide screens, so the
     shape was sliced off and the space it should have filled read as an empty
     gap. Height-bounding keeps the whole render inside at every width, which
     also makes the per-breakpoint width ladders unnecessary. */
  .program-hero__art--large {
    left: 60%;
    top: 54%;
    max-height: min(82%, 460px);
    max-width: 66%;
  }

  .program-hero__art--small {
    left: 26%;
    top: 36%;
    max-height: min(50%, 285px);
    max-width: 44%;
    opacity: 0.72;
    filter: brightness(0.82);
    animation-delay: -4s;
    animation-direction: reverse;
  }

  .program-benefits {
    padding-top: clamp(3rem, 5vw, 5rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  .program-benefits h2 {
    margin-bottom: 2.25rem;
  }

  .program-benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .program-benefits article {
    min-height: 145px;
    padding: clamp(1.35rem, 2.6vw, 2.2rem);
    border-top: 2px solid rgba(255, 11, 0, 0.72);
    background: #292929;
  }

  .program-benefits h3 {
    margin-bottom: 0.55rem;
    font-size: var(--fs-h4);
  }

  .program-benefits p,
  .program-network figcaption,
  .program-advice p,
  .program-future p,
  .program-prep p,
  .program-webinar p,
  .program-webinar li span {
    color: rgba(255, 255, 255, 0.75);
  }

  .program-catalog {
    padding-top: 0;
    padding-bottom: clamp(5rem, 9vw, 9rem);
    background: #0d0d0d;
  }

  .course-group {
    position: relative;
    margin-top: clamp(5rem, 8vw, 8.5rem);
  }

  .course-group:first-child {
    margin-top: 0;
  }

  .course-group h2 {
    margin-bottom: clamp(2rem, 3vw, 3rem);
    font-size: var(--fs-h1);
  }

  .course-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2vw, 2.75rem);
  }

  .course-grid--individual {
    padding-right: 0;
  }

  .course-card {
    position: relative;
    display: flex;
    min-height: clamp(210px, 13vw, 260px);
    overflow: hidden;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    padding: 5rem clamp(1.5rem, 2vw, 2.4rem) clamp(1.65rem, 2vw, 2.2rem);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--dur-med) var(--ease-out),
      background var(--dur-med) var(--ease-out),
      box-shadow var(--dur-med) var(--ease-out),
      transform var(--dur-med) var(--ease-out);
  }

  /* Accent rule along the top edge. It has to follow the card's rounding, so it
     is inset and rounded rather than pinned to a square corner. */
  .course-card::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: 0;
    left: clamp(1.5rem, 2vw, 2.4rem);
    width: clamp(72px, 7vw, 128px);
    height: 4px;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--color-accent-surface);
    transition: width 260ms var(--ease-out);
  }

  .course-card::after {
    content: '';
    position: absolute;
    right: clamp(1.5rem, 2vw, 2.4rem);
    bottom: clamp(1.75rem, 2vw, 2.3rem);
    width: 14px;
    height: 14px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    opacity: 0.42;
    transform: rotate(45deg);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .course-card:hover,
  .course-card:focus-visible {
    border-color: var(--color-accent);
    outline: none;
    background: var(--surface-card-hover);
    box-shadow: var(--shadow-card), var(--shadow-accent);
    transform: translateY(-5px);
  }

  .course-card:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  .course-card:hover::before,
  .course-card:focus-visible::before {
    width: calc(100% + 2px);
  }

  .course-card:hover::after,
  .course-card:focus-visible::after {
    opacity: 1;
    transform: translateX(5px) rotate(45deg);
  }

  .course-card strong {
    max-width: calc(100% - 48px);
    font-size: var(--fs-h4);
    line-height: 1.18;
    text-wrap: balance;
  }

  .course-card__format {
    position: absolute;
    top: 1.05rem;
    left: clamp(1.5rem, 2vw, 2.4rem);
    max-width: calc(100% - 165px);
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: 1.3;
  }

  .course-card__duration {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 120px;
    padding: 0.62rem 1rem;
    background: #fff;
    color: var(--color-accent);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    text-align: center;
  }

  .course-group__curve {
    position: absolute;
    z-index: 0;
    right: -2%;
    bottom: -110px;
    width: min(32vw, 400px);
    height: auto;
    opacity: 0.55;
    pointer-events: none;
    transform-origin: center;
    animation: program-curve-drift 9s ease-in-out infinite;
  }

  .program-network {
    margin-top: clamp(4rem, 8vw, 7.5rem);
  }

  .program-network img {
    width: 100%;
    max-height: 670px;
    object-fit: contain;
  }

  .program-network figcaption {
    max-width: 1120px;
    margin-top: 1.4rem;
    font-size: var(--fs-sm);
  }

  .program-dates {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .program-dates h2 {
    margin-bottom: 2rem;
  }

  .program-dates__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 6rem);
  }

  .program-dates__grid--single {
    max-width: none;
    grid-template-columns: 1fr;
  }

  .date-column h3 {
    margin-bottom: 1rem;
    font-size: var(--fs-body);
  }

  .date-column ul {
    display: grid;
  }

  .date-column li {
    display: flex;
    min-height: 54px;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    border-bottom: 1px solid rgba(255, 11, 0, 0.58);
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--fs-body);
  }

  .date-column strong {
    color: #fff;
    font-size: var(--fs-2xs);
    font-weight: var(--fw-regular);
  }

  .program-button {
    display: inline-flex;
    min-width: 150px;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
    padding: 0.75rem 1.35rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-accent-surface);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    transition: background var(--dur-fast), color var(--dur-fast), transform var(--dur-fast);
  }

  .program-button:hover,
  .program-button:focus-visible {
    background: #fff;
    color: #111;
    transform: translateY(-2px);
  }

  .program-button--outline {
    background: transparent;
  }

  .program-advice {
    padding-top: 0;
  }

  .program-advice__panel {
    display: grid;
    min-height: 520px;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    overflow: hidden;
    background: #303030;
  }

  .program-advice__image-wrap {
    position: relative;
    min-height: 420px;
  }

  .program-advice__image-wrap > img:first-child {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .program-advice__curve {
    position: absolute;
    top: -45px;
    left: -60px;
    width: 230px;
    /* Without this the height="1724" attribute wins and stretches the curve. */
    height: auto;
    opacity: 0.6;
    animation: program-curve-drift 8s ease-in-out infinite reverse;
  }

  .program-advice__content {
    padding: clamp(2rem, 4vw, 4rem);
  }

  .program-advice h2 {
    margin-bottom: 0.9rem;
    font-size: var(--fs-h1);
  }

  .program-form {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .program-form label:not(.program-form__consent) {
    display: grid;
    gap: 0.35rem;
    color: #fff;
    font-size: var(--fs-2xs);
    line-height: 1.3;
  }

  .program-form label:not(.program-form__consent) > span {
    font-weight: var(--fw-semibold);
  }

  .program-form input[type='text'],
  .program-form input[type='tel'],
  .program-form input[type='email'] {
    width: 100%;
    height: 48px;
    border: 1px solid rgba(0, 0, 0, 0.35);
    border-radius: 2px;
    background: #fff;
    color: #111;
    padding-inline: 1rem;
  }

  .program-form textarea {
    width: 100%;
    min-height: 130px;
    resize: vertical;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: #151515;
    color: #fff;
    font: inherit;
    padding: 1rem;
  }

  .program-form__trap {
    position: absolute;
    left: -9999px;
  }

  .program-form__notice {
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: var(--fs-2xs);
    line-height: 1.45;
  }

  .program-form__notice a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .program-form .program-button {
    width: max-content;
    margin-top: 0.4rem;
  }

  .lead-form__status {
    color: #ff9b96;
    font-size: var(--fs-xs);
  }

  .program-future__grid {
    display: grid;
    min-height: 630px;
    grid-template-columns: minmax(0, 0.82fr) minmax(500px, 1.18fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  /* The accent line is now a small eyebrow, and the heading itself is capped
     lower so it no longer fills most of the screen (review AK#6). */
  .program-future h2 {
    margin-bottom: 1.4rem;
    font-size: var(--fs-h2);
    line-height: 1.14;
  }
  .program-future__eyebrow {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--color-accent);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .program-future p + p {
    margin-top: 1.1rem;
  }

  .program-future__media {
    position: relative;
    min-height: 520px;
  }

  .program-future__diploma {
    width: min(100%, 620px);
    height: auto;
    margin-inline: auto;
    animation: program-art-drift 10s ease-in-out infinite reverse;
  }

  .program-future__certification {
    position: absolute;
    right: 0;
    bottom: 30px;
    width: min(28vw, 175px);
    height: auto;
    animation: program-badge-float 7s ease-in-out infinite;
  }

  .program-steps {
    padding-top: clamp(2rem, 4vw, 4rem);
  }

  .program-steps > .program-shell > h2 {
    margin-bottom: 2.3rem;
  }

  .program-steps__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Same card language as the rest of the site: rounded, elevated, gradient
     surface, with the step number as a badge in the flow. */
  .program-steps__grid li {
    position: relative;
    display: flex;
    min-height: 145px;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.85rem, 1.1vw, 1.15rem);
    padding: clamp(1.4rem, 1.8vw, 1.9rem);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out),
      background var(--dur-med) var(--ease-out),
      box-shadow var(--dur-med) var(--ease-out);
  }

  .program-steps__grid li:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    background: var(--surface-card-hover);
    box-shadow: var(--shadow-card), var(--shadow-accent);
  }

  .program-steps__grid li > span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    border-radius: var(--radius-pill);
    background: var(--color-accent-surface);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    box-shadow: var(--shadow-accent);
  }

  .program-steps__grid p {
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--fs-lead);
    font-weight: var(--fw-regular);
    line-height: 1.4;
  }

  .program-prep {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: 2.2rem;
  }

  .program-prep h3 {
    margin-bottom: 0.65rem;
    font-size: var(--fs-h5);
  }

  .program-webinar__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(500px, 1.12fr);
    gap: clamp(2rem, 5vw, 5rem);
    /* Stretch, not start. The copy column is much taller than a capped image
       plus two buttons, which left a ~180px hole under the media column. */
    align-items: stretch;
  }

  .program-webinar__media {
    display: flex;
    flex-direction: column;
  }

  .program-webinar h2 {
    margin-bottom: 1.5rem;
    font-size: var(--fs-display);
  }

  .program-webinar h3 {
    margin-bottom: 0.4rem;
    color: var(--color-accent);
    font-size: var(--fs-h5);
  }

  .program-webinar ul {
    margin-top: 1.25rem;
  }

  .program-webinar li {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .program-webinar li strong {
    font-size: var(--fs-body);
  }

  .program-webinar__closing {
    margin-top: 1.4rem;
  }

  .program-webinar__media img {
    /* Grows to fill whatever height the copy column sets, so the two columns
       end on the same line instead of leaving a gap. */
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    object-position: center 30%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .program-webinar__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .program-webinar__actions .program-button {
    width: 100%;
    margin-top: 0.85rem;
  }

  /* A calm, centred sheet: soft rounding, one subtle hairline, and depth from
     the shadow rather than from a hard accent rule across the top. */
  .course-dialog {
    width: min(820px, calc(100vw - 32px));
    max-height: min(86vh, 880px);
    margin: auto;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: #fff;
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(0, 0, 0, 0.4);
  }

  .course-dialog[open] {
    animation: course-dialog-in var(--dur-med) var(--ease-out);
  }

  @keyframes course-dialog-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  .course-dialog::backdrop {
    background: rgba(6, 6, 6, 0.72);
    backdrop-filter: blur(8px) saturate(120%);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
  }

  @media (prefers-reduced-motion: reduce) {
    .course-dialog[open] {
      animation: none;
    }
  }

  .course-dialog__panel {
    position: relative;
    max-height: min(88vh, 900px);
    overflow-y: auto;
    overscroll-behavior: contain;
    /* Scrollbar stays visible so it is obvious the content scrolls (AK#16). */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
    padding: clamp(1.75rem, 3.5vw, 3rem);
  }

  .course-dialog__panel::-webkit-scrollbar {
    width: 8px;
  }
  .course-dialog__panel::-webkit-scrollbar-track {
    background: transparent;
  }
  .course-dialog__panel::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-pill);
  }
  .course-dialog__panel::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.34);
  }

  /* Bottom fade + hint, shown only while the panel can still scroll down. */
  .course-dialog::after {
    content: '';
    position: absolute;
    left: 0;
    right: 10px;
    bottom: 0;
    height: 72px;
    background: linear-gradient(transparent, #161616);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }
  .course-dialog.is-scrollable:not(.is-bottom)::after { opacity: 1; }
  /* A quiet hint, not a red badge — it is guidance, not a call to action. */
  .course-dialog__scrollhint {
    position: absolute;
    left: 50%;
    bottom: 14px;
    z-index: 2;
    display: none;
    transform: translateX(-50%);
    padding: 0.32rem 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    pointer-events: none;
  }
  .course-dialog.is-scrollable:not(.is-bottom) .course-dialog__scrollhint { display: inline-block; }

  /* Sized for a dialog, not a page hero — the old clamp topped out at 4rem and
     pushed the actual content below the fold of the sheet. */
  /* The close button floats right, so the heading needs room to clear it but
     should still use most of the sheet width rather than wrapping to a column. */
  .course-dialog h2 {
    max-width: 38ch;
    margin-bottom: clamp(1.15rem, 2vw, 1.6rem);
    color: #fff;
    font-size: var(--fs-h3);
    line-height: 1.22;
    text-wrap: balance;
  }

  .course-dialog__eyebrow {
    margin: 0 0 0.6rem;
    color: var(--color-accent);
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .course-dialog__content {
    max-width: 82ch;
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--fs-body);
    line-height: 1.72;
  }

  .course-dialog__content > * {
    margin: 0;
  }

  .course-dialog__content > * + * {
    margin-top: 1.15rem;
  }

  .course-dialog__content h3 {
    padding-top: 1rem;
    color: #fff;
    font-size: var(--fs-h4);
    line-height: 1.3;
  }

  .course-dialog__content ul {
    display: grid;
    gap: 0.85rem;
    padding-left: 1.35rem;
  }

  .course-dialog__content li {
    padding-left: 0.25rem;
  }

  .course-dialog__content li::marker {
    color: var(--color-accent);
  }

  /* Circular, quiet by default, accent on hover — the close control should not
     compete with the dialog's own call to action. */
  .course-dialog__close {
    position: sticky;
    z-index: 2;
    top: 0;
    float: right;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: -0.35rem -0.35rem 0 0.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--fs-lead);
    line-height: 1;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .course-dialog__close:hover,
  .course-dialog__close:focus-visible {
    border-color: var(--color-accent);
    background: rgba(244, 14, 14, 0.14);
    color: #fff;
    transform: rotate(90deg);
  }

  .course-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .form-dialog,
  .schedule-dialog { width: min(760px, calc(100vw - 32px)); }

  .form-dialog .course-dialog__panel,
  .schedule-dialog .course-dialog__panel { width: 100%; }

  .advice-dialog { width: min(1180px, calc(100vw - 48px)); }

  .advice-dialog .course-dialog__panel { width: 100%; padding: clamp(2rem, 4vw, 4rem); }

  .advice-dialog .course-dialog__close {
    position: absolute;
    top: clamp(1.25rem, 2.5vw, 2rem);
    right: clamp(1.25rem, 2.5vw, 2rem);
    float: none;
  }

  .advice-dialog__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(320px, .98fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: stretch;
  }

  .advice-dialog__content { align-self: center; min-width: 0; }
  .advice-dialog__content h2 { padding-right: 3.5rem; margin-bottom: 1rem; }

  .advice-dialog__media {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    background: #282828;
  }

  .advice-dialog__photo { width: 100%; height: 100%; object-fit: cover; object-position: 54% center; }

  .advice-dialog__curve {
    position: absolute;
    width: 112px;
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 16px 22px rgba(0, 0, 0, .45));
  }

  .advice-dialog__curve--top { top: -16px; left: -22px; transform: rotate(274deg); }
  .advice-dialog__curve--bottom { right: -28px; bottom: -20px; transform: rotate(150deg); }

  .form-dialog .program-form {
    margin-top: 1.5rem;
  }

  .schedule-dialog__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .schedule-dialog h3 {
    margin-bottom: 0.8rem;
    color: var(--color-accent);
  }

  .schedule-dialog li {
    margin-top: 0.55rem;
    color: #fff;
  }

  .video-dialog { width: min(1180px, calc(100vw - 24px)); }

  .video-dialog .course-dialog__panel { width: 100%; max-height: none; padding: 0; overflow: hidden; }

  .video-dialog .course-dialog__close {
    position: absolute;
    z-index: 5;
    top: 12px;
    right: 12px;
    float: none;
    background: rgba(13, 13, 13, .88);
  }

  .video-dialog iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .external-media {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 0;
    aspect-ratio: 16 / 9;
    place-items: center;
    background: #090909;
  }

  .external-media iframe {
    grid-area: 1 / 1;
  }

  .external-media iframe[hidden],
  .external-media__notice[hidden] { display: none !important; }

  /* The global rule pins this to inset: 0 — it must stay full-bleed inside the
     frame, so cap the copy width rather than the box itself. */
  .external-media__notice {
    display: grid;
    grid-area: 1 / 1;
    gap: 1.2rem;
    justify-items: center;
    padding: 2rem;
    text-align: center;
  }

  .external-media__notice p {
    max-width: 520px;
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @keyframes program-art-drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-1deg); }
    50% { transform: translate3d(-1.1%, -2.2%, 0) rotate(1.4deg); }
  }

  @keyframes program-curve-drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-3deg); }
    50% { transform: translate3d(12px, -16px, 0) rotate(3deg); }
  }

  @keyframes program-badge-float {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    50% { transform: translate3d(-8px, -13px, 0) rotate(-2deg); }
  }

  @media (min-width: 1440px) {
    .program-benefits article,
    .course-card,
    .program-steps__grid li {
      padding-inline: clamp(1.5rem, 2vw, 2.4rem);
    }

    .program-network img {
      max-height: 740px;
    }
  }

  @media (max-width: 1100px) and (min-width: 761px) {
    .course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 980px) {

    .program-hero__media {
      inset: 104px calc(var(--container-pad) * -1) 0 46%;
    }


    .program-hero__accreditation {
      right: 24px;
      bottom: 32px;
      width: min(29vw, 260px);
    }

    .course-card strong {
      max-width: 100%;
    }

    .program-advice__panel,
    .program-future__grid,
    .program-webinar__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .schedule-dialog__grid { grid-template-columns: 1fr; }
    .program-section {
      padding-block: 3.75rem;
    }

    .program-hero__layout {
    flex-direction: column-reverse;
    gap: 1.25rem;
  }

    .program-hero__media {
      position: relative;
      inset: auto;
      min-height: clamp(220px, 62vw, 330px);
      margin-inline: calc(var(--container-pad) * -0.45);
    }


    .program-hero__headline-rest {
      white-space: normal;
    }

    .program-hero__accreditation {
