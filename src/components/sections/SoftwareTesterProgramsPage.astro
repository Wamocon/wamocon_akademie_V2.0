<script>
  function initProgramExternalMediaConsent() {
    document.querySelectorAll<HTMLElement>('[data-external-media]').forEach((media) => {
      if (media.dataset.externalMediaReady === 'true') return;
      media.dataset.externalMediaReady = 'true';

      const iframe = media.querySelector<HTMLIFrameElement>('iframe[data-consent-src]');
      const notice = media.querySelector<HTMLElement>('[data-external-media-notice]');
      const loadButton = media.querySelector<HTMLButtonElement>('[data-external-media-load]');

      loadButton?.addEventListener('click', () => {
        const source = iframe?.dataset.consentSrc;
        if (!iframe || !source) return;
        iframe.src = source;
        iframe.hidden = false;
        if (notice) notice.hidden = true;
        media.classList.add('is-loaded');
      });
    });
  }

  initProgramExternalMediaConsent();
  document.addEventListener('astro:after-swap', initProgramExternalMediaConsent);

  const popupLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-course-popup], [data-dialog-hook]'));
  const dialogs = Array.from(document.querySelectorAll<HTMLDialogElement>('.course-dialog'));

  const openPopup = (link: HTMLAnchorElement) => {
    const dialogId = link.dataset.coursePopup ?? link.dataset.dialogHook;
    const dialog = dialogId ? document.getElementById(dialogId) : null;
    if (!(dialog instanceof HTMLDialogElement)) return;
    const parentDialog = link.closest('dialog');
    if (parentDialog instanceof HTMLDialogElement && parentDialog !== dialog && parentDialog.open) {
      parentDialog.close();
    }
    if (!dialog.open) dialog.showModal();
    const hook = link.getAttribute('href');
    if (hook) history.replaceState(null, '', hook);
  };

  popupLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      openPopup(link);
    });
  });

  dialogs.forEach((dialog) => {
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      if (location.hash.startsWith('#popup:') || location.hash === '#zeropopup') {
        history.replaceState(null, '', `${location.pathname}${location.search}`);
      }
    });
  });

  const matchingLink = popupLinks.find((link) => link.getAttribute('href') === location.hash);
  if (matchingLink) openPopup(matchingLink);
</script>
