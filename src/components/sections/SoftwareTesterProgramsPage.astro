---
import coursePopupCopy from '../../../audit/course-popup-copy.json';
import type { Lang } from '../../i18n/config';
import { programAssets, programContent, programCourses } from '../../data/programs';

interface Props {
  lang: Lang;
}

type PopupRecord = {
  hook: string;
  title: string;
  description: string;
  links: Array<{ text: string; href: string }>;
};

type PopupBlock =
  | { type: 'heading'; text: string }
  | { type: 'paragraph'; text: string }
  | { type: 'list'; items: string[] };

const { lang } = Astro.props;
const content = programContent[lang];
const courses = programCourses[lang];
const coursePopups = (coursePopupCopy as PopupRecord[]).filter((popup) => popup.hook.endsWith(`-${lang}`));
const popupId = (hook: string) => `course-${hook.replace('#popup:', '').replace(/[^a-z0-9-]+/gi, '-').toLowerCase()}`;
const cleanPopupDescription = (description: string) => {
  const fundingCopy = /Bildungsgutschein gefördert|education voucher funded/i.test(description);
  if (fundingCopy) {
    return lang === 'de'
      ? 'Dieses Kursangebot verbindet Grundlagen des Softwaretestens mit praxisnaher Prüfungsvorbereitung. Aktuelle Termine und Preise: In Planung. Eine Förderung durch Bildungsgutschein kann im Einzelfall möglich sein. Über Voraussetzungen, förderfähige Kosten und Bewilligung entscheiden die zuständige Agentur für Arbeit oder das Jobcenter. Bitte lassen Sie die Förderung vor einer Anmeldung schriftlich bestätigen. Eine Anfrage über diese Website ist unverbindlich und stellt keinen Kauf dar.'
      : 'This course combines software-testing fundamentals with practical examination preparation. Current dates and prices: Planned. Funding through a Bildungsgutschein may be available in individual cases. The responsible employment agency or job centre decides eligibility, covered costs and approval. Please obtain written confirmation before registering. An inquiry through this website is non-binding and does not constitute a purchase.';
  }
  return description
    .replace(/\s*(Eine Frage stellen|Ask a question)\s*$/, '')
    .replace(/Sich anmelden/g, 'Unverbindlich anfragen')
    .replace(/Register now/gi, 'Request information');
};
const popupLinkText = (text: string) => {
  if (/Sich anmelden/i.test(text)) return 'Unverbindlich anfragen';
  if (/Register now/i.test(text)) return 'Request information';
  return text;
};
const popupBlocks = (description: string): PopupBlock[] => {
  const blocks: PopupBlock[] = [];
  let paragraph: string[] = [];
  let list: string[] = [];

  const flushParagraph = () => {
    if (paragraph.length) blocks.push({ type: 'paragraph', text: paragraph.join(' ') });
    paragraph = [];
  };
  const flushList = () => {
    if (list.length) blocks.push({ type: 'list', items: list });
    list = [];
  };

  cleanPopupDescription(description)
    .replace(/\r\n?/g, '\n')
    .split('\n')
    .forEach((rawLine) => {
      const line = rawLine.trim();
      if (!line) {
        flushParagraph();
        flushList();
        return;
      }

      const isHeading =
        line.endsWith(':') ||
        /^(?:Tag|Day)\s+\d+\s*:/i.test(line) ||
        /^\d+\.\s*(?:Etappe|Stage|Phase)\b/i.test(line);
      if (isHeading) {
        flushParagraph();
        flushList();
        blocks.push({ type: 'heading', text: line.replace(/:$/, '') });
        return;
      }

      const bullet = line.match(/^(?:[-–—•]|\d+[.)])\s+(.+)$/);
      if (bullet) {
        flushParagraph();
        list.push(bullet[1]);
        return;
      }

      flushList();
      paragraph.push(line);
    });

  flushParagraph();
  flushList();
  return blocks;
};
const redirect = lang === 'de' ? '/danke/' : '/thanks/';
const questionHook = lang === 'de' ? '#popup:eine-Frage-stellen' : '#popup:eine-Frage-stellen-en';
const registrationHook = lang === 'de' ? '#popup:myform' : '#popup:myform-en';
const scheduleHook = lang === 'de' ? '#popup:Termine' : '#popup:Termine-en';
const normalizePopupHref = (href: string) => {
  if (href === '#order') return registrationHook;
  if (lang === 'en' && href === '#popup:eine-Frage-stellen') return questionHook;
  return href;
};
const certificationHref = lang === 'de' ? '/istqb-zertifizierung/' : '/en/istqb-certification/';
const privacyHref = lang === 'de' ? '/datenschutz/' : '/privacy-policy/';
const privacyLabel = lang === 'de' ? 'Datenschutzerklärung' : 'privacy policy';
const formNoticeStart = lang === 'de'
  ? 'Ihre Anfrage an die WAMOCON Academy GmbH ist unverbindlich und stellt keinen Kauf dar. Informationen zur Verarbeitung Ihrer Daten finden Sie in der '
  : 'Your inquiry to WAMOCON Academy GmbH is non-binding and does not constitute a purchase. Information about the processing of your data can be found in the ';
const scheduleMonths: Array<[string, string[]]> = lang === 'de'
  ? [['In Planung', ['Neue Kurstermine werden bekannt gegeben.']]]
  : [['Planned', ['New course dates will be announced.']]];
---

<section class="page-hero program-hero">
  <div class="program-shell program-hero__layout">
    <div class="program-hero__copy" data-reveal>
      <h1><span>{content.heroAccent}</span><br />{content.heroRest}</h1>
      <p>{content.lead}</p>
      <img
        class="program-hero__accreditation"
        src={programAssets.accreditation}
        alt="Hessen, ISTQB Accredited Training Provider und International Software Testing Qualifications Board"
        width="1400"
        height="450"
      />
    </div>
    <img class="program-hero__art" src={programAssets.hero} alt="" width="1680" height="1670" loading="eager" />
  </div>
</section>

<section class="program-section program-benefits">
  <div class="program-shell">
    <h2><span>{content.benefitsTitle.split(' ')[0]}</span> {content.benefitsTitle.split(' ').slice(1).join(' ')}</h2>
    <div class="program-benefits__grid">
      {content.benefits.map(([title, text]) => (
        <article data-reveal>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="program-section program-catalog">
  <div class="program-shell">
    <div class="course-group course-group--individual">
      <h2>{content.individualTitle}</h2>
      <div class="course-grid course-grid--individual">
        {courses.individual.map((course) => (
          <a
            class="course-card"
            href={course.hook}
            data-course-popup={popupId(course.hook)}
            aria-haspopup="dialog"
            aria-controls={popupId(course.hook)}
            data-reveal
          >
            <span class="course-card__format">{course.format}</span>
            <strong>{course.title}</strong>
            <span class="course-card__duration">{course.duration}</span>
          </a>
        ))}
      </div>
      <img class="course-group__curve" src={programAssets.accentCurve} alt="" width="2228" height="1724" loading="lazy" />
    </div>

    <div class="course-group course-group--team">
      <h2>{content.teamTitle}</h2>
      <div class="course-grid">
        {courses.team.map((course) => (
          <a
            class="course-card"
            href={course.hook}
            data-course-popup={popupId(course.hook)}
            aria-haspopup="dialog"
            aria-controls={popupId(course.hook)}
            data-reveal
          >
            <span class="course-card__format">{course.format}</span>
            <strong>{course.title}</strong>
            <span class="course-card__duration">{course.duration}</span>
          </a>
        ))}
      </div>
    </div>

    <figure class="program-network" data-reveal>
      <img src={programAssets.network} alt="ISTQB Lern- und Teamkurse im Überblick" width="1440" height="715" loading="lazy" />
      <figcaption>{content.networkText}</figcaption>
    </figure>
  </div>
</section>

<section class="program-section program-dates">
  <div class="program-shell">
    <h2>{content.datesTitle}</h2>
    <div class:list={['program-dates__grid', { 'program-dates__grid--single': content.dates.length === 1 }]}>
      {content.dates.map((date) => (
        <article class="date-column" data-reveal>
          <h3>{date.month}</h3>
          <ul>
            {date.rows.map(([day, status]) => <li><span>{day}</span><strong>{status}</strong></li>)}
          </ul>
        </article>
      ))}
    </div>
    <a class="program-button" href={scheduleHook} data-dialog-hook={popupId(scheduleHook)}>{content.moreDetails}</a>
  </div>
</section>

<section class="program-section program-advice" id="beratung">
  <div class="program-shell">
    <div class="program-advice__panel">
      <div class="program-advice__image-wrap" data-reveal>
        <img src={programAssets.consultation} alt={lang === 'de' ? 'Persönliche Beratung bei der WAMOCON Academy' : 'Personal consultation at WAMOCON Academy'} width="1600" height="900" loading="lazy" />
        <img class="program-advice__curve" src={programAssets.accentCurve} alt="" width="2228" height="1724" loading="lazy" aria-hidden="true" />
      </div>
      <div class="program-advice__content" data-reveal>
        <h2>{content.adviceTitle}</h2>
        <p>{content.adviceText}</p>
        <form class="program-form js-lead-form" data-redirect={redirect}>
          <input type="hidden" name="type" value="courses" />
          <input type="hidden" name="lang" value={lang} />
          <input class="program-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
          <label><span>{content.form.name}</span><input type="text" name="name" placeholder={content.form.name} autocomplete="name" required /></label>
          <label><span>{content.form.phone}</span><input type="tel" name="phone" placeholder={content.form.phone} autocomplete="tel" /></label>
          <label><span>{content.form.email}</span><input type="email" name="email" placeholder={content.form.email} autocomplete="email" required /></label>
          <p class="program-form__notice">{formNoticeStart}<a href={privacyHref}>{privacyLabel}</a>.</p>
          <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
          <button class="program-button" type="submit">{content.form.submit}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="program-section program-future">
  <div class="program-shell program-future__grid">
    <div class="program-future__copy" data-reveal>
      <h2><a href={certificationHref}><span>{content.futureTitleAccent}</span><br />{content.futureTitleRest}</a></h2>
      <p>{content.futureIntro}</p>
      <p>{content.futureText}</p>
    </div>
    <div class="program-future__media" data-reveal>
      <img class="program-future__diploma" src={programAssets.diploma} alt="Abschlusskappe und Zertifikat" width="1280" height="1280" loading="lazy" />
      <img class="program-future__certification" src={programAssets.certification} alt="ISTQB Accredited Training Provider" width="726" height="450" loading="lazy" />
    </div>
  </div>
</section>

<section class="program-section program-steps">
  <div class="program-shell">
    <h2><span>{content.stepsTitle.split(' ').slice(0, 3).join(' ')}</span> {content.stepsTitle.split(' ').slice(3).join(' ')}</h2>
    <ol class="program-steps__grid">
      {content.steps.map((step, index) => (
        <li data-reveal>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{step}</p>
        </li>
      ))}
    </ol>
    <div class="program-prep">
      {content.prep.map(([title, text]) => (
        <article data-reveal>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="program-section program-webinar">
  <div class="program-shell program-webinar__grid">
    <div class="program-webinar__copy" data-reveal>
      <h2>{content.webinarTitle}</h2>
      <h3>{content.webinarIntroTitle}</h3>
      <p>{content.webinarIntro}</p>
      <ul>
        {content.webinarItems.map(([title, text]) => (
          <li>
            <strong>{title}</strong>
            <span>{text}</span>
          </li>
        ))}
      </ul>
      <p class="program-webinar__closing">{content.webinarClosing}</p>
    </div>
    <div class="program-webinar__media" data-reveal>
      <img src={programAssets.webinar} alt="Softwaretester bei der Arbeit" width="1680" height="1118" loading="lazy" />
      <div class="program-webinar__actions">
        <a class="program-button" href={certificationHref}>{content.moreDetails}</a>
        <a class="program-button program-button--outline" href="#zeropopup" data-dialog-hook="program-video-popup">{content.video}</a>
      </div>
    </div>
  </div>
</section>

{coursePopups.map((popup) => (
  <dialog class="course-dialog" id={popupId(popup.hook)} aria-labelledby={`${popupId(popup.hook)}-title`}>
    <article class="course-dialog__panel">
      <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}>
        <span aria-hidden="true">×</span>
      </button>
      <h2 id={`${popupId(popup.hook)}-title`}>{popup.title}</h2>
      <div class="course-dialog__content">
        {popupBlocks(popup.description).map((block) => (
          block.type === 'heading'
            ? <h3>{block.text}</h3>
            : block.type === 'list'
              ? <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
              : <p>{block.text}</p>
        ))}
      </div>
      <div class="course-dialog__actions">
        {popup.links.map((link, index) => (
          <a
            class:list={['program-button', { 'program-button--outline': index > 0 }]}
            href={normalizePopupHref(link.href)}
            data-dialog-hook={normalizePopupHref(link.href).startsWith('#popup:') ? popupId(normalizePopupHref(link.href)) : undefined}
          >{popupLinkText(link.text)}</a>
        ))}
      </div>
    </article>
  </dialog>
))}

<dialog class="course-dialog form-dialog" id={popupId(questionHook)} aria-labelledby="question-dialog-title">
  <article class="course-dialog__panel">
    <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}><span aria-hidden="true">×</span></button>
    <h2 id="question-dialog-title">{lang === 'de' ? 'Eine Frage stellen' : 'Ask a question'}</h2>
    <form class="program-form js-lead-form" data-redirect={redirect}>
      <input type="hidden" name="type" value="question" /><input type="hidden" name="lang" value={lang} />
      <input class="program-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
      <label><span>{content.form.name}</span><input type="text" name="name" placeholder={content.form.name} autocomplete="name" required /></label>
      <label><span>{content.form.email}</span><input type="email" name="email" placeholder={content.form.email} autocomplete="email" required /></label>
      <label><span>{lang === 'de' ? 'Ihre Frage' : 'Your question'}</span><textarea name="message" placeholder={lang === 'de' ? 'Ihre Frage' : 'Your question'} rows="5" required></textarea></label>
      <p class="program-form__notice">{formNoticeStart}<a href={privacyHref}>{privacyLabel}</a>.</p>
      <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
      <button class="program-button" type="submit">{content.form.submit}</button>
    </form>
  </article>
</dialog>

<dialog class="course-dialog form-dialog" id={popupId(registrationHook)} aria-labelledby="registration-dialog-title">
  <article class="course-dialog__panel">
    <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}><span aria-hidden="true">×</span></button>
    <h2 id="registration-dialog-title">{content.adviceTitle}</h2>
    <p>{content.adviceText}</p>
    <form class="program-form js-lead-form" data-redirect={redirect}>
      <input type="hidden" name="type" value="courses" /><input type="hidden" name="lang" value={lang} />
      <input class="program-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
      <label><span>{content.form.name}</span><input type="text" name="name" placeholder={content.form.name} autocomplete="name" required /></label>
      <label><span>{content.form.phone}</span><input type="tel" name="phone" placeholder={content.form.phone} autocomplete="tel" /></label>
      <label><span>{content.form.email}</span><input type="email" name="email" placeholder={content.form.email} autocomplete="email" required /></label>
      <p class="program-form__notice">{formNoticeStart}<a href={privacyHref}>{privacyLabel}</a>.</p>
      <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
      <button class="program-button" type="submit">{content.form.submit}</button>
    </form>
  </article>
</dialog>

<dialog class="course-dialog schedule-dialog" id={popupId(scheduleHook)} aria-labelledby="schedule-dialog-title">
  <article class="course-dialog__panel">
    <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}><span aria-hidden="true">×</span></button>
    <h2 id="schedule-dialog-title">{content.datesTitle}</h2>
    <div class="schedule-dialog__grid">
      {scheduleMonths.map(([month, days]) => <section><h3>{month}</h3><ul>{days.map((day) => <li>{day}</li>)}</ul></section>)}
    </div>
  </article>
</dialog>

<dialog class="course-dialog video-dialog" id="program-video-popup" aria-label={content.video}>
  <article class="course-dialog__panel">
    <button class="course-dialog__close" type="button" data-dialog-close aria-label={content.close}><span aria-hidden="true">×</span></button>
    <div class="external-media" data-external-media>
      <iframe data-consent-src="https://www.youtube-nocookie.com/embed/8t24ww8EVbk" title={content.video} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen hidden></iframe>
      <div class="external-media__notice" data-external-media-notice>
        <p>{lang === 'de' ? 'Dieses Video wird erst nach Ihrer Zustimmung von YouTube geladen.' : 'This video loads from YouTube only after your consent.'}</p>
        <button class="program-button" type="button" data-external-media-load>{lang === 'de' ? 'Video laden' : 'Load video'}</button>
      </div>
    </div>
  </article>
</dialog>

<style>
  .program-shell {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .program-section {
    position: relative;
    padding-block: clamp(4.5rem, 8vw, 8rem);
    overflow: hidden;
    background: #0d0d0d;
  }

  .program-section:nth-of-type(even) {
    background: #101010;
  }

  .program-section h2 {
    font-size: clamp(2rem, 4.25vw, 4.4rem);
  }

  .program-section h2 span,
  .program-prep h3 {
    color: var(--color-accent);
  }

  .program-hero {
    min-height: 720px;
    overflow: hidden;
    background: #0d0d0d;
  }

  .program-hero__layout {
    position: relative;
    display: grid;
    min-height: 720px;
    grid-template-columns: minmax(0, 0.98fr) minmax(520px, 1.02fr);
    align-items: center;
    padding-top: 155px;
    padding-bottom: 52px;
  }

  .program-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 850px;
  }

  .program-hero h1 {
    margin: 0 0 1.45rem;
    font-size: clamp(3rem, 4.8vw, 5.2rem);
    line-height: 1.03;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .program-hero h1 span {
    color: var(--color-accent);
  }

  .program-hero p {
    max-width: 800px;
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    line-height: 1.45;
  }

  .program-hero__accreditation {
    width: clamp(220px, 21vw, 340px);
    height: auto;
    margin-top: 1.85rem;
  }

  .program-hero__art {
    position: absolute;
    z-index: 0;
    top: -2%;
    right: -4%;
    width: min(58vw, 880px);
    height: auto;
    transform-origin: 56% 48%;
    animation: program-art-drift 11s ease-in-out infinite;
  }

  .program-benefits {
    padding-top: clamp(3rem, 5vw, 5rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  .program-benefits h2 {
    margin-bottom: 2.25rem;
  }

  .program-benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .program-benefits article {
    min-height: 145px;
    padding: clamp(1.35rem, 2.6vw, 2.2rem);
    border-top: 2px solid rgba(255, 11, 0, 0.72);
    background: #292929;
  }

  .program-benefits h3 {
    margin-bottom: 0.55rem;
    font-size: clamp(1.08rem, 1.6vw, 1.45rem);
  }

  .program-benefits p,
  .program-network figcaption,
  .program-advice p,
  .program-future p,
  .program-prep p,
  .program-webinar p,
  .program-webinar li span {
    color: rgba(255, 255, 255, 0.75);
  }

  .program-catalog {
    padding-top: 0;
    padding-bottom: clamp(5rem, 9vw, 9rem);
    background: #0d0d0d;
  }

  .course-group {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .course-group:first-child {
    margin-top: 0;
  }

  .course-group h2 {
    margin-bottom: 2rem;
    font-size: clamp(2.15rem, 4vw, 4rem);
  }

  .course-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
  }

  .course-grid--individual {
    padding-right: 0;
  }

  .course-card {
    position: relative;
    display: flex;
    min-height: clamp(168px, 12vw, 196px);
    overflow: hidden;
    flex-direction: column;
    justify-content: flex-end;
    padding: 4.15rem clamp(1.3rem, 2vw, 2rem) clamp(1.35rem, 2vw, 1.9rem);
    border: 1px solid rgba(255, 255, 255, 0.44);
    background: #101010;
    transition: border-color var(--dur-fast), background var(--dur-fast), transform var(--dur-fast);
  }

  .course-card:hover,
  .course-card:focus-visible {
    border-color: var(--color-accent);
    background: #181818;
    transform: translateY(-3px);
  }

  .course-card strong {
    max-width: 92%;
    font-size: clamp(1.05rem, 1.25vw, 1.28rem);
    line-height: 1.22;
  }

  .course-card__format {
    position: absolute;
    top: 0.75rem;
    left: clamp(1.3rem, 2vw, 2rem);
    max-width: calc(100% - 135px);
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(0.66rem, 0.7vw, 0.76rem);
    line-height: 1.3;
  }

  .course-card__duration {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 96px;
    padding: 0.5rem 0.8rem;
    background: #fff;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: var(--fw-semibold);
    text-align: center;
  }

  .course-group__curve {
    position: absolute;
    z-index: 0;
    right: -2%;
    bottom: -110px;
    width: min(32vw, 400px);
    height: auto;
    opacity: 0.55;
    pointer-events: none;
    transform-origin: center;
    animation: program-curve-drift 9s ease-in-out infinite;
  }

  .program-network {
    margin-top: clamp(4rem, 8vw, 7.5rem);
  }

