---
import { legalNav, thanksHref, type Lang } from '../../i18n/config';
import { pick } from '../../i18n/utils';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const copy = pick(lang, {
  de: {
    close: 'Schließen', title: 'Senden Sie Ihre Bewertung', name: 'Name', namePlaceholder: 'Ihr Name',
    review: 'Bewertung', comments: 'Kommentare/Link zur Datei', submit: 'Anfrage senden',
    privacyPre: 'Informationen zur Verarbeitung finden Sie in der ', privacyLink: 'Datenschutzerklärung',
    publication: 'Optional: Ich willige ein, dass meine Bewertung zusammen mit meinem Namen als Teilnehmerstimme auf den Websites und in den Social-Media-Kanälen der WAMOCON Academy GmbH veröffentlicht werden darf. Die Einwilligung ist freiwillig und jederzeit mit Wirkung für die Zukunft widerrufbar.',
    notice: 'Ohne diese freiwillige Einwilligung wird die Bewertung nicht veröffentlicht. Dies ist kein Kauf.',
  },
  en: {
    close: 'Close', title: 'Send your evaluation', name: 'Name', namePlaceholder: 'Name',
    review: 'Evaluation', comments: 'Comments/link to the file', submit: 'Send request',
    privacyPre: 'Information about processing is provided in the ', privacyLink: 'privacy policy',
    publication: 'Optional: I consent to my review and name being published as a participant testimonial on WAMOCON Academy GmbH websites and social-media channels. This consent is voluntary and can be withdrawn at any time for the future.',
    notice: 'Without this voluntary consent, the review will not be published. This is not a purchase.',
  },
});
---

<dialog class="review-dialog" id="review-dialog" aria-labelledby="review-dialog-title">
  <div class="review-dialog__panel">
    <button class="review-dialog__close" type="button" data-review-close aria-label={copy.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 5l14 14M19 5 5 19" />
      </svg>
    </button>
    <h2 id="review-dialog-title">{copy.title}</h2>
    <form class="review-dialog__form js-lead-form" data-redirect={thanksHref[lang]}>
      <input type="hidden" name="type" value="review" />
      <input type="hidden" name="lang" value={lang} />
      <input class="review-dialog__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
      <label>
        <span>{copy.name}</span>
        <input type="text" name="name" placeholder={copy.namePlaceholder} required />
      </label>
      <label>
        <span>E-Mail</span>
        <input type="email" name="email" placeholder="E-Mail" required />
      </label>
      <label>
        <span>{copy.review}</span>
        <textarea name="comment" rows="5" placeholder={copy.comments} required></textarea>
      </label>
      <label class="review-dialog__consent">
        <input type="checkbox" name="publicationConsent" />
        <span>{copy.publication}</span>
      </label>
      <p class="review-dialog__privacy">{copy.privacyPre}<a href={legalNav.privacy[lang].href}>{copy.privacyLink}</a>.</p>
      <p class="review-dialog__notice">{copy.notice}</p>
      <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
      <button class="review-dialog__submit" type="submit">{copy.submit}</button>
    </form>
  </div>
</dialog>

<style>
  .review-dialog {
    width: min(880px, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    border: 0;
    border-radius: var(--radius-lg);
    background: transparent;
    color: #fff;
  }

  .review-dialog::backdrop {
    background: rgba(6, 6, 6, 0.72);
    backdrop-filter: blur(8px) saturate(120%);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
  }

  /* Matches the course dialog so every popup on the site reads as one family. */
  .review-dialog__panel {
    position: relative;
    overflow-y: auto;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.9);
  }

  .review-dialog[open] {
    animation: review-dialog-in var(--dur-med) var(--ease-out);
  }

  @keyframes review-dialog-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .review-dialog[open] {
      animation: none;
    }
  }

  .review-dialog__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.75);
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .review-dialog__close:hover,
  .review-dialog__close:focus-visible {
    border-color: var(--color-accent);
    background: rgba(244, 14, 14, 0.14);
    color: #fff;
    transform: rotate(90deg);
  }

  .review-dialog__close svg { width: 26px; }
  .review-dialog__close path { fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 2; }

  .review-dialog h2 {
    padding-right: 3rem;
    font-size: var(--fs-h2);
  }

  .review-dialog__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .review-dialog__form > label:not(.review-dialog__consent) {
    display: grid;
    gap: 0.4rem;
  }

  .review-dialog__form > label:nth-of-type(3),
  .review-dialog__consent,
  .review-dialog__privacy,
  .review-dialog__notice,
  .lead-form__status {
    grid-column: 1 / -1;
  }

  .review-dialog__form > label:not(.review-dialog__consent) > span {
    color: #fff;
    font-size: var(--fs-body);
    line-height: 1.4;
  }

  /* Fields sit on the dialog's own dark surface. Solid white boxes punched
     holes in the panel and made the form the loudest thing on screen. */
  .review-dialog__form input:not([type='checkbox']),
  .review-dialog__form textarea {
    width: 100%;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    padding: 0.9rem 1.1rem;
    font-size: var(--fs-body);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .review-dialog__form input:not([type='checkbox'])::placeholder,
  .review-dialog__form textarea::placeholder {
    color: rgba(255, 255, 255, 0.42);
  }

  .review-dialog__form input:not([type='checkbox']):focus,
  .review-dialog__form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.08);
  }

  .review-dialog__form textarea { resize: vertical; }
  .review-dialog__trap { position: absolute; left: -9999px; }

  .review-dialog__consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  .review-dialog__consent input { width: 22px; height: 22px; accent-color: var(--color-accent); }
  .review-dialog__consent a { text-decoration: underline; }
  .review-dialog__privacy { color: rgba(255,255,255,.72); font-size: var(--fs-sm); line-height: 1.5; }
  .review-dialog__privacy a { text-decoration: underline; }
  .review-dialog__notice { color: rgba(255, 255, 255, 0.72); font-size: var(--fs-sm); line-height: 1.5; }
  .review-dialog__submit { min-height: 52px; padding-inline: 2rem; justify-self: start; border-radius: var(--radius-pill); background: var(--color-accent-surface); font-size: var(--fs-sm); font-weight: 600; }
  .lead-form__status { color: #ff9b96; font-size: var(--fs-sm); }

  @media (max-width: 640px) {
    .review-dialog__form { grid-template-columns: 1fr; }
    .review-dialog__form > label:nth-of-type(3),
    .review-dialog__consent,
    .review-dialog__privacy,
    .review-dialog__notice,
    .lead-form__status { grid-column: auto; }
  }
</style>

<script>
  const reviewDialog = document.getElementById('review-dialog');
  document.querySelectorAll('[data-review-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (reviewDialog instanceof HTMLDialogElement) reviewDialog.showModal();
    });
  });
  document.querySelectorAll('[data-review-close]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (reviewDialog instanceof HTMLDialogElement) reviewDialog.close();
    });
  });
  reviewDialog?.addEventListener('click', (event) => {
    if (event.target === reviewDialog && reviewDialog instanceof HTMLDialogElement) reviewDialog.close();
  });
</script>
