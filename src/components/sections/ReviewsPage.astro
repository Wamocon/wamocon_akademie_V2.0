---
import type { Lang } from '../../i18n/config';
import LeadForm from './LeadForm.astro';
import ReviewModal from './ReviewModal.astro';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const copy = lang === 'de'
  ? {
      title: 'Was sagen unsere Teilnehmer?',
      intro: 'Unsere Teilnehmer berichten über ihre Erlebnisse und den Mehrwert, den sie von uns bezogen haben.',
      // Pflichtangabe nach § 5b Abs. 3 UWG: ob und wie die Echtheit von
      // Verbraucherbewertungen sichergestellt wird.
      authenticity: 'Hinweis zur Echtheit unserer Bewertungen: Alle hier veröffentlichten Bewertungen und Teilnehmerstimmen stammen von Personen, die das jeweilige Programm der WAMOCON Academy tatsächlich absolviert haben. Vor der Veröffentlichung gleichen wir jede Bewertung anhand unserer Teilnahmeunterlagen ab. Bewertungen werden weder gekauft noch gegen eine Gegenleistung eingeholt; wir veröffentlichen sie unverändert und unabhängig davon, ob sie positiv oder kritisch ausfallen.',
      sendEvaluation: 'Senden Sie Ihre Bewertung',
      storiesLabel: 'Erfolgsgeschichten',
      testimonialsLabel: 'Teilnehmerstimmen',
      challenge: 'Herausforderung', goal: 'Ziel', result: 'Ergebnis', onYouTube: 'auf YouTube ansehen', interview: 'im Interview',
      playVideo: 'Video abspielen', closeVideo: 'Video schließen',
      stories: [
        {
          name: 'Leon Christen', title: 'Leon Christen und sein Hindernis', videoId: '1u100i0b9LM',
          videoTitle: 'Leon und seine Erfahrung über die WMA und seine IT-Karriere',
          challenge: 'Leon konnte trotz unzähliger Bewerbungen keinen Arbeitsplatz finden. Unternehmen lehnten ihn ab, obwohl er einen hoch angesehenen Studiengang absolviert hatte.',
          goal: 'Das Ziel war ganz klar, Leon wollte in seiner IT-Karriere durchstarten.',
          result: ['Qualifizierter ISTQB® Certified Tester', 'Besseres Verständnis in seinem Projekt', 'Mehr Verantwortung im Unternehmen erhalten'],
        },
        {
          name: 'Christian-Oliver Friedrich', title: 'Christian-Oliver Friedrich und sein Hindernis', videoId: '-M1JD6mZVvY',
          videoTitle: 'Wie eine Entscheidung Christians ganzes Leben veränderte',
          challenge: 'Christian-Oliver wollte Praxiserfahrung über echte IT-Projekte sammeln. Jedoch ohne Praxiserfahrung und ISTQB® Tester Zertifikat ist es ihm nicht möglich.',
          goal: 'Sein Ziel ist es, als Testautomatisierer IT-Projekte durchführen zu können. Dafür muss Christian-Oliver jedoch zuerst das ISTQB® Tester Zertifikat erfolgreich abschließen.',
          result: ['Mit dem ersten Versuch das ISTQB® Zertifikat bestanden', 'Sein Einstieg ins IT-Projekt als Tester sicher gefunden', 'Sich weiterentwickelt mit ISTQB® Test Automation Engineer'],
        },
      ],
      graduates: [
        { name: 'Natalie', role: 'Teilnehmerin WAMOCON Academy', videoId: 'Y530fsyTCe4' },
        { name: 'Artur', role: 'Teilnehmer WAMOCON Academy', videoId: 'GIzxhk4tzmM' },
        { name: 'Alexander', role: 'Teilnehmer WAMOCON Academy', videoId: 'Nun-eNkeeY0' },
        { name: 'Olga', role: 'Teilnehmerin WAMOCON Academy', videoId: 'YI6Jf9-T3_c' },
        { name: 'Jonathan', role: 'Teilnehmer WAMOCON Academy', videoId: 'C6jFQwt6E0o' },
      ],
      adviceTitle: 'Beratung erhalten',
      adviceText: 'Rufen Sie uns an +49 (0) 6196 5838312, oder hinterlassen Sie unten Ihre Kontaktdaten, damit wir Sie erreichen und Ihre Fragen beantworten können.',
      name: 'Ihr Name', phone: 'Telefon', email: 'E-Mail', submit: 'Anfrage senden',
      consentPre: 'Hiermit bestätige ich, dass ich die ', consentLink: 'Datenschutzerklärung',
      consentPost: ' gelesen habe und damit einverstanden bin, dass die WAMOCON Academy GmbH meine Daten, einschließlich personenbezogener Daten, speichern und verarbeiten darf.',
    }
  : {
      title: 'What do our participants say?',
      intro: 'Our participants report on their experiences and the added value they have gained from us.',
      authenticity: 'How we ensure our reviews are genuine: every review and participant testimonial published here comes from a person who actually completed the relevant WAMOCON Academy programme. Before publication we verify each review against our participation records. Reviews are never bought or obtained in exchange for any benefit; we publish them unedited, whether they are positive or critical.',
      sendEvaluation: 'Send your evaluation',
      storiesLabel: 'Success stories',
      testimonialsLabel: 'Participant testimonials',
      challenge: 'The challenge', goal: 'Goal', result: 'Result', onYouTube: 'watch on YouTube', interview: 'in an interview',
      playVideo: 'Play video', closeVideo: 'Close video',
      stories: [
        {
          name: 'Leon Christen', title: 'Leon Christen and his obstacle', videoId: '1u100i0b9LM',
          videoTitle: 'Leon and his experience with WMA and his IT career',
          challenge: 'Despite countless applications, Leon was unable to find a job. Companies turned him down even though he had completed a highly regarded degree course.',
          goal: 'The goal was clear: Leon wanted to get his IT career off to a flying start.',
          result: ['Qualified ISTQB® Certified Tester', 'Better understanding of his project', 'Gained more responsibility within the company'],
        },
        {
          name: 'Christian-Oliver Friedrich', title: 'Christian-Oliver Friedrich and his obstacle', videoId: '-M1JD6mZVvY',
          videoTitle: "How one decision changed Christian's whole life",
          challenge: 'Christian-Oliver wanted to gain practical experience in real IT projects. However, without practical experience and an ISTQB® tester certificate, this is not possible for him.',
          goal: 'His goal is to be able to carry out IT projects as a test automation engineer. However, Christian-Oliver must first successfully complete the ISTQB® Tester certificate.',
          result: ['Passed the ISTQB® certificate on his first attempt', 'Found his way into IT projects as a tester', 'Developed further with ISTQB® Test Automation Engineer'],
        },
      ],
      graduates: [
        { name: 'Natalie', role: 'Participant WAMOCON Academy', videoId: 'Y530fsyTCe4' },
        { name: 'Artur', role: 'Participant WAMOCON Academy', videoId: 'GIzxhk4tzmM' },
        { name: 'Alexander', role: 'Participant WAMOCON Academy', videoId: 'Nun-eNkeeY0' },
        { name: 'Olga', role: 'Participant WAMOCON Academy', videoId: 'YI6Jf9-T3_c' },
        { name: 'Jonathan', role: 'Participant WAMOCON Academy', videoId: 'C6jFQwt6E0o' },
      ],
      adviceTitle: 'Get advice',
      adviceText: 'Give us a call +49 (0) 6196 5838312, or leave your contact details below so that we can reach you and answer your questions.',
      name: 'Name', phone: 'Phone', email: 'E-Mail', submit: 'Send request',
      consentPre: 'I hereby confirm that I have read the ', consentLink: 'privacy policy',
      consentPost: ' and agree that WAMOCON Academy GmbH may store and process my data, including personal data.',
    };

const stories = copy.stories;
const graduates = copy.graduates;

const storyPosters = [
  '/images/academy/story-leon.jpg',
  '/images/academy/story-christian.jpg',
];
const graduatePoster = (name: string) => `/images/academy/testimonial-${name.toLowerCase()}.jpg`;
---

<div class="reviews-page">
  <section class="reviews-hero">
    <div class="reviews-hero__inner container">
      <div class="reviews-hero__copy">
        <h1>{copy.title}</h1>
        <p>{copy.intro}</p>
        <p class="reviews-authenticity">{copy.authenticity}</p>
        <button class="reviews-button" type="button" data-review-open>{copy.sendEvaluation}</button>
      </div>
    </div>
    <img class="reviews-hero__shape reviews-hero__shape--small" src="/images/academy/tild3730-6132-4863-b462-623032303533__group_11.png" alt="" />
    <img class="reviews-hero__shape reviews-hero__shape--large" src="/images/academy/tild3730-6132-4863-b462-623032303533__group_11.png" alt="" />
  </section>

  <section class="stories" aria-label={copy.storiesLabel}>
    <div class="container stories__list">
      {stories.map((story, index) => (
        <article class="story">
          <div class="story__copy">
            <h2>{story.title}</h2>
            <dl>
              <div>
                <dt>{copy.challenge}</dt>
                <dd>{story.challenge}</dd>
              </div>
              <div>
                <dt>{copy.goal}</dt>
                <dd>{story.goal}</dd>
              </div>
              <div>
                <dt>{copy.result}</dt>
                <dd>{story.result.map((line) => <>{line}<br /></>)}</dd>
              </div>
            </dl>
          </div>
          <div class="video-preview video-preview--story" data-external-media>
            <iframe data-consent-src={`https://www.youtube-nocookie.com/embed/${story.videoId}?autoplay=1&controls=1&playsinline=1&rel=0`} data-consent-mode="manual" title={story.videoTitle} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen hidden></iframe>
            <div class="external-media__notice" data-external-media-notice>
              <img src={storyPosters[index]} alt={`${story.name} ${copy.interview}`} width="1920" height="1080" loading="lazy" />
              <span class="external-media__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
              <p>{lang === 'de' ? 'Dieses Video wird erst nach Ihrer Zustimmung von YouTube geladen.' : 'This video loads from YouTube only after your consent.'}</p>
              <button type="button" data-external-media-load>{lang === 'de' ? 'YouTube-Video laden' : 'Load YouTube video'}</button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="graduates" aria-label={copy.testimonialsLabel}>
    <div class="container graduates__grid">
      {graduates.map((graduate) => (
        <article class="graduate">
          <div class="video-preview video-preview--graduate" data-external-media>
            <iframe data-consent-src={`https://www.youtube-nocookie.com/embed/${graduate.videoId}?autoplay=1&controls=1&playsinline=1&rel=0`} data-consent-mode="manual" title={`${graduate.name}: ${copy.testimonialsLabel}`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen hidden></iframe>
            <div class="external-media__notice" data-external-media-notice>
              <img src={graduatePoster(graduate.name)} alt={`${graduate.name}, ${graduate.role}`} width="1280" height="720" loading="lazy" />
              <span class="external-media__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
              <p>{lang === 'de' ? 'Dieses Video wird erst nach Ihrer Zustimmung von YouTube geladen.' : 'This video loads from YouTube only after your consent.'}</p>
              <button type="button" data-external-media-load>{lang === 'de' ? 'YouTube-Video laden' : 'Load YouTube video'}</button>
            </div>
          </div>
          <h2>{graduate.name}</h2>
          <p>{graduate.role}</p>
        </article>
      ))}
    </div>
    <div class="container graduates__action">
      <button class="reviews-button" type="button" data-review-open>{copy.sendEvaluation}</button>
    </div>
  </section>

  <ReviewModal lang={lang} />

  <dialog class="reviews-video-dialog" data-reviews-video-dialog aria-label={copy.playVideo}>
    <button class="reviews-video-dialog__close" type="button" data-reviews-video-close aria-label={copy.closeVideo}>×</button>
    <iframe data-reviews-video-frame title={copy.playVideo} allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
  </dialog>
</div>

<style>
  .reviews-authenticity {
    max-width: 70ch;
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .reviews-page { background: #101010; color: #fff; }
  .reviews-hero { position: relative; overflow: hidden; padding-top: clamp(205px, 11vw, 225px); }
  .reviews-hero__inner { position: relative; z-index: 1; min-height: 520px; }
  .reviews-hero h1 { max-width: 980px; font-size: clamp(2.75rem, 3.5vw, 4.25rem); line-height: 1.12; }
  .reviews-hero p { max-width: 760px; margin-top: 1.5rem; font-size: clamp(1.05rem, 1.3vw, 1.25rem); line-height: 1.5; }
  .reviews-button { min-height: 64px; margin-top: 1.65rem; padding: 0 1.65rem; border-radius: 5px; background: var(--color-accent-surface); color: #fff; font-size: 1rem; font-weight: 600; transition: background 180ms, transform 180ms; }
  .reviews-button:hover { background: #df1911; transform: translateY(-2px); }
  .reviews-hero__shape { position: absolute; height: auto; pointer-events: none; filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.45)); }
  .reviews-hero__shape--small { top: 105px; right: clamp(-50px, 1.5vw, 30px); width: clamp(230px, 18vw, 360px); transform: rotate(250deg); animation: review-shape-small 8s ease-in-out infinite; }
  .reviews-hero__shape--large { top: 285px; right: clamp(110px, 12vw, 245px); width: clamp(340px, 25vw, 500px); transform: rotate(151deg); animation: review-shape-large 10s ease-in-out infinite; }

  .stories { padding-bottom: 5rem; }
  .stories__list { display: grid; gap: clamp(4rem, 7vw, 8rem); }
  .story { display: grid; grid-template-columns: minmax(320px, 1fr) minmax(0, 1fr); gap: clamp(3rem, 7vw, 8rem); align-items: center; }
  .story__copy { max-width: 720px; }
  .story h2 { margin-bottom: 1.75rem; font-size: clamp(1.2rem, 1.6vw, 1.55rem); line-height: 1.3; }
  .story dl { display: grid; gap: 1.35rem; font-size: clamp(1rem, 0.9vw, 1.125rem); line-height: 1.55; }
  .story dt { color: var(--color-accent); font-weight: 400; }
  .story dd { margin: 0; }

  .video-preview { position: relative; display: block; width: 100%; overflow: hidden; border: 0; background: #000; color: inherit; text-align: left; }
  .video-preview iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video-preview img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease-out), opacity 200ms; }
  .video-preview img:not([src]) { opacity: 0; }
  .video-preview:hover img { transform: scale(1.025); opacity: 0.88; }
  .video-preview--story { aspect-ratio: 16 / 9; }
  .video-preview--graduate { aspect-ratio: 16 / 9; background: #191919; }
  .video-preview__headline { position: absolute; top: 0.8rem; left: 5.8rem; right: 1rem; z-index: 1; overflow: hidden; color: #fff; font-size: clamp(0.8rem, 1.65vw, 1.25rem); font-weight: 700; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 2px 8px #000; }
  .video-preview__brand { position: absolute; top: 2.45rem; left: 5.8rem; z-index: 1; font-size: 0.82rem; font-weight: 600; text-shadow: 0 2px 8px #000; }
  .video-preview__hint { position: absolute; left: 0; right: 0; z-index: 2; padding: 9px 12px; color: #fff; font-size: 0.76rem; line-height: 1.3; text-align: center; pointer-events: none; }
  .video-preview--story .video-preview__hint { bottom: 0; padding-top: 28px; background: linear-gradient(transparent, rgba(0, 0, 0, 0.82)); }
  .video-preview--graduate .video-preview__hint { top: 0; padding-bottom: 26px; background: linear-gradient(rgba(0, 0, 0, 0.82), transparent); }
  .video-preview__play { position: absolute; top: 50%; left: 50%; width: 68px; color: #f03; transform: translate(-50%, -50%); transition: transform 180ms; }
  .video-preview:hover .video-preview__play { transform: translate(-50%, -50%) scale(1.08); }
  .video-preview__play svg { width: 100%; fill: currentColor; }
  .video-preview__play .video-preview__triangle { fill: #fff; }

  .graduates { padding: 2.5rem 0 clamp(6rem, 12vw, 10rem); }
  .graduates__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(2.5rem, 4vw, 4.5rem) clamp(1.5rem, 2.5vw, 2.75rem); }
  .graduate__caption { position: absolute; inset: auto 0 0; display: grid; min-height: 58px; align-content: center; padding: 0.5rem 1.25rem; background: #fff; color: #5b1717; text-transform: uppercase; }
  .graduate__caption strong { font-size: 1.0625rem; line-height: 1; }
  .graduate__caption small { color: #666; font-size: 0.875rem; font-weight: 400; text-transform: none; }
  .graduate h2 { margin-top: 1.25rem; font-size: 1.125rem; }
  .graduate p { margin-top: 0.5rem; font-size: 1.0625rem; }
  .graduates__action { margin-top: 2.4rem; }

  .reviews-video-dialog { width: min(1120px, calc(100vw - 32px)); margin: auto; padding: 48px 12px 12px; border: 1px solid rgba(255,255,255,.3); border-radius: 6px; background: #090909; color: #fff; box-shadow: 0 34px 100px rgba(0,0,0,.65); }
  .reviews-video-dialog::backdrop { background: rgba(0,0,0,.84); backdrop-filter: blur(5px); }
  .reviews-video-dialog iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .reviews-video-dialog__close { position: absolute; top: 6px; right: 10px; width: 40px; height: 40px; color: #fff; font-size: 28px; line-height: 1; }

  @keyframes review-shape-small {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(250deg); }
    50% { transform: translate3d(-14px, 16px, 0) rotate(258deg); }
  }

  @keyframes review-shape-large {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(151deg); }
    50% { transform: translate3d(14px, -12px, 0) rotate(144deg); }
  }

  @media (max-width: 820px) {
    .reviews-hero { padding-top: 118px; }
    .reviews-hero__inner { min-height: 300px; }
    .reviews-hero__shape { display: none; }
    .story { grid-template-columns: 1fr; gap: 1.5rem; }
    .graduates__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 2200px) {
    .story { grid-template-columns: minmax(420px, 0.62fr) minmax(0, 1.38fr); gap: clamp(100px, 9vw, 280px); }
    .graduates__grid { gap: clamp(56px, 3vw, 96px); }
  }

  /* Full-width hero. The copy sits just below the header instead of halfway
     down the artboard, so the space under the header is actually used (AK#13). */
  @media (min-width: 1200px) {
    .reviews-hero {
      width: 100%;
      min-height: 40vw;
      height: 40vw;
      padding-top: 0;
    }
    .reviews-hero__inner {
      width: 100%;
      max-width: none;
      min-height: 40vw;
      height: 40vw;
      padding: 0;
    }
    .reviews-hero__copy {
      position: absolute;
      top: 13vw;
      left: 1.6667vw;
      width: 48vw;
    }
    .reviews-hero h1 {
      max-width: 46vw;
      font-size: 3.5vw;
      line-height: 1.08;
    }
    .reviews-hero p {
      max-width: 44vw;
      margin-top: 1.3333vw;
      font-size: 1.4vw;
      line-height: 1.35;
    }
    .reviews-hero .reviews-button {
      min-width: 16.75vw;
      min-height: 4.25vw;
      margin-top: 2vw;
      padding-inline: 1.5vw;
      font-size: 1.15vw;
    }
    .reviews-hero__shape--small {
      top: 7.5vw;
      right: -1.5vw;
      width: 22vw;
    }
    .reviews-hero__shape--large {
      top: 16vw;
      right: 11vw;
      width: 32vw;
    }
  }

  @media (max-width: 520px) {
    .reviews-hero__inner { min-height: 328px; }
    .reviews-hero h1 { max-width: 340px; font-size: 1.9rem; }
    .reviews-hero p { margin-top: 0.8rem; font-size: 1rem; }
    .reviews-button { min-height: 55px; margin-top: 1rem; padding-inline: 1.5rem; }
    .stories__list { gap: 4rem; }
    .story h2 { margin-bottom: 1.4rem; font-size: 1rem; }
    .story dl { font-size: 0.95rem; line-height: 1.45; }
    .video-preview__headline { left: 4.25rem; font-size: 0.82rem; }
    .video-preview__brand { top: 2.2rem; left: 4.25rem; font-size: 0.75rem; }
    .graduates { padding-top: 4rem; }
    .graduates__grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .graduate h2 { margin-top: 0.85rem; }
    .graduate p { margin-top: 0.35rem; }
    .graduates__action { margin-top: 2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-hero__shape {
      animation: none;
    }
  }
</style>

<script>
  type ReviewsConsentWindow = Window & {
    wamoconConsent?: {
      hasExternalMedia?: () => boolean;
      open?: () => void;
      grantExternalMedia?: () => void;
    };
  };

  const videoDialog = document.querySelector<HTMLDialogElement>('[data-reviews-video-dialog]');
  const videoFrame = videoDialog?.querySelector<HTMLIFrameElement>('[data-reviews-video-frame]');
  let pendingReviewVideo: { id: string; title: string } | null = null;

  const stopReviewVideo = () => videoFrame?.removeAttribute('src');
  const playReviewVideo = (id: string, title: string) => {
    if (!videoDialog || !videoFrame) return;
    videoFrame.title = title;
    videoFrame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&controls=1&playsinline=1&rel=0`;
    if (!videoDialog.open) videoDialog.showModal();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-review-video-id]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.reviewVideoId;
      if (!id) return;
      const title = button.dataset.reviewVideoTitle || 'YouTube video';
      const consent = (window as ReviewsConsentWindow).wamoconConsent;
      if (consent?.hasExternalMedia?.()) {
        playReviewVideo(id, title);
        return;
      }
      if (consent?.grantExternalMedia) {
        consent.grantExternalMedia();
        playReviewVideo(id, title);
        return;
      }
      pendingReviewVideo = { id, title };
      consent?.open?.();
    });
  });

  videoDialog?.querySelector('[data-reviews-video-close]')?.addEventListener('click', () => videoDialog.close());
  videoDialog?.addEventListener('click', (event) => {
    if (event.target === videoDialog) videoDialog.close();
  });
  videoDialog?.addEventListener('close', stopReviewVideo);
  window.addEventListener('pagehide', stopReviewVideo);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && videoDialog?.open) videoDialog.close();
  });
  window.addEventListener('wamocon:consent', (event) => {
    const detail = (event as CustomEvent<{ externalMedia?: boolean }>).detail;
    if (detail?.externalMedia && pendingReviewVideo) {
      playReviewVideo(pendingReviewVideo.id, pendingReviewVideo.title);
    }
    if (!detail?.externalMedia && videoDialog?.open) videoDialog.close();
    pendingReviewVideo = null;
  });

  // Inline consent-gated videos (story + graduate cards): load the YouTube iframe on click.
  document.querySelectorAll<HTMLElement>('.video-preview[data-external-media]').forEach((media) => {
    const frame = media.querySelector<HTMLIFrameElement>('iframe[data-consent-src]');
    const notice = media.querySelector<HTMLElement>('[data-external-media-notice]');
    const loadButton = media.querySelector<HTMLButtonElement>('[data-external-media-load]');
    loadButton?.addEventListener('click', () => {
      const source = frame?.dataset.consentSrc;
      if (!frame || !source) return;
      (window as Window & { wamoconConsent?: { grantExternalMedia?: () => void } }).wamoconConsent?.grantExternalMedia?.();
      frame.src = source;
      frame.hidden = false;
      if (notice) notice.hidden = true;
    });
  });
</script>
