---
import { assets, pages, steps, testimonials } from '../../data/academy';
import type { Lang } from '../../i18n/config';
import Button from '../ui/Button.astro';
import CoursesGrid from './CoursesGrid.astro';
import LeadForm from './LeadForm.astro';

type PageKey = keyof typeof pages;

interface Props {
  lang: Lang;
  pageKey: PageKey | 'contact';
}

const { lang, pageKey } = Astro.props;
const isContact = pageKey === 'contact';
const page =
  isContact
    ? {
        image: assets.workspace,
        [lang]: {
          eyebrow: lang === 'de' ? 'Kontakt' : 'Contact us',
          title: lang === 'de' ? 'Kontakt' : 'Contact us',
          lead:
            lang === 'de'
              ? 'WAMOCON Academy GmbH in Eschborn. Rufen Sie uns an oder hinterlassen Sie Ihre Kontaktdaten.'
              : 'WAMOCON Academy GmbH in Eschborn. Give us a call or leave your contact details.',
          sections: [],
        },
      }
    : pages[pageKey];
const content = page[lang];
const showCourses = pageKey === 'courses';
const showSteps = pageKey === 'courses' || pageKey === 'booster' || pageKey === 'certification';
const showReviews = pageKey === 'reviews';
const showCertificate = pageKey === 'certification';
const showDitele = pageKey === 'ditele';
---

<section class="page-hero">
  <div class="page-hero__media">
    <img src={page.image} alt="" width="1600" height="900" loading="eager" />
  </div>
  <div class="page-hero__overlay"></div>
  <div class="page-hero__inner container" data-reveal>
    <span class="eyebrow">{content.eyebrow}</span>
    <h1>{content.title}</h1>
    <p>{content.lead}</p>
  </div>
</section>

{
  content.sections.length > 0 && (
    <section class="section surface-light page-content">
      <div class="container page-content__grid">
        {content.sections.map((section, index) => (
          <article class="content-block" data-reveal>
            <span class="content-block__number">{String(index + 1).padStart(2, '0')}</span>
            <h2>{section.title}</h2>
            <p>{section.text}</p>
            {section.items && (
              <ul>
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}

{
  showCourses && (
    <section class="section course-section">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{lang === 'de' ? 'Seminare im Überblick' : 'Seminars at a glance'}</span>
          <h2>{lang === 'de' ? 'Hauptkurse und Bildungsprogramme' : 'Main courses and educational programs'}</h2>
        </div>
        <CoursesGrid lang={lang} />
      </div>
    </section>
  )
}

{
  showSteps && (
    <section class="section steps-section">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{lang === 'de' ? 'Schritte zur Vorbereitung' : 'Preparation steps'}</span>
          <h2>{lang === 'de' ? 'Von der Bewerbung bis zum IT-Projekt' : 'From the application to the IT project'}</h2>
        </div>
        <ol class="steps-section__list">
          {steps[lang].map((step, index) => (
            <li data-reveal><span>{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  showCertificate && (
    <section class="section surface-light certificate-section">
      <div class="container certificate-section__grid">
        <div data-reveal>
          <span class="eyebrow">ISTQB®</span>
          <h2>{lang === 'de' ? 'Accredited Training Provider' : 'Accredited Training Provider'}</h2>
          <p>
            {lang === 'de'
              ? 'WAMOCON Academy GmbH ist als Accredited Training Provider für ISTQB® Certified Tester Training Courses anerkannt.'
              : 'WAMOCON Academy GmbH is recognized as an Accredited Training Provider for ISTQB® Certified Tester Training Courses.'}
          </p>
        </div>
        <img src={assets.certificate} alt="ISTQB Accredited Training Provider" width="960" height="1358" loading="lazy" data-reveal />
      </div>
    </section>
  )
}

{
  showDitele && (
    <section class="section app-section surface-light">
      <div class="container app-section__grid">
        <img src={lang === 'de' ? assets.ditele : assets.appEn} alt="DiTeLe App" width="980" height="680" loading="lazy" data-reveal />
        <div data-reveal>
          <span class="eyebrow">DiTeLe</span>
          <h2>{lang === 'de' ? 'Digitale Test- und Lernumgebung' : 'Digital testing and learning environment'}</h2>
          <p>
            {lang === 'de'
              ? 'Die App macht Training, Übung und Projektpraxis sichtbar und verbindet Lernfortschritt mit realistischen Testing-Aufgaben.'
              : 'The app makes training, exercises and project practice visible and connects learning progress with realistic testing tasks.'}
          </p>
        </div>
      </div>
    </section>
  )
}

{
  showReviews && (
    <section class="section reviews-section surface-light">
      <div class="container">
        <div class="reviews-section__grid">
          {testimonials.map((item) => (
            <article class="review-card" data-reveal>
              <div class="review-card__stars" aria-hidden="true">★★★★★</div>
              <p>{item.text[lang]}</p>
              <strong>{item.name}</strong>
              <span>{item.role[lang]}</span>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  isContact ? (
    <LeadForm lang={lang} type="lead" compact />
  ) : (
    <section class="section cta-strip">
      <div class="container cta-strip__inner" data-reveal>
        <div>
          <span class="eyebrow">{lang === 'de' ? 'Beratung' : 'Advice'}</span>
          <h2>{lang === 'de' ? 'Starten Sie Ihre Erfolgsgeschichte mit der WAMOCON Academy' : 'Start your success story with the WAMOCON Academy'}</h2>
        </div>
        <Button href="#beratung">{lang === 'de' ? 'Beratung erhalten' : 'Receive advice'}</Button>
      </div>
    </section>
  )
}

{!isContact && <LeadForm lang={lang} type={pageKey} compact />}

<style>
  .page-hero {
    position: relative;
    min-height: 520px;
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .page-hero__media,
  .page-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__overlay {
    background:
      linear-gradient(90deg, rgba(7, 10, 18, 0.88), rgba(7, 10, 18, 0.42)),
      linear-gradient(0deg, rgba(15, 17, 21, 0.98), rgba(15, 17, 21, 0) 55%);
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(5rem, 10vw, 8rem) clamp(3rem, 7vw, 5rem);
  }

  .page-hero h1 {
    max-width: 880px;
    margin: 1rem 0;
  }

  .page-hero p {
    max-width: 760px;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .page-content__grid {
    display: grid;
    gap: 1rem;
  }

  .content-block {
    position: relative;
    display: grid;
    grid-template-columns: 80px 0.9fr 1.1fr;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    padding: clamp(1.25rem, 3vw, 2rem) 0;
    border-bottom: 1px solid var(--color-line-dark);
  }

  .content-block__number {
    color: var(--color-accent);
    font-size: 2.2rem;
    font-weight: var(--fw-bold);
    line-height: 1;
  }

  .content-block p {
    color: var(--color-muted-dark);
  }

  .content-block ul {
    display: grid;
    grid-column: 3;
    gap: 0.55rem;
    color: var(--color-muted-dark);
  }

  .content-block li {
    position: relative;
    padding-left: 1.2rem;
  }

  .content-block li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .section-head {
    max-width: 820px;
    margin-bottom: 2rem;
  }

  .section-head h2,
  .certificate-section h2,
  .app-section h2,
  .cta-strip h2 {
    margin-top: 0.8rem;
  }

  .steps-section__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .steps-section__list li {
    min-height: 138px;
    padding: 1.2rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06);
  }

  .steps-section__list span {
    display: block;
    color: var(--color-accent);
    font-size: 2rem;
    font-weight: var(--fw-bold);
    line-height: 1;
    margin-bottom: 0.8rem;
  }

  .certificate-section__grid,
  .app-section__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .certificate-section img,
  .app-section img {
    width: 100%;
    max-height: 720px;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .certificate-section p,
  .app-section p {
    margin-top: 1rem;
    color: var(--color-muted-dark);
  }

  .reviews-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }

  .review-card {
    display: grid;
    gap: 0.75rem;
    padding: 1.2rem;
    border: 1px solid var(--color-line-dark);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-card);
  }

  .review-card__stars {
    color: #f5a400;
  }

  .review-card p,
  .review-card span {
    color: var(--color-muted-dark);
  }

  .cta-strip {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .cta-strip__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 900px) {
    .content-block,
    .certificate-section__grid,
    .app-section__grid {
      grid-template-columns: 1fr;
    }

    .content-block ul {
      grid-column: auto;
    }

    .steps-section__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cta-strip__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 620px) {
    .steps-section__list {
      grid-template-columns: 1fr;
    }
  }
</style>
