---
import { legal } from '../../data/academy';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
  kind: keyof typeof legal;
}

const { lang, kind } = Astro.props;
const page = legal[kind][lang];
---

<section class="legal-page">
  <div class="container legal-page__inner">
    <span class="eyebrow">{page.title}</span>
    <h1>{page.title}</h1>
    <div class="legal-page__blocks">
      {
        page.blocks.map((block) => (
          <article>
            {block.split('\n').map((line, index) => index === 0 ? <h2>{line}</h2> : <p>{line}</p>)}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Dark theme like the rest of the site — the header logo and links are white,
     so a light background left them invisible (review AK#23). */
  .legal-page {
    min-height: 70vh;
    /* Top padding clears the fixed header (up to 180px on desktop). */
    padding-top: clamp(7rem, 15vw, 12rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .legal-page__inner {
    max-width: var(--container-max);
  }

  .legal-page h1 {
    margin: 1rem 0 2rem;
    color: var(--color-text);
  }

  .legal-page__blocks {
    display: grid;
    gap: 1.25rem;
    max-width: 1100px;
  }

  .legal-page article {
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }

  .legal-page h2 {
    margin-bottom: 0.7rem;
    color: var(--color-text);
    font-size: clamp(1.2rem, 2.3vw, 1.6rem);
  }

  .legal-page p {
    color: var(--color-muted);
    white-space: pre-line;
  }

  .legal-page a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
