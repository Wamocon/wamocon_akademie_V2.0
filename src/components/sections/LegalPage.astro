---
import { legal } from '../../data/academy';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
  kind: keyof typeof legal;
}

const { lang, kind } = Astro.props;
const page = legal[kind][lang];
// Courtesy translations carry a precedence notice pointing at the binding
// German original; the German and English pages have none.
const notice = 'notice' in page ? (page.notice as { text: string; linkLabel: string; href: string }) : null;
---

<section class="legal-page">
  <div class="container legal-page__inner">
    <h1>{page.title}</h1>
    {notice && (
      <aside class="legal-page__notice" role="note">
        <p>
          {notice.text}{' '}
          <a href={notice.href} hreflang="de" lang="de">{notice.linkLabel}</a>
        </p>
      </aside>
    )}
    <div class="legal-page__blocks">
      {
        page.blocks.map((block) => (
          <article>
            {block.split('\n').map((line, index) => index === 0 ? <h2>{line}</h2> : <p>{line}</p>)}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Dark theme like the rest of the site — the header logo and links are white,
     so a light background left them invisible (review AK#23). */
  .legal-page {
    min-height: 70vh;
    /* Same opening line as every other page — the hero token owns the offset
       that clears the fixed header. */
    padding-top: var(--hero-pad-top);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .legal-page__inner {
    max-width: var(--container-max);
  }

  .legal-page h1 {
    margin: 0 0 2rem;
    color: var(--color-text);
  }

  .legal-page__blocks {
    display: grid;
    gap: 1.25rem;
    /* A ch-based cap, not 1100px. Statutory text set 1100px wide runs ~130
       characters per line, roughly double a comfortable measure. */
    max-width: 78ch;
  }

  /* Precedence notice on courtesy translations of the binding German text. */
  .legal-page__notice {
    max-width: 1100px;
    margin-bottom: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(255, 11, 0, 0.38);
    border-left-width: 4px;
    border-radius: var(--radius-md);
    background: rgba(255, 11, 0, 0.07);
  }

  .legal-page__notice p {
    margin: 0;
    color: var(--color-text);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  .legal-page article {
    /* Grid items default to min-width: auto, so a long token (an e-mail address
       or a German authority name) sets the card's floor width and pushes it off
       a narrow screen. min-width: 0 lets it shrink and wrap instead. */
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }

  .legal-page h2 {
    margin-bottom: 0.7rem;
    color: var(--color-text);
    font-size: var(--fs-h4);
  }

  .legal-page p {
    color: var(--color-muted);
    white-space: pre-line;
    /* Statutory names, e-mail addresses and German compounds are long single
       tokens that otherwise push the card past a narrow viewport. */
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .legal-page h2 {
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .legal-page a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
