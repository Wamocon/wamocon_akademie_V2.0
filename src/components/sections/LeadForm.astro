---
import { assets } from '../../data/academy';
import { legalNav, ui, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
  type?: string;
  compact?: boolean;
  title?: string;
  image?: string;
  intro?: string;
  complianceMode?: boolean;
}

const { lang, type = 'lead', compact = false, title, image = assets.consultation, intro, complianceMode = false } = Astro.props;
const t = (key: keyof (typeof ui)['de']) => ui[lang][key];
const redirect = lang === 'de' ? '/danke/' : '/thanks/';
const privacyHref = legalNav.privacy[lang].href;
const displayTitle = title ?? t('form.title');
const privacyNotice = lang === 'de'
  ? 'Mit dem Absenden senden Sie eine unverbindliche Anfrage an die WAMOCON Academy GmbH. Wir verwenden Ihre Angaben nur zur Beantwortung Ihrer Anfrage. Weitere Informationen finden Sie in der '
  : 'By submitting, you send a non-binding inquiry to WAMOCON Academy GmbH. We use your details only to answer your inquiry. More information is available in the ';
---

<section class:list={['lead-section', { 'lead-section--compact': compact }]} id="beratung">
  <div class="container lead-section__grid">
    <div class="lead-section__image" data-reveal>
      <img src={image} alt={lang === 'de' ? 'Persönliche Beratung bei der WAMOCON Academy' : 'Personal consultation at WAMOCON Academy'} width="1600" height="900" loading="lazy" />
    </div>

    <img class="lead-section__curve lead-section__curve--top" src={assets.accentCurve} alt="" width="2228" height="1724" aria-hidden="true" loading="lazy" />
    <img class="lead-section__curve lead-section__curve--bottom" src={assets.accentCurve} alt="" width="2228" height="1724" aria-hidden="true" loading="lazy" />

    <form class:list={['lead-form js-lead-form', { 'lead-form--compliance': complianceMode }]} data-redirect={redirect} data-reveal>
      <h2>{displayTitle}</h2>
      <p class="lead-form__intro">{intro ?? t('form.text')}</p>
      <input type="hidden" name="type" value={type} />
      <input type="hidden" name="lang" value={lang} />
      <input class="lead-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
      <label>
        <span>{t('form.name')}</span>
        <input type="text" name="name" placeholder={t('form.name')} autocomplete="name" required />
      </label>
      <label>
        <span>{t('form.phone')}</span>
        <input type="tel" name="phone" placeholder={t('form.phone')} autocomplete="tel" aria-describedby="lead-contact-hint" />
      </label>
      <label>
        <span>{t('form.email')}</span>
        <input type="email" name="email" placeholder={t('form.email')} autocomplete="email" required aria-describedby="lead-contact-hint" />
      </label>
      <p id="lead-contact-hint" class="lead-form__consent">
        <span>
          {complianceMode ? privacyNotice : t('form.consent.pre')}
          <a href={privacyHref}>{t('form.consent.link')}</a>
          {complianceMode ? '.' : t('form.consent.post')}
        </span>
      </p>
      <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
      <button type="submit" class="lead-form__submit">{t('form.submit')}</button>
    </form>
  </div>
</section>

<style>
  .lead-section {
    padding-block: 100px;
    background: #101010;
  }

  .lead-section--compact {
    padding-block: 80px;
  }

  .lead-section__grid {
    position: relative;
    display: grid;
    width: min(calc(100% - 40px), 1440px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 3vw, 52px);
    align-items: stretch;
    min-height: 460px;
    margin-inline: auto;
    padding: 32px;
    overflow: hidden;
    background: #303030;
  }

  .lead-section__image {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 396px;
    overflow: hidden;
  }

  .lead-section__image img {
    width: 100%;
    height: 100%;
    min-height: 396px;
    object-fit: cover;
    object-position: center;
  }

  .lead-section__curve {
    position: absolute;
    z-index: 2;
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.4));
  }

  .lead-section__curve--top {
    top: -4px;
    left: -12px;
    width: 146px;
    transform: rotate(274deg);
  }

  .lead-section__curve--bottom {
    bottom: -18px;
    left: calc(50% - 86px);
    width: 127px;
    transform: rotate(151deg);
  }

  .lead-form__intro {
    margin-bottom: 10px;
    color: #fff;
    font-size: clamp(1rem, 1.15vw, 1.16rem);
    line-height: 1.5;
  }

  .lead-form h2 {
    margin-bottom: 12px;
    color: #fff;
    font-size: clamp(2.4rem, 3.6vw, 3.65rem);
  }

  .lead-form {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    gap: 12px;
    min-width: 0;
    padding: 0 18px 0 0;
    background: transparent;
  }

  .lead-form label {
    display: grid;
    gap: 6px;
    color: #fff;
    font-size: 15px;
    line-height: 1.3;
  }

  .lead-form--compliance label {
    gap: 6px;
    font-size: 15px;
    line-height: 1.3;
  }

  .lead-form--compliance label span {
    color: #fff;
  }

  .lead-form input {
    width: 100%;
    min-height: 52px;
    border: 0;
    border-radius: 0;
    background: #fff;
    color: var(--color-text-dark);
    padding: 0 18px;
    font-size: 16px;
  }

  .lead-form__trap {
    position: absolute;
    left: -9999px;
  }

  .lead-form__consent {
    display: flex !important;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: flex-start;
    color: #a3a3a3;
    font-size: 14px;
    line-height: 1.5;
  }

  .lead-form__consent a {
    color: #a3a3a3;
    text-decoration: underline;
  }

  .lead-form__submit {
    width: 215px;
    min-height: 54px;
    margin-top: 3px;
    border-radius: 5px;
    background: var(--color-accent-surface);
    color: #fff;
    font-size: 16px;
    font-weight: var(--fw-semibold);
    box-shadow: none;
    transition: background var(--dur-fast), transform var(--dur-fast);
  }

  .lead-form__status {
    margin: 0;
    color: #ff9b96;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .cf-turnstile {
    width: 100%;
    min-height: 65px;
    overflow: hidden;
  }

  @media (max-width: 479px) {
    .cf-turnstile { min-height: 140px; }
  }

  .lead-form__submit:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .lead-form__submit:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  @media (max-width: 820px) {
    .lead-section__grid {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 32px;
    }
    .lead-section { padding-block: 70px; }
    .lead-section__image,
    .lead-section__image img { min-height: 280px; }
    .lead-form { padding: 0; }
    .lead-form__submit { width: 100%; }
    .lead-section__curve--bottom { left: auto; right: -34px; bottom: 220px; }
  }

  @media (max-width: 620px) {
    .lead-section__grid {
      min-height: 660px;
      gap: 22px;
      padding: 28px 18px 0;
    }

    .lead-form { order: 1; }
    .lead-section__image { order: 2; min-height: 165px; margin-inline: -18px; }
    .lead-section__image img { min-height: 165px; max-height: 190px; object-position: center 38%; }
    .lead-section__curve--top { top: auto; right: 2px; bottom: 150px; left: auto; width: 82px; transform: rotate(240deg); }
    .lead-section__curve--bottom { right: -26px; bottom: 14px; width: 92px; }
  }
</style>
