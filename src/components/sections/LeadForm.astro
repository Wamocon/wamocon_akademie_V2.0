---
import { company, legalNav, ui, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
  type?: string;
  compact?: boolean;
}

const { lang, type = 'lead', compact = false } = Astro.props;
const t = (key: keyof (typeof ui)['de']) => ui[lang][key];
const redirect = lang === 'de' ? '/danke/' : '/thanks/';
const privacyHref = legalNav.privacy[lang].href;
---

<section class:list={['lead-section', { 'lead-section--compact': compact }]} id="beratung">
  <div class="container lead-section__grid">
    <div class="lead-section__copy" data-reveal>
      <span class="eyebrow">{t('form.title')}</span>
      <h2>{t('form.title')}</h2>
      <p>{t('form.text')}</p>
      <a href={company.phoneHref}>{company.phone}</a>
    </div>

    <form class="lead-form js-lead-form" data-redirect={redirect} data-reveal>
      <input type="hidden" name="type" value={type} />
      <input type="hidden" name="lang" value={lang} />
      <input class="lead-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
      <label>
        <span>{t('form.name')}</span>
        <input type="text" name="name" placeholder={t('form.name')} required />
      </label>
      <label>
        <span>{t('form.phone')}</span>
        <input type="tel" name="phone" placeholder={t('form.phone')} required />
      </label>
      <label>
        <span>{t('form.email')}</span>
        <input type="email" name="email" placeholder={t('form.email')} required />
      </label>
      <label>
        <span>{t('form.message')}</span>
        <textarea name="comment" rows="4" placeholder={t('form.message')}></textarea>
      </label>
      <label class="lead-form__consent">
        <input type="checkbox" name="consent" required />
        <span>{t('form.consent.pre')}<a href={privacyHref}>{t('form.consent.link')}</a>{t('form.consent.post')}</span>
      </label>
      <button type="submit" class="lead-form__submit">{t('form.submit')}</button>
    </form>
  </div>
</section>

<style>
  .lead-section {
    padding-block: var(--section-gap);
    background:
      linear-gradient(135deg, rgba(29, 79, 145, 0.18), rgba(227, 27, 35, 0.08)),
      var(--color-bg-soft);
  }

  .lead-section--compact {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .lead-section__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .lead-section__copy h2 {
    margin: 0.8rem 0 1rem;
  }

  .lead-section__copy p {
    max-width: 54ch;
    color: var(--color-muted);
  }

  .lead-section__copy a {
    display: inline-flex;
    margin-top: 1.35rem;
    color: #fff;
    font-weight: var(--fw-semibold);
  }

  .lead-form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06);
  }

  .lead-form label {
    display: grid;
    gap: 0.45rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .lead-form input,
  .lead-form textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-text-dark);
    padding: 0.9rem 1rem;
  }

  .lead-form textarea {
    resize: vertical;
  }

  .lead-form__trap {
    position: absolute;
    left: -9999px;
  }

  .lead-form__consent {
    display: flex !important;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .lead-form__consent input {
    width: auto;
    margin-top: 0.18rem;
    accent-color: var(--color-accent);
  }

  .lead-form__consent a {
    color: #fff;
    text-decoration: underline;
  }

  .lead-form__submit {
    min-height: 50px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: #fff;
    font-weight: var(--fw-semibold);
    box-shadow: var(--shadow-accent);
    transition: background var(--dur-fast), transform var(--dur-fast);
  }

  .lead-form__submit:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .lead-form__submit:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  @media (max-width: 820px) {
    .lead-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
