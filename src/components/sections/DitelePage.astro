---
import type { Lang } from '../../i18n/config';
import { pick } from '../../i18n/utils';
import VideoEmbed from '../ui/VideoEmbed.astro';
import LeadForm from './LeadForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const image = (name: string) => `/images/academy/${name}`;
const assets = {
  disc: image('tild6130-3637-4836-a562-333834303031__jn.png'),
  sphere: image('tild3463-3139-4333-b833-303632623566__vdva.png'),
  curve: image('tild3730-6132-4863-b462-623032303533__group_11.png'),
  classroom: image('tild3034-3664-4337-b734-326139353235__young-programmer-is-.jpg'),
};

const copy = pick(lang, {
  de: {
      hero: 'Die WAMOCON Academy bietet mit ihrer digitalen Lernplattform DiTeLe eine innovative Möglichkeit, umfassende Kurse bequem und effektiv zu absolvieren. Diese Plattform wurde speziell entwickelt, um das Lernen zu einem interaktiven und praxisorientierten Erlebnis zu machen.',
      testTitle: 'Überprüfe dein Wissen mit uns!',
      testText: 'Die Benutzerregistrierung im Online-Shop ist entscheidend für zukünftige Interaktionen. Sie umfasst mehr als nur das Ausfüllen eines Formulars. Es geht um die Erstellung eines Kontos für personalisierte Nutzungserlebnisse. Bereiten wir uns gemeinsam auf die Testvorbereitung vor!',
      testButton: 'Den Test fortsetzen',
      platformTitle: 'Über unsere Academy-Lernplattform',
      platformIntro: 'Unsere Kurse sind in übersichtliche Kapitel und Lernmodule unterteilt. Jedes Modul ist darauf ausgelegt, Ihnen praxisnahes Wissen zu vermitteln und Ihre Fähigkeiten kontinuierlich zu verbessern.',
      platformItems: [
        ['Erklärende Videos', 'Verständlich aufbereitete Videos führen Sie Schritt für Schritt durch die Lerninhalte.'],
        ['Szenarien und Beispiele', 'Realitätsnahe Szenarien und anschauliche Beispiele helfen Ihnen, das Gelernte in die Praxis umzusetzen.'],
        ['Übungen und praxisorientierte Fragen', 'Interaktive Übungen und Fragen ermöglichen es Ihnen, Ihr Wissen zu testen und zu festigen.'],
      ],
      platformOutro: 'Mit DiTeLe App lernen Sie nicht nur theoretisches Wissen, sondern auch dessen praktische Anwendung. Unsere Plattform ist darauf ausgelegt, Sie optimal auf Ihre beruflichen Herausforderungen vorzubereiten und Ihnen einen echten Mehrwert zu bieten.',
      whyTitle: 'Warum DiTeLe App?',
      whyItems: [
        ['Flexibilität', 'Lernen Sie wann und wo Sie wollen, ganz nach Ihrem eigenen Tempo.'],
        ['Praxisnähe', 'Unsere praxisorientierten Inhalte garantieren, dass Sie das Gelernte sofort anwenden können.'],
        ['Interaktivität', 'Durch interaktive Module bleibt das Lernen spannend und abwechslungsreich.'],
      ],
      whyOutro: 'Nutzen Sie die Chance, Ihre beruflichen Fähigkeiten mit DiTeLe App auf das nächste Level zu heben. Melden Sie sich noch heute an und starten Sie Ihre Weiterbildung mit der WAMOCON Academy!',
      togetherTitle: 'Gemeinsam mit der Academy können Sie',
      togetherItems: [
        'Erstklassige Vorlesungen von Praktikern der IT-Industrie studieren',
        'Einzigartige Informationen über Softwaretests in der Praxis mit Hilfe des eigenen Systems DiTeLe App erlernen',
        'Erfahrungen mit Gleichgesinnten austauschen',
        'Direkte Antworten von Experten erhalten',
      ],
      togetherOutro: 'Sie können Kurse auf der Plattform in Kombination mit Live-Unterricht erhalten. Unsere Kurse, insbesondere die Präsenzkurse, bieten Ihnen eine einzigartige Gelegenheit, sich intensiv weiterzubilden und von der Interaktion mit anderen Teilnehmern zu profitieren.',
      advantagesTitle: 'Vorteile der Präsenzkurse',
      advantages: [
        ['Austausch mit anderen Teilnehmern', 'Nutzen Sie die Möglichkeit, sich mit Gleichgesinnten auszutauschen und wertvolle Kontakte zu knüpfen.'],
        ['Ideen teilen und Fragen stellen', 'Bringen Sie Ihre eigenen Ideen ein und stellen Sie Fragen, um ein tieferes Verständnis der Themen zu erlangen.'],
        ['Praktische Ratschläge und Lösungen', 'Erhalten Sie praxisnahe Ratschläge und Lösungen, die genau auf Ihre Bedürfnisse zugeschnitten sind.'],
        ['Qualifikation der Dozenten', 'Unsere Dozenten bringen tiefgehende praktische Projekterfahrungen mit, die sie in den Kursen anschaulich und verständlich vermitteln. So profitieren Sie von ihrem umfangreichen Wissen und ihrer Expertise.'],
      ],
      adviceTitle: 'Beratung erhalten',
      adviceText: 'Rufen Sie uns an +49 (0) 6196 5838312, oder hinterlassen Sie unten Ihre Kontaktdaten, damit wir Sie erreichen und Ihre Fragen beantworten können.',
      name: 'Ihr Name',
      phone: 'Telefon',
      email: 'E-Mail',
      send: 'Anfrage senden',
      consentPrefix: 'Optional: Hiermit bestätige ich, dass ich die ',
      consentLink: 'Datenschutzerklärung',
      consentSuffix: ' gelesen habe und damit einverstanden bin, dass die WAMOCON Academy GmbH meine Daten, einschließlich personenbezogener Daten, speichern und verarbeiten darf.',
      videoTitle: 'Ein Softwaretester in der Praxis bei der WAMOCON Academy',
      videoConsentTitle: 'YouTube-Video',
      videoConsentText: 'Mit dem Laden des Videos stimmen Sie einer Verbindung zu YouTube und der Übertragung Ihrer IP-Adresse zu.',
      videoConsentButton: 'YouTube-Video laden',
      closeVideo: 'Video schließen',
      liveBadge: 'Live-Demo',
      liveDemo: 'Live-Demo: DiTeLe Praxisübung',
      questionCount: 'Frage 1 von 300+',
      question: 'Was ist der Hauptzweck des Softwaretestens?',
      quizHint: 'Das ist Übung 1 von 45+ in DiTeLe. Mit DiTeLe lernst du nicht nur über Softwaretesten – du machst Softwaretesten.',
      quizCta: 'Alle Übungen in DiTeLe freischalten',
      discover: 'Ditele entdecken',
      developerAlt: 'Softwareentwickler bei der Arbeit am Computer',
    },
  en: {
      hero: 'With its digital learning platform DiTeLe, the WAMOCON Academy offers an innovative way of completing comprehensive courses conveniently and effectively. This platform has been specially developed to make learning an interactive and practice-oriented experience.',
      testTitle: 'Test your knowledge with us!',
      testText: "User registration in the online store is crucial for future interactions. It involves more than just filling out a form. It's about creating an account for personalized user experiences. Let's prepare for the test together!",
      testButton: 'Continue the test',
      platformTitle: 'About our Academy learning platform',
      platformIntro: 'Our courses are divided into clear chapters and learning modules. Each module is designed to provide you with practical knowledge and continuously improve your skills.',
      platformItems: [
        ['Explanatory videos', 'Clearly prepared videos guide you step by step through the learning content.'],
        ['Scenarios and examples', 'Realistic scenarios and illustrative examples help you to put what you have learned into practice.'],
        ['Exercises and practice-oriented questions', 'Interactive exercises and questions allow you to test and consolidate your knowledge.'],
      ],
      platformOutro: 'With DiTeLe App, you not only learn theoretical knowledge, but also its practical application. Our platform is designed to optimally prepare you for your professional challenges and offer you real added value.',
      whyTitle: 'Why DiTeLe App?',
      whyItems: [
        ['Flexibility', 'Learn when and where you want, at your own pace.'],
        ['Practical relevance', 'Our practice-oriented content guarantees that you can apply what you have learned immediately.'],
        ['Interactivity', 'Interactive modules keep learning exciting and varied.'],
      ],
      whyOutro: 'Take the opportunity to take your professional skills with DiTeLe App to the next level. Sign up today and start your further education with the WAMOCON Academy!',
      togetherTitle: 'Together with the Academy you can',
      togetherItems: [
        'First-class lectures from practitioners in the IT industry',
        'Learn unique information about software testing in practice with the help of our own system DiTeLe App',
        'Exchange experiences with like-minded people',
        'Get direct answers from experts',
      ],
      togetherOutro: 'You can receive courses on the platform in combination with live lessons. Our courses, especially the face-to-face courses, offer you a unique opportunity for intensive further training and to benefit from interaction with other participants.',
      advantagesTitle: 'Advantages of classroom courses',
      advantages: [
        ['Exchange with other participants', 'Take the opportunity to exchange ideas with like-minded people and make valuable contacts.'],
        ['Share ideas and ask questions', 'Contribute your own ideas and ask questions to gain a deeper understanding of the topics.'],
        ['Practical advice and solutions', 'Get practical advice and solutions tailored to your needs.'],
        ['Qualifications of the lecturers', 'Our lecturers have in-depth practical project experience, which they convey clearly and comprehensibly in the courses. This allows you to benefit from their extensive knowledge and expertise.'],
      ],
      adviceTitle: 'Get advice',
      adviceText: 'Give us a call +49 (0) 6196 5838312, or leave your contact details below so that we can reach you and answer your questions.',
      name: 'Your name',
      phone: 'Telephone',
      email: 'E-Mail',
      send: 'Send request',
      consentPrefix: 'Optional: I hereby confirm that I have read the ',
      consentLink: 'privacy policy',
      consentSuffix: ' and agree that WAMOCON Academy GmbH may store and process my data, including personal data.',
      videoTitle: 'A software tester in practice at WAMOCON Academy',
      videoConsentTitle: 'YouTube video',
      videoConsentText: 'By loading the video, you consent to a connection to YouTube and the transfer of your IP address.',
      videoConsentButton: 'Load YouTube video',
      closeVideo: 'Close video',
      liveBadge: 'Live demo',
      liveDemo: 'Live demo: DiTeLe practice exercise',
      questionCount: 'Question 1 of 300+',
      question: 'What is the main purpose of software testing?',
      quizHint: 'This is exercise 1 of 45+ in DiTeLe. With DiTeLe you don’t just learn about software testing – you do it.',
      quizCta: 'Unlock all exercises in DiTeLe',
      discover: 'Discover DiTeLe',
      developerAlt: 'Software developer working at a computer',
    },
});

---

<section class="page-hero ditele-hero" aria-labelledby="ditele-title">
  <div class="ditele-hero__media page-hero__art" aria-hidden="true">
    <img class="ditele-hero__disc" src={assets.disc} alt="" width="980" height="980" />
    <img class="ditele-hero__sphere" src={assets.sphere} alt="" width="980" height="980" />
  </div>
  <div class="container ditele-hero__content page-hero__inner" data-reveal>
    <div class="ditele-hero__copy page-hero__copy">
      <h1 id="ditele-title">DiTeLe App</h1>
      <p>{copy.hero}</p>
      <a class="ditele-discover" href="https://onlinekurs.test-it-academy.com/" target="_blank" rel="noopener noreferrer">
        {copy.discover} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<section class="ditele-section ditele-test" aria-labelledby="ditele-test-title">
  <div class="container ditele-test__grid">
    <VideoEmbed
      class="ditele-test__video"
      videoId="FQ8dXuBDzb0"
      title={copy.videoTitle}
      poster={assets.classroom}
      lang={lang}
    />
    <div class="ditele-test__content" data-reveal>
      <span class="ditele-test__badge ditele-test__badge--live">{copy.liveBadge}</span>
      <h2 id="ditele-test-title">{copy.testTitle}</h2>
      <p>{copy.testText}</p>

      <div class="ditele-quiz" data-ditele-quiz>
        <div class="ditele-quiz__top">
          <span class="ditele-quiz__live"><span class="ditele-quiz__dot" aria-hidden="true"></span>{copy.liveDemo}</span>
          <span class="ditele-quiz__count">{copy.questionCount}</span>
        </div>
        <h3 class="ditele-quiz__q">{copy.question}</h3>
        <ul class="ditele-quiz__options">
          {[
            { k: 'A', de: 'Fehler finden', en: 'Find defects', correct: false },
            { k: 'B', de: 'Qualität bewerten', en: 'Assess quality', correct: false },
            { k: 'C', de: 'Anforderungen validieren', en: 'Validate requirements', correct: false },
            { k: 'D', de: 'Alle oben genannten', en: 'All of the above', correct: true },
          ].map((o) => (
            <li>
              <button type="button" class="ditele-quiz__option" data-quiz-option data-correct={String(o.correct)}>
                <span class="ditele-quiz__key">{o.k}</span>
                <span>{o[lang]}</span>
              </button>
            </li>
          ))}
        </ul>
        <p class="ditele-quiz__feedback" data-quiz-feedback hidden></p>
        <p class="ditele-quiz__hint">{copy.quizHint}</p>
        <a class="ditele-quiz__cta" href="https://onlinekurs.test-it-academy.com/#preise" target="_blank" rel="noopener noreferrer">
          {copy.quizCta}
        </a>
      </div>
    </div>
  </div>
  <img class="ditele-curve ditele-curve--test-a" src={assets.curve} alt="" width="300" height="300" aria-hidden="true" />
  <img class="ditele-curve ditele-curve--test-b" src={assets.curve} alt="" width="300" height="300" aria-hidden="true" />
</section>

<section class="ditele-section ditele-platform" id="lernplattform" aria-labelledby="ditele-platform-title">
  <div class="container">
    <h2 id="ditele-platform-title" data-reveal>{copy.platformTitle}</h2>
    <p class="ditele-platform__intro" data-reveal>{copy.platformIntro}</p>
    <div class="ditele-card-grid ditele-card-grid--three">
      {copy.platformItems.map(([title, text]) => (
        <article class="ditele-card" data-reveal>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
    <p class="ditele-platform__outro" data-reveal>{copy.platformOutro}</p>
  </div>
</section>

<section class="ditele-section ditele-why" aria-labelledby="ditele-why-title">
  <div class="container">
    <h2 id="ditele-why-title" data-reveal><span>{copy.whyTitle.split(' ')[0]}</span> {copy.whyTitle.split(' ').slice(1).join(' ')}</h2>
    <div class="ditele-why__grid">
      {copy.whyItems.map(([title, text], index) => (
        <article data-reveal>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            {index === 0 ? (
              <><rect x="5" y="8" width="19" height="16" rx="1" /><path d="M9 5v6M20 5v6M9 15h11M9 19h7" /></>
            ) : index === 1 ? (
              <><path d="M6 25V10h15v15M4 25h22M10 14h3M16 14h2M10 18h3M16 18h2" /><path d="M21 11l5-5M22 6h4v4" /></>
            ) : (
              <><path d="M16 4a5 5 0 015 5c0 2-1 3-2 4v3h-6v-3c-1-1-2-2-2-4a5 5 0 015-5zM13 21h6M14 25h4" /><path d="M5 11h3M24 11h3M8 5l2 2M24 5l-2 2" /></>
            )}
          </svg>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
    <p class="ditele-why__outro" data-reveal>{copy.whyOutro}</p>
  </div>
</section>

<section class="ditele-section ditele-together" aria-labelledby="ditele-together-title">
  <div class="container">
    <h2 id="ditele-together-title" data-reveal>{copy.togetherTitle}</h2>
    <div class="ditele-card-grid ditele-card-grid--four">
      {copy.togetherItems.map((text) => <article class="ditele-card ditele-card--strong" data-reveal><p>{text}</p></article>)}
    </div>
    <p class="ditele-together__outro" data-reveal>{copy.togetherOutro}</p>
    <div class="ditele-together__actions" data-reveal>
      <a class="ditele-discover" href="https://onlinekurs.test-it-academy.com/" target="_blank" rel="noopener noreferrer">
        {copy.discover} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<section class="ditele-section ditele-advantages" aria-labelledby="ditele-advantages-title">
  <div class="container ditele-advantages__grid">
    <div data-reveal>
      <h2 id="ditele-advantages-title"><span>{copy.advantagesTitle.split(' ')[0]}</span> {copy.advantagesTitle.split(' ').slice(1).join(' ')}</h2>
      <div class="ditele-advantages__list">
        {copy.advantages.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
    <figure class="ditele-advantages__media" data-reveal>
      <img
        src={assets.classroom}
        alt={copy.developerAlt}
        width="1680"
        height="1120"
        loading="eager"
      />
    </figure>
  </div>
</section>

<style>
  .ditele-hero,
  .ditele-section {
    background: #101010;
    color: #fff;
  }

  /* Hero geometry is owned by .page-hero in global.css. */
  .ditele-section h2 {
    overflow-wrap: normal;
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
  }

  .ditele-hero h1 {
    color: #ff0b00;
  }

  /* The box itself comes from .page-hero__art; this only sizes the square
     composition and centres it in that space. */
  .ditele-hero__media {
    display: grid;
    place-items: center;
  }

  .ditele-hero__media > img {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    max-height: min(84%, 470px);
    max-width: 70%;
  }

  .ditele-hero__disc { transform: rotate(-87deg); animation: ditele-disc-drift 4s ease-in infinite; }
  .ditele-hero__sphere { max-height: min(54%, 300px); max-width: 46%; left: 46%; top: 54%; transform: rotate(29deg); animation: ditele-sphere-drift 4s ease-in infinite; }

  .ditele-section {
    position: relative;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    overflow: hidden;
  }

  .ditele-section p {
    font-size: var(--fs-body);
    line-height: 1.48;
  }

  .ditele-test__grid,
  .ditele-advantages__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(360px, 0.88fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: center;
  }

  .ditele-test__video {
    position: relative;
    z-index: 1;
    /* Height comes from the 16:9 ratio in VideoEmbed. A min-height here would
       instead resolve the width and blow the tile past its grid track. */
    min-width: 0;
    overflow: hidden;
    background: #080808;
  }

  .ditele-test__video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ditele-test__video-consent {
    position: relative;
    display: grid;
    height: 100%;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    place-content: center;
    justify-items: center;
    overflow: hidden;
    background: #090909;
    text-align: center;
  }

  .ditele-test__video-consent::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(5, 5, 5, 0.62), rgba(5, 5, 5, 0.82)),
      url('/images/academy/tild6466-6536-4065-b832-356661343462__wma_imagevideo_bild1.jpg') center / cover no-repeat;
    content: '';
    transform: scale(1.01);
  }

  .ditele-test__video-consent > * {
    position: relative;
    z-index: 1;
  }

  .ditele-test__video-consent svg {
    width: 60px;
    height: 60px;
    margin-bottom: 12px;
  }
  .ditele-test__video-consent svg circle { fill: #ff0b00; stroke: none; }
  .ditele-test__video-consent svg path { fill: #fff; }

  .ditele-test__video-consent strong {
    font-size: var(--fs-body);
  }

  .ditele-test__video-consent p {
    max-width: 470px;
    margin: 8px 0 14px;
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--fs-sm);
  }

  .ditele-test__video-consent button {
    min-height: 42px;
    padding: 0 18px;
    background: #ff0b00;
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: background 180ms ease, transform 180ms ease;
  }

  .ditele-test__video-consent button:hover {
    background: #e90a00;
    transform: translateY(-1px);
  }

  .ditele-test__video-stop {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    min-height: 38px;
    padding-inline: 14px;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.82);
    color: #fff;
    font-size: var(--fs-xs);
  }

  .ditele-test__content {
    position: relative;
    z-index: 2;
    max-width: 720px;
  }

  .ditele-test__content > p {
    margin: 18px 0 24px;
  }

  .ditele-form {
    display: grid;
    gap: 11px;
  }

  .ditele-field-label {
    margin-bottom: -5px;
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .ditele-form input:not([type='checkbox']) {
    width: 100%;
    min-height: 48px;
    padding: 0 15px;
    border: 1px solid #d8d8d8;
    border-radius: var(--radius-sm);
    background: #fff;
    color: #111;
    font-family: inherit;
    font-size: var(--fs-body);
  }

  .ditele-consent {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: start;
    color: rgba(255, 255, 255, 0.66);
    font-size: var(--fs-sm);
    line-height: 1.4;
  }

  .ditele-consent input {
    width: 17px;
    height: 17px;
    margin-top: 1px;
    accent-color: #ff0b00;
  }

  .ditele-consent a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ditele-form button {
    width: fit-content;
    min-height: 46px;
    margin-top: 4px;
    padding: 0 22px;
    background: #ff0b00;
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: background 180ms ease, transform 180ms ease;
  }

  .ditele-form button:hover { background: #e90a00; transform: translateY(-1px); }
  .ditele-form button:disabled { cursor: wait; opacity: 0.7; }

  /* Test placeholder + online-course link (test coming soon). */
  .ditele-test__badge {
    display: inline-block;
    margin-bottom: 0.9rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    color: #fff;
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ditele-test__note {
    margin-top: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
  }
  /* Shared CTA to the online-course shop. Sized on the site's control tokens
     so it matches every other button, and uses the accessible red: white on
     #ff0b00 is 4.2:1 and fails WCAG AA. */
  .ditele-discover {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--btn-h);
    margin-top: 1.75rem;
    padding-inline: var(--btn-pad-x);
    background: var(--color-accent-surface);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-accent);
    transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
