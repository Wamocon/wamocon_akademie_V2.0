<script>
  document.querySelectorAll<HTMLElement>('[data-external-media]').forEach((container) => {
    const button = container.querySelector<HTMLButtonElement>('[data-load-external-media]');
    const iframe = container.querySelector<HTMLIFrameElement>('iframe[data-consent-src]');
    const placeholder = container.querySelector<HTMLElement>('.ditele-test__video-consent');
    const stopButton = container.querySelector<HTMLButtonElement>('[data-stop-external-media]');

    const stop = () => {
      if (!iframe) return;
      iframe.removeAttribute('src');
      iframe.hidden = true;
      if (placeholder) placeholder.hidden = false;
      if (stopButton) stopButton.hidden = true;
      container.classList.remove('is-loaded');
    };

    button?.addEventListener('click', () => {
      const src = iframe?.dataset.consentSrc;
      if (!iframe || !src) return;

      iframe.src = src;
      iframe.hidden = false;
      placeholder?.setAttribute('hidden', '');
      if (stopButton) stopButton.hidden = false;
      container.classList.add('is-loaded');
    });
    stopButton?.addEventListener('click', stop);
    window.addEventListener('pagehide', stop);
    window.addEventListener('wamocon:consent', (event) => {
      const detail = (event as CustomEvent<{ externalMedia?: boolean }>).detail;
      if (!detail?.externalMedia) stop();
    });
  });

  const checkButton = document.getElementById('ditele-check-button');
  checkButton?.addEventListener('click', () => {
    document.getElementById('lernplattform')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
