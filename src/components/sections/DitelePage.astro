<script>

  const checkButton = document.getElementById('ditele-check-button');
  checkButton?.addEventListener('click', () => {
    document.getElementById('lernplattform')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Interactive live-demo quiz: reveal the answer, then nudge toward the course.
  const quizDe = document.documentElement.lang !== 'en';
  document.querySelectorAll<HTMLElement>('[data-ditele-quiz]').forEach((quiz) => {
    const options = quiz.querySelectorAll<HTMLButtonElement>('[data-quiz-option]');
    const feedback = quiz.querySelector<HTMLElement>('[data-quiz-feedback]');
    options.forEach((option) => {
      option.addEventListener('click', () => {
        if (quiz.dataset.answered) return;
        quiz.dataset.answered = '1';
        const chosenCorrect = option.getAttribute('data-correct') === 'true';
        option.classList.add(chosenCorrect ? 'is-correct' : 'is-wrong');
        options.forEach((other) => {
          if (other.getAttribute('data-correct') === 'true') other.classList.add('is-correct');
          other.disabled = true;
        });
        if (feedback) {
          feedback.hidden = false;
          feedback.textContent = chosenCorrect
            ? (quizDe ? 'Richtig! Alle drei Ziele gehören zum Softwaretesten.' : 'Correct! All three goals are part of software testing.')
            : (quizDe ? 'Nicht ganz – richtig ist D: Alle oben genannten.' : 'Not quite – the answer is D: all of the above.');
          feedback.classList.add(chosenCorrect ? 'is-correct' : 'is-wrong');
        }
        quiz.classList.add('is-answered');
      });
    });
  });
</script>
