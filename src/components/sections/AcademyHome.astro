---
import { assets, home, steps } from '../../data/academy';
import { nav, type Lang } from '../../i18n/config';
import { pick } from '../../i18n/utils';
import Button from '../ui/Button.astro';
import LeadForm from './LeadForm.astro';
import OfficeTour from '../ui/OfficeTour.astro';
import VideoEmbed from '../ui/VideoEmbed.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = home;
const istqbHref = nav.find((item) => item.key === 'certification')![lang].href;
const c = pick(lang, {
  de: {
    experienceLead: 'über 50 Jahre gebündelte',
    experienceRest: 'Praxiserfahrung unseres Teams',
    mission: 'UNSERE MISSION',
    videoNotice: 'Dieses Video wird erst nach Ihrer Zustimmung von YouTube geladen.',
    videoLoad: 'YouTube-Video laden',
    successLead: 'Starten Sie Ihre',
    successLeadTwo: 'Erfolgsgeschichte mit',
    successRest: 'der WAMOCON Academy',
    certification: 'Zertifizierung',
    istqbCta: 'Mehr über ISTQB®',
    stepsLead: 'Von der Bewerbung bis zum IT-Projekt:',
    stepsRest: '6 Schritte zum gefragten Softwaretester',
    stepsClosing:
      'Entdecken Sie jetzt, wie diese sechs entscheidenden Schritte Ihre Karriere verändern können. Melden Sie sich noch heute an!',
  },
  en: {
    experienceLead: 'over 50 years of combined',
    experienceRest: 'practical experience within our team',
    mission: 'OUR MISSION',
    videoNotice: 'This video loads from YouTube only after your consent.',
    videoLoad: 'Load YouTube video',
    successLead: 'Start your success story with',
    successLeadTwo: '',
    successRest: 'the WAMOCON Academy',
    certification: 'Certification',
    istqbCta: 'More about ISTQB®',
    stepsLead: 'From the application to the IT project:',
    stepsRest: '6 steps to becoming a sought-after software tester',
    stepsClosing: 'Discover now how these six decisive steps can change your career. Sign up today!',
  },
});
---

<section class="academy-hero" data-hero-media>
  <div class="academy-hero__media" aria-hidden="true">
    <video autoplay muted loop playsinline preload="auto" poster={assets.hero}>
      <source src="/media/hero-background.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="academy-hero__overlay"></div>
  <div class="academy-hero__inner container">
    <div class="academy-hero__copy" data-reveal>
      <h1>{h.hero.title}</h1>
      <p>{h.hero[lang]}</p>
      <div class="academy-hero__actions">
        <Button href="#beratung" size="lg">{h.hero.cta[lang]}</Button>
        <ul class="academy-hero__stats">
          {h.hero.stats.map((stat) => <li><strong>{stat.value}</strong><span>{stat[lang]}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="experience">
  <div class="container experience__top">
    <div class="experience__copy" data-reveal>
      <h2>
        <span>{c.experienceLead}</span><br />{c.experienceRest}
      </h2>
      {h.intro.paragraphs[lang].map((p) => <p>{p}</p>)}
    </div>
    <aside class="mission" data-reveal>
      <strong>{c.mission}</strong>
      <p>{h.intro.mission[lang]}</p>
      <img src={assets.missionRing} alt="" width="600" height="600" loading="lazy" aria-hidden="true" />
    </aside>
  </div>

  <div class="container success-story">
    <VideoEmbed
      class="success-story__video"
      videoId="Q_0mtjo8GAU"
      title="WAMOCON Academy Karriere-Booster IT"
      poster="/images/academy/tild6466-6536-4065-b832-356661343462__wma_imagevideo_bild1.jpg"
      lang={lang}
    />
    <div class="success-story__copy" data-reveal>
      <h2>
        <span>{c.successLead}{c.successLeadTwo && <><br />{c.successLeadTwo}</>}</span><br />{c.successRest}
      </h2>
      <p>{h.success.text[lang]}</p>
      <img src={assets.accentCurve} alt="" width="320" height="320" loading="lazy" aria-hidden="true" />
    </div>
    <article class="compare-panel compare-panel--without" data-reveal>
      <h3>{h.success.without.title[lang]}</h3>
      <ul>{h.success.without.items[lang].map((item) => <li>{item}</li>)}</ul>
    </article>
    <article class="compare-panel" data-reveal>
      <h3>{h.success.with.title[lang]}</h3>
      <ul>{h.success.with.items[lang].map((item) => <li>{item}</li>)}</ul>
    </article>
  </div>
</section>

<section class="section surface-light istqb">
  <div class="container istqb__grid">
    <div class="istqb__copy" data-reveal>
      <span class="eyebrow">{c.certification}</span>
      <h2>{h.istqb.title}</h2>
      <p>{h.istqb[lang]}</p>
      <p>{h.istqb.closing[lang]}</p>
      <Button href={istqbHref}>{c.istqbCta}</Button>
    </div>
    <figure class="istqb__certificate" data-reveal>
      <img src={assets.certificate} alt="ISTQB Accredited Training Provider" width="960" height="1358" loading="lazy" />
    </figure>
  </div>
</section>

<section class="section steps">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>
        <span>{c.stepsLead}</span>
        {c.stepsRest}
      </h2>
    </div>
    <ol class="steps__list">
      {steps[lang].map((step, index) => <li data-reveal><span>{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}
    </ol>
    <p class="steps__closing" data-reveal>{c.stepsClosing}</p>
    <Button href={istqbHref} class="steps__cta">{c.istqbCta}</Button>
  </div>
</section>

<OfficeTour lang={lang} />

<style>
  .academy-hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .academy-hero__media,
  .academy-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .academy-hero__media img,
  .academy-hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Two darkening gradients for legibility, then the brand glow on top so the
     hero picks up the same red atmosphere as the rest of the group's sites. */
  .academy-hero__overlay {
    background:
      radial-gradient(55% 45% at 82% 30%, var(--glow-top), transparent 70%),
      radial-gradient(40% 40% at 100% 65%, var(--glow-side), transparent 70%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)),
      linear-gradient(0deg, #000 0%, rgba(0, 0, 0, 0.62) 35%, rgba(0, 0, 0, 0.18) 100%);
  }

  .academy-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100svh;
    max-width: var(--container-max);
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 220px clamp(72px, 8vh, 112px);
  }

  .academy-hero__copy {
    min-width: 0;
    width: min(100%, 1500px);
  }

  .academy-hero__copy h1 {
    max-width: none;
    margin-bottom: 18px;
    font-size: var(--fs-hero);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    /* `white-space: nowrap` used to be here. At the 72px floor "WAMOCON
       Academy" is ~640px wide, so on any phone it ran off-canvas and was
       silently amputated by the body's `overflow-x: clip`. */
  }

  .academy-hero__copy p {
    max-width: 1320px;
    margin-bottom: 34px;
    color: #fff;
    font-size: var(--fs-lead);
    font-weight: var(--fw-regular);
    line-height: var(--lh-relaxed);
    overflow-wrap: break-word;
  }

  .academy-hero__actions {
    display: flex;
    align-items: center;
    gap: clamp(38px, 3.5vw, 72px);
  }

  .academy-hero__stats {
    display: flex;
    align-items: flex-start;
    gap: clamp(28px, 3vw, 66px);
    min-width: 0;
    width: auto;
  }

  .academy-hero__stats li {
    min-width: clamp(150px, 10vw, 205px);
    padding: 0;
  }

  .academy-hero__stats li:last-child {
    border-right: 0;
  }

  .academy-hero__stats strong {
    display: block;
    color: #fff;
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    line-height: var(--lh-display);
    font-variant-numeric: tabular-nums;
  }

  .academy-hero__stats span {
    color: #fff;
    font-size: var(--fs-lead);
    font-weight: var(--fw-regular);
    line-height: var(--lh-snug);
    white-space: nowrap;
  }

  .academy-hero__copy :global(.btn) {
    width: clamp(260px, 17vw, 350px);
    min-height: clamp(66px, 4.5vw, 86px);
    flex: 0 0 auto;
    font-size: var(--fs-lead);
  }

  .istqb__grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .section-head h2,
  .istqb__copy h2 {
    margin: 0.8rem 0 1.2rem;
  }

  .istqb__copy p {
    margin-bottom: 1rem;
    color: var(--color-muted);
  }

  .istqb__certificate {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .istqb__copy p {
    color: var(--color-muted-dark);
  }

  .experience { padding: clamp(56px, 4vw, 84px) 0 clamp(96px, 8vw, 160px); overflow: hidden; background: #101010; }
  .experience__top { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(360px, .72fr); gap: clamp(56px, 7vw, 130px); align-items: start; }
  .experience__copy h2,
  .success-story__copy h2 { margin: 0 0 34px; font-size: var(--fs-h1); line-height: var(--lh-tight); }
  .experience__copy h2 span,
  .success-story__copy h2 span { color: #ff0b00; }
  .experience__copy p { max-width: 980px; margin-bottom: 16px; color: #f2f2f2; font-size: var(--fs-lead); line-height: var(--lh-relaxed); }
  .mission { position: relative; min-height: clamp(400px, 31vw, 520px); padding: clamp(76px, 6vw, 104px) clamp(30px, 3vw, 50px) 38px; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .mission strong { position: absolute; top: 0; left: 30px; padding: 12px 18px; border-radius: 0 0 var(--radius-md) 0; background: #101010; color: var(--color-accent); font-size: var(--fs-2xs); font-weight: var(--fw-semibold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .mission p { position: relative; z-index: 2; max-width: 400px; color: #fff; font-size: var(--fs-h3); line-height: var(--lh-snug); }
  .mission img { position: absolute; right: clamp(-190px, -9vw, -110px); bottom: clamp(-185px, -9vw, -115px); z-index: 1; width: clamp(410px, 31vw, 540px); height: auto; object-fit: contain; animation: mission-ring-drift 10s ease-in-out infinite alternate; will-change: transform; }
  .success-story { display: grid; grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr); gap: clamp(40px, 4.5vw, 82px); margin-top: clamp(110px, 10vw, 180px); }
  .success-story__video { min-height: 0; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-lg); background: #202020; box-shadow: var(--shadow-card); }
  .success-story__video iframe { display: block; width: 100%; height: 100%; min-height: 0; aspect-ratio: 16 / 9; border: 0; }
  .external-media {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .external-media iframe[hidden],
  .external-media__notice[hidden] {
    display: none;
  }
  .external-media__notice {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #111;
  }
  .external-media__notice > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(.68) saturate(.85);
  }
  .external-media__notice-content {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    background: linear-gradient(0deg, rgba(0,0,0,.72), transparent 48%);
  }
  .external-media__notice-content button {
    display: grid;
    width: 76px;
    height: 54px;
    place-items: center;
    color: #fff;
    transition: transform 180ms ease;
  }
  .external-media__notice-content button:hover,
  .external-media__notice-content button:focus-visible {
    transform: scale(1.08);
  }
  .external-media__notice-content svg {
    width: 76px;
    fill: var(--color-accent);
  }
  .external-media__notice-content .external-media__play-triangle { fill: #fff; }
  .external-media__notice-content p {
    position: absolute;
    right: 18px;
    bottom: 14px;
    left: 18px;
    margin: 0;
    color: rgba(255,255,255,.9);
    font-size: var(--fs-xs);
    line-height: var(--lh-snug);
    text-align: left;
  }
  .success-story__copy { position: relative; padding-top: 25px; }
  .success-story__copy h2 { margin-bottom: 26px; }
  .success-story__copy p { position: relative; z-index: 2; max-width: 780px; color: #f2f2f2; font-size: var(--fs-lead); line-height: var(--lh-relaxed); }
  .success-story__copy > img { position: absolute; right: clamp(-160px, -7vw, -86px); bottom: clamp(-105px, -5vw, -58px); width: clamp(260px, 21vw, 370px); height: auto; object-fit: contain; animation: success-curve-drift 8s ease-in-out infinite alternate; will-change: transform; }
  /* Two sides of the same comparison, so they share a shape and differ only in
     weight: the "without" side stays recessive, the "with" side is elevated and
     carries the accent. */
  .compare-panel {
    min-height: 178px;
    padding: clamp(28px, 2.3vw, 38px) clamp(30px, 2.8vw, 44px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
  }
  .compare-panel--without {
    background: rgba(255, 255, 255, 0.035);
    box-shadow: none;
  }
  .compare-panel h3 { margin-bottom: 16px; color: #fff; font-size: var(--fs-h4); }
  .compare-panel li {
    position: relative;
    padding-left: 26px;
    margin-bottom: 11px;
    color: #fff;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .compare-panel li::before {
    content: '+';
    position: absolute;
    left: 0;
    top: 0.05em;
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-accent-surface);
    color: #fff;
    font-size: var(--fs-2xs);
    font-weight: var(--fw-bold);
    line-height: 1;
  }
  .compare-panel--without li { color: var(--color-muted); }
  .compare-panel--without li::before {
    content: '–';
    background: rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.7);
  }

  .section-head {
    max-width: 980px;
    margin-bottom: 2rem;
  }

  /* The certificate is portrait (1653x2339). Cap the image rather than the
     figure, otherwise `overflow: hidden` cuts the document off. */
  .istqb__certificate {
    display: grid;
    max-height: 760px;
    place-items: center;
    background: #e7f6ff;
  }

  .istqb__certificate img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 760px;
    object-fit: contain;
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 2.7vw, 46px);
  }

  /* The copy starts directly under the number badge; the old bottom alignment
     left a large empty gap above every step. */
  .steps__list li {
    position: relative;
    display: flex;
    min-height: clamp(150px, 9vw, 190px);
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(14px, 1.1vw, 20px);
    padding: clamp(22px, 1.8vw, 34px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--dur-med) var(--ease-out),
      transform var(--dur-med) var(--ease-out),
      background var(--dur-med) var(--ease-out),
      box-shadow var(--dur-med) var(--ease-out);
  }
  .steps__list li:hover {
    border-color: var(--color-accent);
    background: var(--surface-card-hover);
    box-shadow: var(--shadow-card), var(--shadow-accent);
    transform: translateY(-4px);
  }
  /* Arrows between the boxes so they read as a connected, ordered sequence
     (review AK#3 / AK#11). Hidden after the last box in each row. */
  .steps__list li::after {
    content: '→';
    position: absolute;
    top: 50%;
    right: clamp(-30px, -1.7vw, -18px);
    transform: translateY(-50%);
    color: var(--color-accent);
    font-size: var(--fs-h4);
    line-height: 1;
    pointer-events: none;
  }
  .steps__list li:nth-child(3n)::after,
  .steps__list li:last-child::after { content: none; }

  /* The number sits in the flow as a badge rather than pinned to the corner —
     pinned to a rounded corner it read as a sticker stuck on the card. */
  .steps__list span {
    display: grid;
    width: clamp(42px, 2.6vw, 52px);
    height: clamp(42px, 2.6vw, 52px);
    flex: 0 0 auto;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-accent-surface);
    color: #fff;
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    box-shadow: var(--shadow-accent);
  }

  .steps__list p {
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--fs-lead);
    line-height: var(--lh-snug);
  }

  .steps .section-head {
    max-width: none;
    margin-bottom: 34px;
  }

  .steps .section-head h2 {
    max-width: 1100px;
    margin: 0;
    font-size: var(--fs-h1);
    line-height: var(--lh-tight);
  }

  .steps .section-head h2 span {
    display: block;
    color: var(--color-accent);
  }

  .steps__closing {
    max-width: 860px;
    margin: 38px 0 14px;
    color: rgba(255, 255, 255, 0.84);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    text-align: left;
  }

  .steps :global(.steps__cta) {
    min-width: 178px;
    min-height: 46px;
  }

  @keyframes mission-ring-drift {
    from { transform: translate3d(-10px, 8px, 0) rotate(-4deg); }
    to { transform: translate3d(16px, -18px, 0) rotate(7deg); }
  }

  @keyframes success-curve-drift {
    from { transform: translate3d(-8px, 12px, 0) rotate(-7deg); }
    to { transform: translate3d(18px, -10px, 0) rotate(6deg); }
  }

  @media (max-width: 900px) {
    .istqb__grid,
    .experience__top,
    .success-story {
      grid-template-columns: 1fr;
    }

    .experience { padding-block: 60px 80px; }
    /* The ring is a flourish that bleeds out of the panel on desktop. On a
       single-column layout that bleed runs off-screen to the right and hangs
       ~115px below the panel, painting on top of the video underneath, so clip
       it to its own card here. */
    .mission { min-height: 330px; overflow: hidden; }
    .mission img {
      right: -72px;
      bottom: -84px;
      width: min(72%, 300px);
    }
    .success-story { margin-top: 70px; }
    .success-story__copy > img { display: none; }

    .steps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Two columns: arrow only after odd items (end of a pair is even). */
    .steps__list li:nth-child(3n)::after { content: '→'; }
    .steps__list li:nth-child(2n)::after,
    .steps__list li:last-child::after { content: none; }
  }

  @media (max-width: 980px) {
    .academy-hero {
      min-height: 100svh;
    }

    .academy-hero__inner {
      min-height: 100svh;
      justify-content: flex-end;
      padding-top: 180px;
      padding-bottom: 64px;
    }

    .academy-hero__copy h1 {
      max-width: none;
      margin-bottom: 12px;
    }

    .academy-hero__copy p {
      margin-bottom: 25px;
    }

    .academy-hero__copy {
      width: 100%;
      max-width: 100%;
    }

    .academy-hero__copy :global(.btn) {
      width: 220px;
      min-height: 60px;
      padding-inline: 12px;
    }

    .academy-hero__actions {
      flex-wrap: wrap;
      align-items: center;
      gap: 28px;
    }

    .academy-hero__stats {
      display: grid;
      width: min(100%, 680px);
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(12px, 4vw, 24px);
      justify-content: stretch;
    }

    .academy-hero__stats li {
      width: auto;
      min-width: 0;
    }

    .academy-hero__stats span {
      display: block;
      white-space: normal;
    }
  }

  @media (max-width: 620px) {
    .academy-hero__inner { padding-top: 150px; padding-bottom: 42px; }
    .academy-hero__actions { align-items: stretch; flex-direction: column; gap: 24px; }
    .academy-hero__copy :global(.btn) { width: min(100%, 240px); }
    .academy-hero__stats { width: 100%; gap: 12px; }
    .steps__list { grid-template-columns: 1fr; gap: 30px; }
    /* Single column: arrows point down between every box except the last. */
    .steps__list li::after,
    .steps__list li:nth-child(3n)::after,
    .steps__list li:nth-child(2n)::after { content: '↓'; top: auto; right: auto; bottom: clamp(-26px, -5vw, -20px); left: 50%; transform: translateX(-50%); }
    .steps__list li:last-child::after { content: none; }
    .steps__closing { margin-top: 28px; }
  }

  @media (min-width: 1200px) {
    .academy-hero__inner,
    .experience__top,
    .success-story,
    .courses-home > .container,
    .istqb__grid,
    .steps > .container {
      width: 100%;
      max-width: var(--container-max);
      margin-inline: auto;
      padding-inline: var(--container-pad);
    }

    .experience__top {
      grid-template-columns: minmax(0, 1.45fr) minmax(420px, 1fr);
      gap: clamp(50px, 4.2vw, 150px);
    }

    .experience__copy h2,
    .success-story__copy h2 {
      max-width: 1100px;
    }

    .experience__copy p {
      max-width: min(58vw, 1120px);
    }

    .mission {
      min-height: clamp(420px, 29vw, 520px);
      padding: clamp(82px, 5vw, 104px) clamp(34px, 3vw, 54px) 44px;
    }

    .mission p {
      max-width: 560px;
    }

    .mission img {
      right: clamp(-280px, -8vw, -120px);
      bottom: clamp(-260px, -10vw, -150px);
