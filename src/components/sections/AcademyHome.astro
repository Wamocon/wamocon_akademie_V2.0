</style>

<script>
  function initAcademyHeroMedia() {
    document.querySelectorAll<HTMLElement>('[data-hero-media]').forEach((root) => {
      if (root.dataset.heroMediaReady === 'true') return;
      root.dataset.heroMediaReady = 'true';

      const video = root.querySelector<HTMLVideoElement>('video');
      if (!video) return;

      const play = () => {
        video.muted = true;
        void video.play().catch(() => undefined);
      };

      if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) play();
      else video.addEventListener('loadeddata', play, { once: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) video.pause();
        else play();
      });
    });
  }

  function initExternalMediaConsent() {
    document.querySelectorAll<HTMLElement>('[data-external-media]').forEach((media) => {
      if (media.dataset.externalMediaReady === 'true') return;
      media.dataset.externalMediaReady = 'true';

      const iframe = media.querySelector<HTMLIFrameElement>('iframe[data-consent-src]');
      const notice = media.querySelector<HTMLElement>('[data-external-media-notice]');
      const loadButton = media.querySelector<HTMLButtonElement>('[data-external-media-load]');
      const stopButton = media.querySelector<HTMLButtonElement>('[data-external-media-stop]');

      const stop = () => {
        if (!iframe) return;
        iframe.removeAttribute('src');
        iframe.hidden = true;
        if (notice) notice.hidden = false;
        if (stopButton) stopButton.hidden = true;
        media.classList.remove('is-loaded');
      };

      loadButton?.addEventListener('click', () => {
        const source = iframe?.dataset.consentSrc;
        if (!iframe || !source) return;
        iframe.src = source;
        iframe.hidden = false;
        if (notice) notice.hidden = true;
        if (stopButton) stopButton.hidden = false;
        media.classList.add('is-loaded');
      });
      stopButton?.addEventListener('click', stop);
      window.addEventListener('pagehide', stop);
      window.addEventListener('wamocon:consent', (event) => {
        const detail = (event as CustomEvent<{ externalMedia?: boolean }>).detail;
        if (!detail?.externalMedia) stop();
      });
    });
  }

  initAcademyHeroMedia();
  initExternalMediaConsent();
  document.addEventListener('astro:after-swap', initAcademyHeroMedia);
  document.addEventListener('astro:after-swap', initExternalMediaConsent);
</script>
