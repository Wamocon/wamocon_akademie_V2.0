  <form class="istqb-registration-form js-lead-form" data-redirect={redirect}>
    <h2 id="webinar-modal-title">{registrationCopy.title}</h2>
    <input type="hidden" name="type" value="webinar" />
    <input type="hidden" name="lang" value={lang} />
    <input class="lead-form__trap" type="text" name="company" tabindex="-1" autocomplete="off" />
    <label>
      <span>{registrationCopy.name}</span>
      <input type="text" name="name" placeholder={registrationCopy.name} required />
    </label>
    <label>
      <span>{registrationCopy.email}</span>
      <input type="email" name="email" placeholder={registrationCopy.email} required />
    </label>
    <p class="istqb-registration-form__consent">
      <span>{registrationCopy.consentPre}<a href={privacyHref}>{registrationCopy.consentLink}</a>{registrationCopy.consentPost}</span>
    </p>
    <p class="istqb-registration-form__inquiry">{registrationCopy.inquiry}</p>
    <p class="lead-form__status" role="alert" aria-live="assertive" hidden></p>
    <button class="istqb-button" type="submit">{registrationCopy.submit}</button>
  </form>
</dialog>

<LeadForm lang={lang} type="certification" compact title={isEn ? 'Get advice' : 'Beratung erhalten'} />

<style>
  :global(body) { background: #0d0d0d; }

  .istqb-shell {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .istqb-section {
    position: relative;
    padding-block: clamp(72px, 8vw, 128px);
    overflow: hidden;
  }

  .istqb-section h2 {
    font-size: clamp(2rem, 4.1vw, 4.5rem);
    line-height: 1.04;
  }

  .istqb-section h2 span,
  .istqb-hero__copy > span {
    color: var(--color-accent);
  }

  .istqb-section h3 {
    font-size: clamp(1.15rem, 1.55vw, 1.55rem);
    line-height: 1.2;
  }

  .istqb-section p {
    color: var(--color-muted);
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    line-height: 1.7;
  }

  .istqb-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.45rem;
    border: 1px solid var(--color-accent);
    border-radius: 5px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    transition: transform 180ms ease, background 180ms ease;
  }

  .istqb-button:hover { background: #e90a00; transform: translateY(-2px); }
  .istqb-button--outline { background: transparent; }

  .istqb-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(48px, 7vw, 128px);
    align-items: center;
  }

  .istqb-split--balanced { grid-template-columns: 0.78fr 1.22fr; }
  .istqb-split--media { align-items: center; }

  .istqb-heading { max-width: 1160px; margin-bottom: clamp(40px, 6vw, 76px); }
  .istqb-heading p { max-width: 1020px; margin-top: 1.25rem; }

  .istqb-hero {
    position: relative;
    min-height: clamp(690px, 78vh, 820px);
    display: grid;
    align-items: center;
    overflow: hidden;
    background: #0d0d0d;
  }

  .istqb-hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(transparent, #0d0d0d);
    pointer-events: none;
  }

  .istqb-hero__inner {
    position: relative;
    min-height: inherit;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(540px, 1.18fr);
    align-items: center;
    padding-top: 180px;
    padding-bottom: 72px;
  }

  .istqb-hero__copy { position: relative; z-index: 2; max-width: 690px; }
  .istqb-hero__copy p { max-width: 680px; margin-bottom: 1.8rem; color: var(--color-muted); font-size: clamp(1rem, 1.4vw, 1.2rem); }
  .istqb-hero__copy > span { display: block; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; }
  .istqb-hero h1 { max-width: 760px; margin: 0.6rem 0 1.2rem; font-size: clamp(2.75rem, 4.8vw, 5rem); line-height: 1.02; }

  .istqb-hero__art { position: absolute; inset: 0 0 0 43%; pointer-events: none; }
  .istqb-hero__cone { position: absolute; width: min(50vw, 790px); max-width: none; transform-origin: 54% 52%; will-change: transform; }
  .istqb-hero__cone--back { top: 34px; right: 7%; opacity: 0.78; animation: istqb-cone-back-drift 11s ease-in-out infinite; }
  .istqb-hero__cone--front { top: 158px; right: -8%; animation: istqb-cone-front-drift 9s ease-in-out infinite; }

  .istqb-intro { padding-top: 64px; }
  .istqb-intro__art { position: relative; min-height: 500px; }
  .istqb-intro__art::before {
    content: '';
    position: absolute;
    width: 75%;
    aspect-ratio: 1;
    inset: 10% auto auto 6%;
