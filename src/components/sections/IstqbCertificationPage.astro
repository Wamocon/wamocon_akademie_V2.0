</style>

<script>
  const modalLinks = document.querySelectorAll<HTMLAnchorElement>('[data-open-modal]');
  const modalDialogs = document.querySelectorAll<HTMLDialogElement>('.istqb-modal');
  const videoDialog = document.getElementById('istqb-video-modal') as HTMLDialogElement | null;

  const stopDialogVideo = (dialog: HTMLDialogElement) => {
    dialog.querySelector<HTMLIFrameElement>('[data-video-frame]')?.removeAttribute('src');
  };

  const clearModalState = (dialog: HTMLDialogElement) => {
    stopDialogVideo(dialog);
    if (window.location.hash.startsWith('#popup:') || window.location.hash === '#zeropopup') {
      history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
    }
  };

  const openModal = (dialog: HTMLDialogElement, hash?: string, youtubeId?: string) => {
    const frame = dialog.querySelector<HTMLIFrameElement>('[data-video-frame]');
    if (frame) {
      const consent = (window as Window & { wamoconConsent?: { grantExternalMedia?: () => void } }).wamoconConsent;
      consent?.grantExternalMedia?.();
      const videoId = youtubeId || frame.dataset.defaultYoutubeId;
      if (videoId) frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
    }
    if (!dialog.open) dialog.showModal();
    if (hash) history.replaceState(null, '', hash);
  };

  modalLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const dialog = document.getElementById(link.dataset.openModal || '') as HTMLDialogElement | null;
      if (!dialog) return;
      event.preventDefault();
      openModal(dialog, link.getAttribute('href') || undefined, link.dataset.youtubeId);
    });
  });

  modalDialogs.forEach((dialog) => {
    dialog.querySelectorAll<HTMLButtonElement>('[data-close-modal]').forEach((button) => {
      button.addEventListener('click', () => dialog.close());
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => clearModalState(dialog));
  });

  document.querySelectorAll<HTMLButtonElement>('.istqb-testimonial-video[data-youtube-id]').forEach((button) => {
    button.addEventListener('click', () => {
      if (videoDialog) openModal(videoDialog, undefined, button.dataset.youtubeId);
    });
  });

  const hashTargets: Record<string, string> = {
    '#popup:Gutscheinbeschreibung': 'istqb-voucher-modal',
    '#popup:Vergleich-mit-anderen-IT-Zertifizierungen': 'istqb-comparison-modal',
    '#popup:Webinar-Anmeldung': 'istqb-webinar-modal',
    '#popup:Webinar-Anmeldung-en': 'istqb-webinar-modal',
  };
  if (window.location.hash === '#zeropopup') {
    history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
  }
  const initialDialog = document.getElementById(hashTargets[window.location.hash] || '') as HTMLDialogElement | null;
  if (initialDialog) openModal(initialDialog);

  window.addEventListener('pagehide', () => modalDialogs.forEach(stopDialogVideo));
  window.addEventListener('pageshow', () => {
    modalDialogs.forEach((dialog) => {
      if (!dialog.open) stopDialogVideo(dialog);
    });
  });
</script>
