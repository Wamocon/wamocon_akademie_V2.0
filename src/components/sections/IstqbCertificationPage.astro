---
import LeadForm from './LeadForm.astro';

interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
const asset = (name: string) => `/images/academy/${name}`;

const careerBenefits = isEn ? [
  {
    title: 'Occupational safety and demand',
    text: 'High demand: Software testers are in high demand in the IT industry, as quality assurance plays a central role in the development of software.\n\nStability: As software development is a continuous process, there is always a need for qualified testers.',
  },
  {
    title: 'Career development and further training',
    text: 'Diverse career paths: Software testers can specialize in different areas, such as automation testing, performance testing or security testing.\n\nFurther training opportunities: There are numerous certifications and training courses (e.g. ISTQB®) that further improve career opportunities.',
  },
  {
    title: 'Technical skills and knowledge',
    text: 'Technical know-how: Testers work closely with developers and develop a deep understanding of software architectures and programming languages.\n\nProblem solving skills: Testers must be analytical and detail-oriented to find and document bugs.',
  },
  {
    title: 'Working environment and flexibility',
    text: 'Teamwork: Software testers often work in agile teams and have the opportunity to work on different projects and with different technologies.\n\nRemote work: Many positions in the field of software testing offer the opportunity to work from home.',
  },
  {
    title: 'Personal satisfaction and influence',
    text: 'Quality assurance: Testers play a crucial role in ensuring the quality and reliability of software products, which can lead to a high level of job satisfaction.\n\nImpact: Good testers have a direct impact on the end products and can help improve the user experience.',
  },
  {
    title: 'Competitive salary',
    text: 'Software testers generally earn a competitive salary that increases with experience and specialization.',
  },
] : [
  {
    title: 'Berufliche Sicherheit und Nachfrage',
    text: 'Hohe Nachfrage: Softwaretester sind in der IT-Branche sehr gefragt, da die Qualitätssicherung eine zentrale Rolle bei der Entwicklung von Software spielt.\n\nStabilität: Da Softwareentwicklung ein kontinuierlicher Prozess ist, gibt es immer Bedarf an qualifizierten Testern.',
  },
  {
    title: 'Karriereentwicklung und Weiterbildung',
    text: 'Vielfältige Karrierewege: Softwaretester können sich auf verschiedene Bereiche spezialisieren, wie z.B. Automatisierungstests, Performance-Tests oder Sicherheitstests.\n\nWeiterbildungsmöglichkeiten: Es gibt zahlreiche Zertifizierungen und Schulungen (z.B. ISTQB®), die die Karrierechancen weiter verbessern.',
  },
  {
    title: 'Technische Fähigkeiten und Wissen',
    text: 'Technisches Know-how: Tester arbeiten eng mit Entwicklern zusammen und entwickeln ein tiefes Verständnis für Softwarearchitekturen und Programmiersprachen.\n\nProblemlösungsfähigkeiten: Tester müssen analytisch und detailorientiert arbeiten, um Fehler zu finden und zu dokumentieren.',
  },
  {
    title: 'Arbeitsumfeld und Flexibilität',
    text: 'Teamarbeit: Softwaretester arbeiten oft in agilen Teams und haben die Möglichkeit, in verschiedenen Projekten und mit unterschiedlichen Technologien zu arbeiten.\n\nRemote-Arbeit: Viele Positionen im Bereich Softwaretest bieten die Möglichkeit, von zu Hause aus zu arbeiten.',
  },
  {
    title: 'Persönliche Zufriedenheit und Einfluss',
    text: 'Qualitätssicherung: Tester spielen eine entscheidende Rolle dabei, die Qualität und Zuverlässigkeit von Softwareprodukten zu gewährleisten, was zu einer hohen beruflichen Zufriedenheit führen kann.\n\nEinfluss: Gute Tester haben einen direkten Einfluss auf die Endprodukte und können dazu beitragen, die Benutzererfahrung zu verbessern.',
  },
  {
    title: 'Wettbewerbsfähiges Gehalt',
    text: 'Softwaretester verdienen in der Regel ein wettbewerbsfähiges Gehalt, das mit zunehmender Erfahrung und Spezialisierung weiter steigt.',
  },
] as const;

