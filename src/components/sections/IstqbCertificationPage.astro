    <p>{voucherCopy.lead}</p>
    <p><strong>{voucherCopy.process}</strong></p>
    <h3>{voucherCopy.prerequisites}</h3>
    <ul>
      {voucherCopy.items.map(([title, text]) => <li><strong>{title}</strong> {text}</li>)}
