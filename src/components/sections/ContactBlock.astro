---
/**
 * Contact details block — mirrors the official Kontakte section:
 * company details on the left (phone, e-mail, opening hours, location, social)
 * and an office photo with a Google rating badge on the right.
 */
import { company, type Lang } from '../../i18n/config';
interface Props {
  /** LEGACY component: unreachable from any route, still German/English only. */
  lang: "de" | "en";
}
const { lang } = Astro.props;

const social = [
  { name: 'YouTube', href: company.social.youtube, icon: '/images/icon-youtube.svg' },
  { name: 'Instagram', href: company.social.instagram, icon: '/images/icon-instagram.svg' },
  { name: 'Facebook', href: company.social.facebook, icon: '/images/icon-facebook.svg' },
];

const labels = {
  de: {
    phone: 'Telefon',
    contactPerson: 'Ansprechpartner',
    contactPersonName: 'Dipl.-Ing. Waleri Moretz, Geschäftsführer der WAMOCON Academy GmbH',
    hours: 'Öffnungszeiten',
    location: 'Standort',
    follow: 'Folgen Sie uns auf sozialen Medien',
    imgAlt: 'WAMOCON Team im Büro',
    ratingLabel: 'Google Bewertung 5,0',
  },
  en: {
    phone: 'Phone',
    contactPerson: 'Contact person',
    contactPersonName: 'Dipl.-Ing. Waleri Moretz, Managing Director, WAMOCON Academy GmbH',
    hours: 'Opening hours',
    location: 'Location',
    follow: 'Follow us on social media',
    imgAlt: 'WAMOCON team in the office',
    ratingLabel: 'Google rating 5.0',
  },
}[lang];
---

<section class="section contact">
  <div class="container contact__grid">
    <div class="contact__info" data-reveal="left">
      <h2 class="contact__name">{company.name}</h2>

      <div class="contact__row">
        <span class="contact__label">{labels.contactPerson}:</span>
        <span>{labels.contactPersonName}</span>
      </div>

      <div class="contact__row">
        <span class="contact__label">{labels.phone}:</span>
        <a href={company.phoneHref}>{company.phone}</a>
      </div>
      <div class="contact__row">
        <span class="contact__label">E-Mail:</span>
        <a href={company.emailHref}>{company.email}</a>
      </div>
      <div class="contact__row">
        <span class="contact__label">{labels.hours}:</span>
        <span>{company.hours[lang].map((h) => <>{h}<br /></>)}</span>
      </div>
      <div class="contact__row">
        <span class="contact__label">{labels.location}:</span>
        <span>{company.street}<br />{company.city}</span>
      </div>

      <div class="contact__social">
        <span class="contact__label">{labels.follow}</span>
        <ul>
          {
            social.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                  <img src={s.icon} alt="" width="50" height="50" loading="lazy" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <figure class="contact__media" data-reveal="right">
      <img
        src="/images/contact-office.jpg"
        alt={labels.imgAlt}
        width="720"
        height="560"
        loading="lazy"
      />
      <figcaption class="contact__rating" aria-label={labels.ratingLabel}>
        <svg width="22" height="22" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <span class="contact__rating-value">5,0</span>
        <span class="contact__stars" aria-hidden="true">★★★★★</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
  }
  .contact::before {
    content: '';
    position: absolute;
    right: -70px;
    bottom: 5%;
    width: clamp(180px, 14vw, 280px);
    aspect-ratio: 1;
    background: url('/images/academy/tild3730-6132-4863-b462-623032303533__group_11.png') center / contain no-repeat;
    opacity: 0.66;
    pointer-events: none;
    transform: rotate(142deg);
    animation: contact-block-drift 10s ease-in-out infinite;
  }
  .contact__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(330px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: center;
  }
  .contact__name {
    font-size: var(--fs-h3);
    margin-bottom: 2.5rem;
  }
  .contact__row {
    margin-bottom: 1.75rem;
    font-size: var(--fs-body);
    line-height: 1.6;
  }
  .contact__label {
    display: block;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .contact__row a:hover {
    color: var(--color-accent);
  }
  .contact__social {
    margin-top: 2.5rem;
  }
  .contact__social ul {
    display: flex;
    gap: 0.85rem;
    margin-top: 0.85rem;
  }
  .contact__social a {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .contact__social a:hover {
    transform: translateY(-3px);
  }
  .contact__social img {
    width: 100%;
    height: 100%;
  }

  .contact__media {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }
  .contact__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 570px;
    aspect-ratio: 1.55 / 1;
  }
  .contact__rating {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
  }
  .contact__rating-value {
    font-weight: var(--fw-semibold);
    color: #fff;
  }
  .contact__stars {
    color: var(--color-accent);
    letter-spacing: 1px;
    font-size: var(--fs-sm);
  }
  .contact__info { max-width: 620px; }

  @keyframes contact-block-drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(142deg); }
    50% { transform: translate3d(-16px, -14px, 0) rotate(150deg); }
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .contact__media {
      order: -1;
    }
    .contact__media img { min-height: 0; }
    .contact::before { display: none; }
  }

  @media (min-width: 2200px) {
    .contact__grid { grid-template-columns: minmax(420px, 0.55fr) minmax(0, 1.45fr); }
    .contact__media img { min-height: 760px; }
    .contact::before { width: min(13vw, 420px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact::before { animation: none; }
  }
</style>
