---
import { assets } from '../../data/academy';
import type { Lang } from '../../i18n/config';
import LeadForm from './LeadForm.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const image = (name: string) => `/images/academy/${name}`;

const sharedImages = {
  storyOne: image('tild3666-3266-4432-b734-343965393238__wma_imagevideo_bild5.png'),
  storyTwo: image('tild3336-6363-4331-a566-343534393462__57_.png'),
  storyThree: image('tild6364-3466-4639-a531-633965633637__23_.jpg'),
} as const;

const copy = {
  de: {
    heroTitle: '360° Booster System für Deine IT-Karriere',
    heroAccent: '360° Booster System',
    heroRest: 'für Deine IT-Karriere',
    heroText: 'WAMOCON hat einen umfassenden Ansatz entwickelt, der alle Aspekte der Projektarbeit im IT-Testing abdeckt.',
    introTitle: 'Dein System für eine erfolgreiche Karriereentwicklung',
    intro: [
      'WAMOCON hat einen umfassenden Ansatz entwickelt, der alle Aspekte der Arbeit im IT-Testing abdeckt. Dieses 360-Grad-System zur erfolgreichen Karriereentwicklung umfasst eine Reihe von Schritten und ermöglicht es, Herausforderungen zu meistern und den Weg zum Erfolg auf die effektivste Weise zu bewältigen.',
      'Das WAMOCON-Team nutzt dieses System, um die Qualität der Arbeit jedes einzelnen Mitarbeiters zu verbessern, erfolgreiche Tests durchzuführen und IT-Projekte erfolgreich abzuschließen.',
    ],
    stepsTitle: 'Deine 6 Schritte für dein Erfolg!',
    steps: [
      ['01', 'Bewerbung', 'Wir unterstützen dich dabei, ein überzeugendes Angebot zu erstellen, um dein Traumprojekt zu sichern. Stelle alle notwendigen Details bereit, um den Kunden von deiner Kompetenz zu überzeugen.'],
      ['02', 'Anpassung', 'Wir vermitteln bewährte Praktiken für eine effektive Zusammenarbeit und Anpassung im neuen Projektteam. Der Schlüssel zum Erfolg liegt in der klaren und verständlichen Erklärung der Prozesse, um eine reibungslose Arbeitsausführung zu gewährleisten.'],
      ['03', 'Planung', 'WAMOCON Academy bietet die Möglichkeit, Fähigkeiten im strukturierten Planen zu verbessern und zentrale Fragen zu formulieren, die helfen, nachträgliche Plananpassungen zu vermeiden und eine konsequente Projektsteuerung zu gewährleisten.'],
      ['04', 'Ausführung', 'Wir definieren Kompetenzen für ein schnelles und genaues Verständnis des Gesamtkontextes des Projekts. In Seminaren wird vermittelt, wie man die Systemlandschaft analysiert und effektiv durch Projektaufgaben navigiert.'],
      ['05', 'Erfüllung', 'Erlernte bewährte Methoden ermöglichen es Ihnen, sich abzuheben und auf alle Projektanforderungen vorbereitet zu sein.'],
      ['06', 'Abschluss', 'Selbst wenn die Fristen knapp sind und die Arbeit noch nicht abgeschlossen ist, können Sie mit der schrittweisen Anleitung von WAMOCON Academy, die durch jahrelange Praxis erprobt ist, das Projekt effizient abschließen und erfolgreich abliefern.'],
    ],
    storyTitle: 'Den Wachstumscode knacken',
    storySubtitle: '360° Booster System · Erfolgsgeschichte',
    stories: [
      {
        image: sharedImages.storyOne,
        alt: 'WAMOCON-Mitarbeiter bei der Projektarbeit',
        blocks: [
          ['Ein persönlicher Einblick in meine Karriereentwicklung', 'Ich freue mich, die Geschichte meiner vielseitigen beruflichen Reise zu teilen, die vor 4 Jahren mit einem Vorstellungsgespräch für ein Praktikum begann.'],
          ['', 'Dieses Ereignis war nicht nur der Start meiner Karriere als Softwaretester und IT-Berater, sondern öffnete auch die Türen zu WAMOCON und veränderte mein Leben grundlegend.'],
          ['', 'Bereits beim ersten Vorstellungsgespräch, das drei Stunden dauerte, spürte ich den einzigartigen Ansatz bei der Beurteilung potenzieller Mitarbeiter, was mich tief beeindruckte.'],
          ['Interaktion mit dem Management und Vertiefung in die Unternehmenskultur', 'Beim Vorstellungsgespräch lernte ich auch das Unternehmensmodell der "drei Säulen" kennen, das externe und interne Projekte sowie Schulungen umfasst. Dieses System, wie von Waleri Moretz betont, spielt eine Schlüsselrolle bei der Entwicklung der Mitarbeiter und verschafft ihnen Wettbewerbsvorteile.'],
        ],
      },
      {
        image: sharedImages.storyTwo,
        alt: 'Projektarbeit am Laptop',
        blocks: [
          ['Einstieg ins Team, intensives Training und Zertifizierung', 'Meine Begeisterung für das Unternehmen führte dazu, dass mir eine Partnerschaft für das Praktikum angeboten wurde. Kurz nach meinem Beitritt zum Team war ich aktiv in das Unternehmensleben eingebunden und begann mit der Vorbereitung auf meine Rolle als Softwaretester.'],
          ['', 'Mein Training war schnell von Erfolg gekrönt: Ich bestand die Prüfung und erhielt meine erste ISTQB-Zertifizierung. Es folgten Zertifizierungen in Agile-Testing und Automatisierung, die ich dank der Unterstützung von WAMOCON ebenfalls erfolgreich abschloss.'],
          ['', 'Ende 2020 begann ich mit der Implementierung von Office 365, was mein erstes internes Projekt bei WAMOCON war. Dieses Projekt verschaffte mir wertvolle praktische Erfahrungen und bereitete mich auf die Teilnahme an größeren Projekten vor.'],
        ],
      },
      {
        image: sharedImages.storyThree,
        alt: 'Präsentation eines Projektablaufs',
        blocks: [
          ['360° Booster System für Karrierewachstum in der IT', 'WAMOCON hat ein umfassendes System entwickelt, das mir ermöglicht, systematisch verschiedene Aspekte der IT zu erlernen und berufliche Herausforderungen zu meistern. Dieses einzigartige System habe ich weder bei anderen Arbeitgebern noch bei meinen Kollegen während meiner langjährigen Berufserfahrung angetroffen. Es umfasst verschiedene Phasen, beginnend mit der Bewerbung für ein Projekt und endend mit dessen Abschluss. Dazu gehören die Bewerbung, Anpassung, Planung, Ausführung und der Abschluss des Projekts. Dieses System hat mir den Weg zum Erfolg eröffnet, indem es mir die Werkzeuge für ein schrittweises berufliches Wachstum bereitstellte.'],
        ],
      },
    ],
    timelineTitle: 'Die Schritte, die wir durchlaufen haben',
    timeline: [
      ['Bewerbungen einreichen', 'Zu Beginn des Jahres 2022 suchte WAMOCON verstärkt nach Mitarbeitern für neue IT-Projekte. Mit der Unterstützung meines Mentors bereitete ich mich auf die Vorstellungsgespräche vor, indem ich mir die erforderlichen Fähigkeiten und die Feinheiten des Bewerbungsverfahrens aneignete, was mir ermöglichte, herauszustechen und an meinem ersten externen Projekt teilzunehmen.'],
      ['Anpassung', 'In dieser Phase habe ich mich in das Projektteam integriert, indem ich aktiv mit den Kollegen kommunizierte und mich in die Besonderheiten der Arbeit einarbeitete. Effektive Kommunikation und schnelle Anpassung halfen mir, ein fester Bestandteil des Teams zu werden.'],
      ['Planung', 'Anhand der Ratschläge zur Planung der Aufgaben entwickelte ich eine Strategie für die Projektdurchführung. Da ich in der Lage war, die Bedeutung, die Dringlichkeit und die Risiken jedes einzelnen Schritts zu bewerten, war der Erfolg gesichert und ich konnte den Prozess effektiv steuern.'],
      ['Ausführung', 'In der Ausführungsphase begann ich, aktiv an den Aufgaben zu arbeiten, Testfälle zu erstellen und das Wissen in der Praxis anzuwenden. Die Zusammenarbeit mit einem Mentor und der Zugang zu bewährten Methoden trugen zur Qualität und zum Erfolg der Projektverpflichtungen bei.'],
      ['Fertigstellung', 'Am Ende des Projekts hatte ich trotz eines vollen Terminkalenders und kürzlicher Änderungen seitens des Kunden das Projekt dank eines klar organisierten Prozesses und der Unterstützung durch das Team erfolgreich abgeschlossen.'],
    ],
    quote: 'Beim Lesen von WAMOCON werden Sie feststellen, dass diese Informationen nun in einer neuen Fachsprache verfügbar sind. Im Jahr 2024, nach der Modernisierung der Universität, wird ein KI-Programm entwickelt, das durch die Ressourcen von WAMOCON unterstützt wird.',
    author: 'Nurzhan Kukeyev, WAMOCON-Mitarbeiter',
    formTitle: 'Beratung erhalten',
    formText: 'Rufen Sie die WAMOCON Academy GmbH unter +49 (0) 6196 5838312 an oder hinterlassen Sie unten Ihre Kontaktdaten, damit wir Sie erreichen und Ihre Fragen beantworten können. Ihre Anfrage ist unverbindlich und kein Kauf.',
  },
  en: {
    heroTitle: '360° Booster System for your IT career',
    heroAccent: '360° Booster System',
    heroRest: 'for your IT career',
    heroText: 'WAMOCON has developed a comprehensive approach that covers all aspects of project work in IT testing.',
    introTitle: 'Your system for successful career development',
    intro: [
      'WAMOCON has developed a comprehensive approach that covers all aspects of working in IT testing. This 360-degree system for successful career development comprises a series of steps and enables challenges to be overcome and the path to success to be managed in the most effective way.',
      "The WAMOCON team uses this system to improve the quality of each individual employee's work, carry out successful tests and successfully complete IT projects.",
    ],
    stepsTitle: 'Your 6 steps to success!',
    steps: [
      ['01', 'Application', 'We support you in creating a convincing offer to secure your dream project. Provide all the necessary details to convince the customer of your expertise.'],
      ['02', 'Customization', 'We share best practices for effective collaboration and alignment within the new project team. The key to success lies in the clear and understandable explanation of processes to ensure smooth work execution.'],
      ['03', 'Planning', 'WAMOCON Academy offers the opportunity to improve skills in structured planning and to formulate key questions that help to avoid subsequent plan adjustments and ensure consistent project control.'],
      ['04', 'Execution', 'We define competencies for a quick and precise understanding of the overall context of the project. Seminars teach how to analyze the system landscape and navigate effectively through project tasks.'],
      ['05', 'Fulfillment', 'Learned best practices allow you to stand out and be prepared for all project requirements.'],
      ['06', 'Conclusion', 'Even if the deadlines are tight and the work has not yet been completed, you can complete the project efficiently and deliver it successfully with the step-by-step instructions from WAMOCON Academy, which have been tried and tested over many years.'],
    ],
    storyTitle: 'Cracking the growth code',
    storySubtitle: '360° Booster System · success story',
    stories: [
      {
        image: sharedImages.storyOne,
        alt: 'WAMOCON employee working on a project',
        blocks: [
          ['A personal insight into my career development', 'I am pleased to share the story of my multifaceted professional journey that started 4 years ago with an interview for an internship.'],
          ['', 'This event not only launched my career as a software tester and IT consultant, but also opened the doors to WAMOCON and fundamentally changed my life.'],
          ['', 'From the very first interview, which lasted three hours, I felt the unique approach to assessing potential employees, which made a deep impression on me.'],
          ['Interaction with management and immersion in the corporate culture', 'During the interview, I also learned about the company\'s “three pillars” model, which includes external and internal projects as well as training. This system, as emphasized by Waleri Moretz, plays a key role in the development of employees and gives them a competitive edge.'],
        ],
      },
      {
        image: sharedImages.storyTwo,
        alt: 'Project work on a laptop',
        blocks: [
          ['Joining the team, intensive training and certification', 'My enthusiasm for the company led to me being offered a partnership for the internship. Shortly after joining the team, I was actively involved in company life and began preparing for my role as a software tester.'],
          ['', 'My training was quickly crowned with success: I passed the exam and received my first ISTQB certification. This was followed by certifications in agile testing and automation, which I also successfully completed thanks to the support of WAMOCON.'],
          ['', 'At the end of 2020, I started implementing Office 365, which was my first internal project at WAMOCON. This project gave me valuable hands-on experience and prepared me to participate in larger projects.'],
        ],
      },
      {
        image: sharedImages.storyThree,
        alt: 'Presentation of a project workflow',
        blocks: [
          ['360° Booster System for career growth in IT', 'WAMOCON has developed a comprehensive system that allows me to systematically learn different aspects of IT and master professional challenges. I have not encountered this unique system with other employers or my colleagues during my many years of professional experience. It comprises different phases, starting with the application for a project and ending with its completion. This includes the application, adaptation, planning, execution and completion of the project. This system has opened the path to success by providing me with the tools for gradual professional growth.'],
        ],
      },
    ],
    timelineTitle: 'The steps we have gone through',
    timeline: [
      ['Submit applications', 'At the beginning of 2022, WAMOCON was increasingly looking for employees for new IT projects. With the support of my mentor, I prepared for the interviews by acquiring the necessary skills and the intricacies of the application process, which allowed me to stand out and take part in my first external project.'],
      ['Customization', 'During this phase, I integrated myself into the project team by actively communicating with my colleagues and familiarizing myself with the specifics of the work. Effective communication and quick adaptation helped me to become an integral part of the team.'],
      ['Planning', 'Using the task planning advice, I developed a strategy for project execution. As I was able to assess the importance, urgency and risks of each step, success was assured and I was able to manage the process effectively.'],
      ['Execution', 'In the execution phase, I began to actively work on the tasks, create test cases and apply the knowledge in practice. Working with a mentor and having access to best practices contributed to the quality and success of the project commitments.'],
      ['Completion', 'By the end of the project, despite a busy schedule and recent changes from the client, I had successfully completed the project thanks to a clearly organized process and support from the team.'],
    ],
    quote: 'As you read WAMOCON, you will notice that this information is now available in a new technical language. In 2024, after the modernization of the university, an AI program will be developed supported by the resources of WAMOCON.',
    author: 'Nurzhan Kukeyev, WAMOCON employee',
    formTitle: 'Get advice',
    formText: 'Call WAMOCON Academy GmbH at +49 (0) 6196 5838312 or leave your contact details below so that we can reach you and answer your questions. Your inquiry is non-binding and is not a purchase.',
  },
} as const;

const c = copy[lang];
// The system diagram is a localised SVG; Turkish falls back to the English edition.
const systemVisual = lang === 'de' ? assets.ditele : assets.appEn;
---

<section class="page-hero booster-hero" aria-labelledby="booster-title">
  <div class="booster-hero__rings page-hero__art" aria-hidden="true">
    <img class="booster-hero__ring booster-hero__ring--outer" src={assets.boosterHero} alt="" width="1680" height="1670" />
    <img class="booster-hero__ring booster-hero__ring--inner" src={assets.boosterHero} alt="" width="1680" height="1670" />
  </div>
  <div class="container booster-hero__inner page-hero__inner">
    <div class="booster-hero__copy page-hero__copy" data-reveal>
      <h1 id="booster-title"><span>{c.heroAccent}</span> {c.heroRest}</h1>
      <p>{c.heroText}</p>
    </div>
  </div>
</section>

<section class="booster-intro">
  <div class="container booster-intro__grid">
    <div class="booster-intro__visual" data-reveal>
      <img src={systemVisual} alt={c.heroTitle} width="596" height="690" loading="lazy" />
    </div>
    <div class="booster-intro__copy" data-reveal>
      <h2>{c.introTitle}</h2>
      {c.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<section class="booster-steps" aria-labelledby="steps-title">
  <div class="container">
    <h2 id="steps-title">{c.stepsTitle}</h2>
    <ol class="booster-steps__grid">
      {c.steps.map(([number, title, text]) => (
        <li class="booster-step" data-reveal>
          <span class="booster-step__number">{number}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="booster-story" aria-labelledby="story-title">
  <div class="container">
    <header class="booster-story__header" data-reveal>
      <span class="booster-story__eyebrow">{c.storySubtitle}</span>
      <h2 id="story-title">{c.storyTitle}</h2>
    </header>

    <div class="booster-story__rows">
      {c.stories.map((story, index) => (
        <article class:list={['booster-story__row', { 'booster-story__row--reverse': index % 2 === 1 }]} data-reveal>
          {index % 2 === 0 && <img src={story.image} alt={story.alt} width="1680" height="945" loading="lazy" />}
          <div class="booster-story__copy">
            {story.blocks.map(([title, text]) => (
              <div class="booster-story__block">
                {title && <h3>{title}</h3>}
                <p>{text}</p>
              </div>
            ))}
          </div>
          {index % 2 === 1 && <img src={story.image} alt={story.alt} width="1680" height="945" loading="lazy" />}
        </article>
      ))}
    </div>

    <section class="booster-timeline" aria-labelledby="timeline-title">
      <h3 id="timeline-title">{c.timelineTitle}</h3>
      <ol class="booster-timeline__grid">
        {c.timeline.map(([title, text], index) => (
          <li data-reveal>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h4>{title}</h4>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <blockquote class="booster-quote" data-reveal>
      <p>{c.quote}</p>
      <cite>{c.author}</cite>
    </blockquote>
  </div>
</section>

<style>
  .booster-hero, .booster-intro, .booster-steps, .booster-story { background: #101010; }
  /* Hero geometry is owned by .page-hero in global.css. */
  .booster-hero { background: #0d0d0d; }
  .booster-intro h2, .booster-steps h2, .booster-story__header h2 { font-size: var(--fs-h2); line-height: var(--lh-tight); }
  .booster-hero h1 span { color: #ff0b00; }
  .booster-intro p { color: #fff; font-size: var(--fs-body); line-height: var(--lh-body); }
  /* Decorative renders are sized from the hero's HEIGHT, not the viewport
     width. A vw-sized square overflowed the frame on wide screens, so the
     shape was sliced off and the space it should have filled read as an empty
     gap. Height-bounding keeps the whole render inside at every width, which
     also makes the per-breakpoint width ladders unnecessary. */
  .booster-hero__ring { object-fit: contain; transform-origin: center; will-change: transform; }
  /* Centred in the art box (see .page-hero__art); offsets off 50% keep the
     layered composition. */
  .booster-hero__ring--outer { left: 54%; max-height: min(66%, 400px); max-width: 62%; animation: ring-drift 4s ease-in infinite; }
  .booster-hero__ring--inner { left: 32%; top: 58%; max-height: min(58%, 345px); max-width: 50%; animation: ring-drift-inner 4s ease-in infinite; }

  .booster-intro { overflow: hidden; }
  .booster-intro__grid { display: grid; min-height: 680px; grid-template-columns: minmax(0, 0.9fr) minmax(440px, 1.1fr); grid-template-areas: 'visual copy'; gap: clamp(3rem, 7vw, 8rem); align-items: center; }
  .booster-intro__visual { grid-area: visual; align-self: stretch; }
  .booster-intro__visual img { width: 100%; height: 100%; max-height: 680px; object-fit: contain; }
  .booster-intro__copy { grid-area: copy; max-width: 760px; }
  .booster-intro h2 { margin-bottom: 34px; }
  .booster-intro p + p { margin-top: 28px; }

  .booster-steps { padding-block: 0 90px; }
  .booster-steps h2 { max-width: 837px; margin-bottom: 40px; color: #ff0b00; }
  .booster-steps__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 2.5vw, 2.75rem); list-style: none; }
  .booster-step { position: relative; min-height: 245px; padding: 72px clamp(1.4rem, 2vw, 2rem) 30px; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-card); box-shadow: var(--shadow-card); transition: border-color var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out), background var(--dur-med) var(--ease-out), box-shadow var(--dur-med) var(--ease-out); }
  .booster-step:hover { border-color: var(--color-accent); background: var(--surface-card-hover); box-shadow: var(--shadow-card), var(--shadow-accent); transform: translateY(-4px); }
  /* Arrows connect the boxes into an ordered sequence (review AK#11). */
  .booster-step::after { content: '→'; position: absolute; top: 50%; right: clamp(-24px, -1.5vw, -14px); transform: translateY(-50%); color: var(--color-accent); font-size: var(--fs-lead); line-height: 1; pointer-events: none; }
  .booster-step:nth-child(3n)::after, .booster-step:last-child::after { content: none; }
  .booster-step__number { position: absolute; top: 20px; left: clamp(1.4rem, 2vw, 2rem); display: grid; width: 40px; height: 40px; place-items: center; border-radius: var(--radius-pill); background: var(--color-accent-surface); color: #fff; font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; box-shadow: var(--shadow-accent); }
  .booster-step h3 { margin-bottom: 10px; font-size: var(--fs-h5); font-weight: 600; line-height: 1.3; }
  .booster-step p, .booster-story__copy p, .booster-timeline p { color: #fff; font-size: var(--fs-body); font-weight: 300; line-height: 1.55; }

  .booster-story { padding-block: 140px 0; }
  .booster-story__header { padding-bottom: 45px; }
  /* Eyebrow-above-heading, matching the other section headings on the site. */
  .booster-story__eyebrow { display: block; margin-bottom: 0.8rem; color: var(--color-accent); font-size: var(--fs-xs); font-weight: var(--fw-semibold); letter-spacing: 0.09em; text-transform: uppercase; }
  .booster-story__header h2 { margin-bottom: 0; }
  .booster-story__rows { display: grid; gap: clamp(2.5rem, 4vw, 4.5rem); }
  .booster-story__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(460px, 1fr); align-items: stretch; }
  .booster-story__row--reverse { grid-template-columns: minmax(460px, 1fr) minmax(0, 1fr); }
  .booster-story__row > img { width: 100%; height: 100%; min-height: 510px; object-fit: cover; }
  .booster-story__copy { display: flex; min-height: 510px; flex-direction: column; justify-content: center; gap: 16px; padding: clamp(2rem, 4vw, 4.5rem); background: var(--surface-card); }
  .booster-story__block h3 { margin-bottom: 14px; font-size: var(--fs-h4); font-weight: 600; line-height: 1.3; }
  .booster-story__block p { font-size: var(--fs-body); line-height: 1.6; }
  .booster-story__block { max-width: 76ch; }

  .booster-timeline { padding-top: 45px; }
  .booster-timeline > h3 { margin-bottom: 28px; font-size: var(--fs-h4); font-weight: 600; line-height: 1.3; }
  .booster-timeline__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 28px; list-style: none; }
  .booster-timeline__grid li {
    position: relative;
    padding-left: 52px;
  }
  .booster-timeline__grid li > span {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid #ff0b00;
    border-radius: 50%;
    background: #101010;
    color: #fff;
    font-size: var(--fs-2xs);
    font-weight: 700;
    line-height: 1;
  }
  .booster-timeline__grid h4 { margin-bottom: 10px; font-size: var(--fs-h5); font-weight: 600; line-height: 1.3; }

  .booster-quote { margin: 45px 0 0; padding-bottom: 72px; border: 0; }
  .booster-quote p { max-width: 1120px; font-size: var(--fs-lead); font-style: normal; font-weight: 600; line-height: 1.3; }
  .booster-quote cite { display: block; margin-top: 14px; color: #ff0b00; font-size: var(--fs-body); font-style: normal; }

  @keyframes ring-drift { 0%, 100% { transform: translate3d(0, 0, 0) rotate(-30deg); } 50% { transform: translate3d(6px, 0, 0) rotate(-25deg); } }
  @keyframes ring-drift-inner { 0%, 100% { transform: translate3d(0, 0, 0) rotate(73deg); } 50% { transform: translate3d(0, 6px, 0) rotate(77deg); } }

  /* Tilda's 1200 × 600 hero artboard is proportionally upscaled on wide screens. */
  @media (min-width: 1200px) {
    .booster-hero__inner {
      /* Keeps the .container box it already carries. */
      display: block;
    }
