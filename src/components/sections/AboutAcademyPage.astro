---
import { nav, type Lang } from '../../i18n/config';
import LeadForm from './LeadForm.astro';
import VideoEmbed from '../ui/VideoEmbed.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const boosterHref = nav
  .find((item) => item.key === 'about-group')!
  .children!.find((child) => child.key === 'booster')![lang].href;
// Magazine download switches with the active language (DE / EN edition).
const magazineUrl = lang === 'de'
  ? 'https://wamocon-my.sharepoint.com/:b:/p/waleri_moretz/EZUMpxrfjYdPt7g1H7xkQhkBnuG6v-tWKLCPNZIN6Wejlw?e=bQVx7k&download=1'
  : 'https://wamocon-my.sharepoint.com/my?id=%2Fpersonal%2Fwaleri%5Fmoretz%5Fwamocon%5Fcom%2FDocuments%2F01%5FWMC%2F01%20Vertrieb%20und%20Marketing%2F01%2D01%20Marketing%2F01%2D01%2D14%20WMC%20Marketing%2F07%20WMC%20Magazin%2FFinal%20Magazin%20WAMOCON&viewid=6e86f4bd%2D8476%2D4fa5%2Dad74%2D5e1cf1eedc8b';

const copy = {
  de: {
    heroLead: 'Der Weg zum Erfolg',
    heroRest: 'beginnt mit der WAMOCON Academy',
    heroText: 'Unser Bildungszentrum bietet mehr als nur Kurse. Es ist Ihre Startrampe für eine erfolgreiche IT-Karriere. Hier verwandeln wir Lernende in IT-Profis, die bereit sind, die Herausforderungen der heutigen digitalen Welt zu meistern.',
    supportLead: 'Unterstützung',
    supportRest: 'durch erfahrene Dozenten',
    supportParagraphs: [
      'Der theoretische Unterricht wird in verständlicher Form vermittelt, und die angebotenen Übungen und Beispiele aus der Praxis von Branchenexperten helfen dabei, ein tiefes Verständnis für die tatsächlichen Aufgaben eines Testers schnell und einfach zu erlangen.',
      'Auf diese Weise erwerben die Teilnehmer fundiertes Wissen und praktische Fähigkeiten in Kombination mit einem wertvollen Zertifikat. Dies eröffnet zahlreiche Möglichkeiten für Wachstum in der IT-Branche.',
    ],
    advantagesLead: 'Die wichtigsten Vorteile,',
    advantagesRest: 'die die Academy bietet',
    advantages: [
      ['Ausbildung nach internationalen Qualitätsstandards', 'Die WAMOCON Academy GmbH ist für ausgewählte deutschsprachige ISTQB®-Trainingsmaterialien als Trainingsanbieter gelistet. Die Schulungsinhalte orientieren sich an den jeweils geltenden ISTQB®-Lehrplänen.'],
      ['Praxisnahe Lernangebote', 'Unsere Lernangebote vermitteln ein strukturiertes Verständnis zentraler Aspekte des Softwaretestens. Erfahrene IT-Fachleute verbinden Prüfungsvorbereitung mit Beispielen aus der Projektpraxis.'],
      ['Moderne Bildungstechnologien und Bildungsmethoden', 'Jeder Teilnehmer kann seine beruflichen Ziele in einer komfortablen und unterstützenden Lernumgebung erreichen.'],
      ['Individueller Lernansatz', 'Die Anpassung an die individuellen Bedürfnisse der Studierenden ermöglicht es, das Wissensniveau und die beruflichen Ambitionen jedes Einzelnen bestmöglich zu berücksichtigen.'],
      ['Praxisorientierung', 'Die Teilnehmer arbeiten an realen Projekten und Fällen, was zu einem besseren Verständnis des Materials und dem Erwerb der notwendigen Fähigkeiten für die Arbeit in modernen Unternehmen beiträgt.'],
      ['Unterstützung und Mentoring', 'Unsere Dozenten sind erfahrene Fachleute und Praktiker, die nicht nur Wissen vermitteln, sondern die Teilnehmer auf jedem Schritt ihrer Ausbildung unterstützen, indem sie Feedback und Mentoring anbieten.'],
    ],
    advantagesSummary: 'Dank dieser Vorteile bietet die WAMOCON Academy eine umfassende und qualitativ hochwertige Ausbildung für Fachleute, damit sie in der Lage sind, persönliche und berufliche Ziele in der sich schnell verändernden Technologiewelt zu erreichen.',
    wmcTitle: 'WMC-Methode +',
    wmcParagraphs: [
      'Die IT-Welt war noch nie so komplex wie heute, besonders durch den rasanten Fortschritt der künstlichen Intelligenz. Hier kommt die WMC-Methode ins Spiel, die auf über 50 Jahren gebündelter Praxiserfahrung unseres Teams im IT-Qualitätsmanagement aufbaut.',
      'Diese bewährte Methode sorgt dafür, dass auch zukünftige IT-Projekte erfolgreich umgesetzt werden. Vertrauen Sie auf die WMC-Methode, Ihren stabilen Anker in der sich ständig wandelnden IT-Welt.',
    ],
    methodIntro: 'IT-Projekte können manchmal kompliziert sein, aber die WMC-Methode hilft, alles einfacher zu machen. Hier sind die drei wichtigsten Dinge, die du wissen musst:',
    methodColumns: [
      [
        ['Priorisierung', 'Erledige zuerst die wichtigsten Aufgaben. Konzentriere dich auf das Wesentliche und arbeite Schritt für Schritt.'],
        ['Strategische Ausrichtung', 'Achte darauf, dass das Projekt zum übergeordneten Ziel beiträgt. Jedes Detail muss an seinem Platz sein.'],
        ['Stakeholder-Management', 'Sorge dafür, dass alle wichtigen Personen informiert und zufrieden sind.'],
      ],
      [
        ['Zeitmanagement', 'Achte darauf, dass du deine Aufgaben rechtzeitig erledigst. Halte dich an die vorgegebenen Fristen.'],
        ['Ressourcenallokation', 'Verteile deine Ressourcen klug. Nutze deine Mittel effizient und sparsam.'],
        ['Reaktionsfähigkeit', 'Sei bereit, auf Veränderungen schnell zu reagieren. Passe dich an neue Umstände flexibel an.'],
      ],
      [
        ['Risikobewertung', 'Finde heraus, welche Risiken bestehen. Analysiere mögliche Gefahrenquellen.'],
        ['Risikominderung', 'Entwickle Pläne, um Risiken zu verringern. Triff Maßnahmen, um Probleme zu vermeiden.'],
        ['Kontinuierliches Monitoring', 'Überwache die Risiken regelmäßig. Achte ständig auf mögliche Veränderungen.'],
      ],
    ],
    boosterLead: '360°-Karriere-Booster-System',
    boosterRest: 'für IT',
    boosterParagraphs: [
      'WAMOCON hat einen umfassenden Ansatz entwickelt, der alle Aspekte der Arbeit im IT-Testing abdeckt. Dieses 360-Grad-System zur erfolgreichen Karriereentwicklung umfasst eine Reihe von Schritten und ermöglicht es, Herausforderungen zu meistern und den Weg zum Erfolg auf die effektivste Weise zu bewältigen.',
      'Das WAMOCON-Team nutzt dieses System, um die Qualität der Arbeit jedes einzelnen Mitarbeiters zu verbessern, erfolgreiche Tests durchzuführen und IT-Projekte erfolgreich abzuschließen.',
    ],
    graduatesTitle: 'Das sagen erfolgreiche Absolventen',
    graduatesText: 'Wir begleiten dich Schritt für Schritt bei deinem Einstieg in der IT-Branche.',
    participant: 'Teilnehmende der WAMOCON Academy',
    magazineTitle: 'Erfahren Sie mehr über uns',
    magazineText: 'Entdecken Sie unser Magazin mit spannenden Projekten, Schulungen und unserer Unternehmenskultur.',
    magazineCta: 'Magazin herunterladen',
    adviceTitle: 'Beratung erhalten',
    adviceText: 'Rufen Sie uns an +49 (0) 6196 5838312, oder hinterlassen Sie unten Ihre Kontaktdaten, damit wir Sie erreichen und Ihre Fragen beantworten können.',
    loadVideo: 'YouTube-Video laden',
    videoConsent: 'Erst nach Ihrer Auswahl wird eine Verbindung zu YouTube hergestellt.',
    contactTitle: 'Kontakt',
    location: 'Standort',
    phone: 'Telefon',
    hours: 'Öffnungszeiten',
    follow: 'Folgen Sie uns auf sozialen Medien',
    imageAlt: 'WAMOCON Academy Team',
    boosterCta: 'Zum 360° Booster System',
    closeVideo: 'Video schließen',
  },
  en: {
    heroLead: 'The road to success',
    heroRest: 'begins with the WAMOCON Academy',
    heroText: "Our education center offers more than just courses. It's your launch pad for a successful IT career. Here we transform learners into IT professionals who are ready to master the challenges of today's digital world.",
    supportLead: 'Support',
    supportRest: 'from experienced lecturers',
    supportParagraphs: [
      'The theoretical lessons are taught in an understandable way, and the exercises and practical examples provided by industry experts help to quickly and easily gain a deep understanding of the actual tasks of a tester.',
      'In this way, participants acquire in-depth knowledge and practical skills in combination with a valuable certificate. This opens up numerous opportunities for growth in the IT industry.',
    ],
    advantagesLead: 'The most important advantages',
    advantagesRest: 'offered by the Academy',
    advantages: [
      ['Training based on international quality standards', 'WAMOCON Academy GmbH is listed as a training provider for selected German-language ISTQB® training materials. The training content follows the applicable ISTQB® syllabi.'],
      ['Practice-oriented learning opportunities', 'Our learning opportunities provide a structured understanding of key aspects of software testing. Experienced IT professionals combine exam preparation with practical project examples.'],
      ['Modern educational technologies and methods', 'Every participant can achieve their professional goals in a comfortable and supportive learning environment.'],
      ['Individual learning approach', 'The adaptation to the individual needs of the students makes it possible to take the level of knowledge and the professional ambitions of each individual into account in the best possible way.'],
      ['Practical orientation', 'Participants work on real projects and cases, which contributes to a better understanding of the material and the acquisition of the necessary skills for working in modern companies.'],
      ['Support and mentoring', 'Our lecturers are experienced professionals and practitioners who not only impart knowledge, but also support participants at every step of their training by providing feedback and mentoring.'],
    ],
    advantagesSummary: 'Thanks to these advantages, the WAMOCON Academy offers comprehensive and high-quality training for professionals to enable them to achieve personal and professional goals in the rapidly changing world of technology.',
    wmcTitle: 'WMC method +',
    wmcParagraphs: [
      'The IT world has never been as complex as it is today, especially with the rapid advances in artificial intelligence. This is where the WMC method comes into play, building on over 50 years of combined practical experience within our team in IT quality management.',
      'This proven method ensures that future IT projects are also implemented successfully. Put your trust in the WMC method, your stable anchor in the constantly changing IT world.',
    ],
    methodIntro: 'IT projects can sometimes be complicated, but the WMC method helps to make everything simpler. Here are the three most important things you need to know:',
    methodColumns: [
      [
        ['Prioritization', 'Complete the most important tasks first. Concentrate on the essentials and work step by step.'],
        ['Strategic orientation', 'Make sure that the project contributes to the overall goal. Every detail must be in its place.'],
        ['Stakeholder management', 'Make sure that all important people are informed and satisfied.'],
      ],
      [
        ['Time management', 'Make sure that you complete your tasks on time. Stick to the given deadlines.'],
        ['Resource allocation', 'Allocate your resources wisely. Use your resources efficiently and sparingly.'],
        ['Responsiveness', 'Be ready to react quickly to changes. Adapt flexibly to new circumstances.'],
      ],
      [
        ['Risk assessment', 'Find out what risks exist. Analyze possible sources of danger.'],
        ['Risk reduction', 'Develop plans to reduce risks. Take measures to avoid problems.'],
        ['Continuous monitoring', 'Monitor the risks regularly. Pay constant attention to possible changes.'],
      ],
    ],
    boosterLead: '360° career booster system',
    boosterRest: 'for IT',
    boosterParagraphs: [
      'WAMOCON has developed a comprehensive approach that covers all aspects of working in IT testing. This 360-degree system for successful career development comprises a series of steps and enables challenges to be overcome and the path to success to be managed in the most effective way.',
      "The WAMOCON team uses this system to improve the quality of each individual employee's work, carry out successful tests and successfully complete IT projects.",
    ],
    graduatesTitle: 'What successful graduates say',
    graduatesText: 'We accompany you step by step on your entry into the IT industry.',
    participant: 'Participant WAMOCON Academy',
    magazineTitle: 'Find out more about us',
    magazineText: 'Discover our magazine with exciting projects, training courses and our corporate culture.',
    magazineCta: 'Download magazine',
    adviceTitle: 'Get advice',
    adviceText: 'Give us a call +49 (0) 6196 5838312, or leave your contact details below so that we can reach you and answer your questions.',
    loadVideo: 'Load YouTube video',
    videoConsent: 'A connection to YouTube is established only after you choose to load it.',
    contactTitle: 'Contact us',
    location: 'Location',
    phone: 'Phone',
    hours: 'Opening hours',
    follow: 'Follow us on social media',
    imageAlt: 'WAMOCON Academy team',
    boosterCta: 'To the 360° Booster System',
    closeVideo: 'Close video',
  },
} as const;

const c = copy[lang];
// The booster graphic is a localised SVG; Turkish falls back to the English edition.
const boosterImage = lang === 'de'
  ? '/images/academy/tild6230-6463-4530-a631-353632323538__-3_deu-1.svg'
  : '/images/academy/tild6331-6362-4837-b333-343461653664__-3_eng_1.svg';
const videos = [
  ['Natalie', 'Y530fsyTCe4', '/images/academy/testimonial-natalie.jpg'],
  ['Artur', 'GIzxhk4tzmM', '/images/academy/testimonial-artur.jpg'],
  ['Alexander', 'Nun-eNkeeY0', '/images/academy/testimonial-alexander.jpg'],
  ['Olga', 'YI6Jf9-T3_c', '/images/academy/testimonial-olga.jpg'],
  ['Jonathan', 'C6jFQwt6E0o', '/images/academy/testimonial-jonathan.jpg'],
] as const;
---

<div class="academy-about">
  <section class="academy-about-hero page-hero">
    <div class="academy-about-hero__art page-hero__art" aria-hidden="true">
      <img class="academy-about-hero__disc" src="/images/academy/tild6130-3637-4836-a562-333834303031__jn.png" alt="" width="1200" height="1200" />
      <img class="academy-about-hero__ring" src="/images/academy/tild3838-3030-4564-a133-303164373338__hh.png" alt="" width="1200" height="1200" />
    </div>
    <div class="about-container academy-about-hero__inner page-hero__inner">
      <div class="academy-about-hero__copy page-hero__copy" data-reveal>
        <h1><span>{c.heroLead}</span> {c.heroRest}</h1>
        <p>{c.heroText}</p>
      </div>
    </div>
  </section>

  <section class="about-support">
    <img class="about-support__accent" src="/images/academy/tild3730-6132-4863-b462-623032303533__group_11.png" alt="" aria-hidden="true" />
    <div class="about-container about-support__grid">
      <img class="about-support__photo" src="/images/academy/tild3733-3633-4134-b562-656332386666__photo_2021-09-11_23-.png" alt={c.imageAlt} width="1920" height="1280" loading="eager" />
      <div class="about-support__copy" data-reveal>
        <h2><span>{c.supportLead}</span> {c.supportRest}</h2>
        {c.supportParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="about-advantages">
    <div class="about-container">
      <h2 data-reveal><span>{c.advantagesLead}</span> {c.advantagesRest}</h2>
      <div class="about-advantages__grid">
        {c.advantages.map(([title, text]) => (
          <article data-reveal>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
      <p class="about-advantages__summary">{c.advantagesSummary}</p>
    </div>
  </section>

  <section class="about-wmc">
    <div class="about-container about-wmc__intro">
      <div data-reveal>
        <h2>{c.wmcTitle}</h2>
        {c.wmcParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <img src="/images/academy/tild3865-3537-4134-a135-643966323539__close-up-programmer-.jpg" alt="" width="1680" height="1120" loading="lazy" />
    </div>
    <div class="about-container about-wmc__method">
      <h3>{c.methodIntro}</h3>
      <div class="about-wmc__columns">
        {c.methodColumns.map((items, index) => (
          <article>
            <span class="about-wmc__number">{String(index + 1).padStart(2, '0')}</span>
            <div class="about-wmc__items">
              {items.map(([title, text]) => <div><h4>{title}</h4><p>{text}</p></div>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-booster">
    <img class="about-booster__accent" src="/images/academy/tild3730-6132-4863-b462-623032303533__group_11.png" alt="" aria-hidden="true" />
    <div class="about-container about-booster__grid">
      <img class="about-booster__image" src={boosterImage} alt="360° Booster System" width="900" height="900" loading="lazy" />
      <div class="about-booster__copy" data-reveal>
        <h2><span>{c.boosterLead}</span> {c.boosterRest}</h2>
        {c.boosterParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="about-booster__cta" href={boosterHref}>
          {c.boosterCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="about-graduates">
    <div class="about-container">
      <h2>{c.graduatesTitle}</h2>
      <p class="about-graduates__lead">{c.graduatesText}</p>
      <div class="about-graduates__grid">
        {videos.map(([name, id, poster]) => (
          <article>
            <VideoEmbed
              videoId={id}
              title={name}
              poster={poster}
              lang={lang}
              channel={c.participant}
            />
            <h3>{name}</h3>
            <p>{c.participant}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-magazine">
    <div class="about-container about-magazine__panel">
      <img class="about-magazine__cover" src="/images/academy/tild6438-6631-4663-a338-633332663664____2024-12-05__163323.png" alt="WAMOCON Academy Magazin" width="1200" height="1600" loading="lazy" />
      <div class="about-magazine__copy">
        <h2>{c.magazineTitle}</h2>
        <p>{c.magazineText}</p>
        <a class="about-button about-button--magazine" href={magazineUrl} target="_blank" rel="noopener">{c.magazineCta}</a>
      </div>
      <img class="about-magazine__badge" src="/images/badge-zukunft.webp" alt="Unternehmen der Zukunft" width="1052" height="1524" loading="lazy" />
    </div>
  </section>


</div>

<style>
  .academy-about { --about-gutter: var(--container-pad); background: #101010; color: #fff; overflow: hidden; }
  .about-container { width: 100%; max-width: var(--container-max); margin-inline: auto; padding-inline: var(--about-gutter); }
  .academy-about h1, .academy-about h2, .academy-about h3, .academy-about h4 { overflow-wrap: normal; }
  .academy-about p { font-weight: 300; line-height: 1.42; }
  .academy-about h2 { font-size: var(--fs-h2); line-height: 1.14; }
  .academy-about h2 span, .academy-about-hero h1 span { color: var(--color-accent); }

  /* Hero geometry (height, alignment, padding, copy width, type sizes) is
     owned by .page-hero in global.css — do not restate it here. */
  /* Decorative renders are sized from the hero's HEIGHT, not the viewport
     width. A vw-sized square overflowed the frame on wide screens, so the
     shape was sliced off and the space it should have filled read as an empty
     gap. Height-bounding keeps the whole render inside at every width, which
     also makes the per-breakpoint width ladders unnecessary. */
  /* Centred in the art box (see .page-hero__art); offsets off 50% keep the
     layered composition. */
  .academy-about-hero__disc,
  .academy-about-hero__ring { will-change: transform; }
  .academy-about-hero__disc {
    left: 58%;
    max-height: min(80%, 450px);
    max-width: 64%;
    transform: rotate(273deg);
    animation: about-disc-drift 11s ease-in-out infinite alternate;
  }
  .academy-about-hero__ring {
    left: 32%;
    top: 56%;
    max-height: min(54%, 305px);
    max-width: 44%;
    transform: rotate(73deg);
    animation: about-ring-drift 8s ease-in-out infinite alternate;
  }

  .about-support { position: relative; padding-block: clamp(120px, 10vw, 180px) 0; }
  .about-support__grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: clamp(54px, 7vw, 128px); align-items: center; }
  /* The group photo is wide and shallow; a tall fixed height cropped people out
     of the left and right edges. A 4:3 box with the crop biased to the top of
     the frame keeps everyone in shot. */
  .about-support__photo { width: 100%; height: auto; max-height: clamp(400px, 34vw, 560px); aspect-ratio: 4 / 3; object-fit: cover; object-position: center 28%; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .about-support__copy h2 { max-width: 620px; margin-bottom: 34px; }
  .about-support__copy p { max-width: 700px; margin-bottom: 18px; font-size: var(--fs-body); line-height: 1.5; }
  .about-support__accent { position: absolute; right: -72px; top: -55px; width: clamp(190px, 16vw, 290px); transform: rotate(-22deg); animation: about-curve-drift 9s ease-in-out infinite alternate; will-change: transform; }

  .about-advantages { padding-block: clamp(120px, 10vw, 180px); }
  .about-advantages h2 { max-width: 900px; margin-bottom: 54px; }
  .about-advantages__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 2.5vw, 40px); }
  .about-advantages__grid article { min-height: 280px; padding: clamp(34px, 3vw, 50px); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); transition: transform var(--dur-med) var(--ease-out), border-color var(--dur-med) var(--ease-out), background var(--dur-med) var(--ease-out); }
  .about-advantages__grid article:hover { transform: translateY(-4px); border-color: var(--border-strong); background: var(--surface-card-hover); }
  .about-advantages__grid h3 { margin-bottom: 16px; font-size: var(--fs-h4); line-height: 1.3; }
  .about-advantages__grid p { font-size: var(--fs-lead); line-height: 1.55; }
  .about-advantages__summary { margin: 45px 0 28px; max-width: 1120px; font-size: var(--fs-lead); line-height: 1.55; }
  .about-button { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-h); padding-inline: var(--btn-pad-x); border-radius: var(--radius-pill); background: var(--color-accent-surface); color: #fff; font-size: var(--fs-2xs); font-weight: 600; transition: background .18s, transform .18s; }
  .about-button--courses { width: 260px; }
  .about-button--magazine { width: 200px; border-radius: 0; font-size: var(--fs-sm); }
  .about-button:hover { background: var(--color-accent-hover); transform: translateY(-2px); }

  .about-wmc { padding-block: 0; }
  .about-wmc__intro { display: grid; grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr); gap: clamp(54px, 7vw, 128px); align-items: center; }
  .about-wmc__intro h2 { margin-bottom: 32px; overflow-wrap: normal; text-wrap: balance; }
  .about-wmc__intro p { max-width: 690px; margin-bottom: 20px; font-size: var(--fs-body); line-height: 1.5; }
  .about-wmc__intro img { width: 100%; height: clamp(420px, 34vw, 580px); object-fit: cover; }
  .about-wmc__method { margin-top: clamp(55px, 6vw, 90px); }
  .about-wmc__method > h3 { max-width: 1260px; margin-bottom: 38px; font-size: var(--fs-h4); line-height: 1.35; }
  .about-wmc__columns { display: grid; grid-template-columns: repeat(3, 1fr); }
  .about-wmc__columns > article { border-left: 1px solid rgba(255,255,255,.65); }
  .about-wmc__columns > article:last-child { border-right: 1px solid rgba(255,255,255,.65); }
  .about-wmc__number { display: block; padding: 20px 20px 16px; border-bottom: 1px solid rgba(255,255,255,.65); color: var(--color-accent); font-size: var(--fs-h3); font-weight: 700; line-height: 1; }
  .about-wmc__items { display: grid; gap: 30px; padding: clamp(28px, 2.8vw, 46px); }
  .about-wmc__items h4 { margin-bottom: 8px; font-size: var(--fs-body); line-height: 1.3; }
  .about-wmc__items p { font-size: var(--fs-sm); line-height: 1.3; }

