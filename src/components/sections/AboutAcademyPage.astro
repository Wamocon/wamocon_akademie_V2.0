<script>
  type ConsentWindow = Window & {
    wamoconConsent?: {
      hasExternalMedia?: () => boolean;
      open?: () => void;
      grantExternalMedia?: () => void;
    };
  };

  let pendingVideoButton: HTMLButtonElement | null = null;

  const loadConsentedVideo = (button: HTMLButtonElement) => {
    const src = button.dataset.consentSrc;
    const frame = button.closest<HTMLElement>('.about-video');
    if (!src || !frame) return;
    if (frame.querySelector('iframe')) return;
    const poster = frame.querySelector<HTMLImageElement>('img');
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = button.dataset.videoTitle || 'YouTube video';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    const stopButton = document.createElement('button');
    stopButton.type = 'button';
    stopButton.className = 'about-video__stop';
    stopButton.textContent = button.dataset.stopLabel || 'Close video';

    const stop = () => {
      iframe.remove();
      stopButton.remove();
      button.hidden = false;
      if (poster) poster.hidden = false;
    };

    button.hidden = true;
    if (poster) poster.hidden = true;
    frame.append(iframe, stopButton);
    stopButton.addEventListener('click', stop);
    window.addEventListener('pagehide', stop, { once: true });
  };

  document.querySelectorAll<HTMLButtonElement>('.about-video__consent[data-consent-src]').forEach((button) => {
    button.addEventListener('click', () => {
      const consent = (window as ConsentWindow).wamoconConsent;
      if (consent?.hasExternalMedia?.()) {
        loadConsentedVideo(button);
        return;
      }
      pendingVideoButton = button;
      if (consent?.grantExternalMedia) {
        consent.grantExternalMedia();
        return;
      }
      consent?.open?.();
    });
  });

  window.addEventListener('wamocon:consent', (event) => {
    const detail = (event as CustomEvent<{ externalMedia?: boolean }>).detail;
    if (detail?.externalMedia && pendingVideoButton) loadConsentedVideo(pendingVideoButton);
    if (!detail?.externalMedia) {
      document.querySelectorAll<HTMLButtonElement>('.about-video__stop').forEach((button) => button.click());
    }
    pendingVideoButton = null;
  });
</script>
