---
import { courses, dates } from '../../data/academy';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
  showAllDateGroups?: boolean;
}

const { lang, showAllDateGroups = false } = Astro.props;
const dateData = dates[lang];
const visibleDateGroups = showAllDateGroups ? dateData.groups : dateData.groups.slice(-1);
---

<div class="courses-grid">
  {
    courses.map((course) => (
      <article class="course-card" data-reveal>
        <span>{course.type[lang]}</span>
        <h3>{course.title[lang]}</h3>
        <dl>
          <div>
            <dt>{lang === 'de' ? 'Dauer' : 'Duration'}</dt>
            <dd>{course.duration[lang]}</dd>
          </div>
          <div>
            <dt>{lang === 'de' ? 'Format' : 'Format'}</dt>
            <dd>{course.format[lang]}</dd>
          </div>
        </dl>
      </article>
    ))
  }
</div>

<aside class="dates-card" data-reveal>
  <div>
    <span class="eyebrow">{lang === 'de' ? 'Termine im Überblick' : 'Dates at a glance'}</span>
    <h3>{dateData.title}</h3>
  </div>
  <div class="dates-card__groups">
    {
      visibleDateGroups.map((group) => (
        <section class="dates-card__group">
          <h4>{group.month}</h4>
          <ul>
            {group.rows.map(([day, status]) => <li><span>{day}</span><strong>{status}</strong></li>)}
          </ul>
        </section>
      ))
    }
  </div>
</aside>

<style>
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }

  .course-card,
  .dates-card {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    background: #171717;
    color: #fff;
  }

  .course-card {
    position: relative;
    display: grid;
    min-height: 220px;
    gap: 1.25rem;
    align-content: space-between;
    overflow: hidden;
    padding: clamp(1.4rem, 2.3vw, 2.25rem);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .course-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform 240ms ease;
  }

  .course-card:hover,
  .course-card:focus-within {
    border-color: rgba(255, 11, 0, 0.72);
    background: #1d1d1d;
    transform: translateY(-4px);
  }

  .course-card:hover::before,
  .course-card:focus-within::before {
    transform: scaleX(1);
  }

  .course-card > span {
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
  }

  .course-card h3 {
    max-width: 18ch;
    font-size: clamp(1.2rem, 1.5vw, 1.55rem);
    line-height: 1.15;
  }

  .course-card dl {
    display: grid;
    gap: 0.55rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .course-card div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-top: 0.55rem;
  }

  .course-card dt {
    font-weight: var(--fw-semibold);
  }

  .dates-card {
    display: grid;
    grid-template-columns: minmax(260px, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(2rem, 5vw, 6rem);
    margin-top: clamp(1.5rem, 3vw, 3rem);
    padding: clamp(1.5rem, 3.5vw, 3.5rem);
  }

  .dates-card h3 {
    margin-top: 0.7rem;
  }

  .dates-card h4 {
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
    margin-top: 0.45rem;
  }

  .dates-card__groups {
    display: grid;
    gap: 1.1rem;
  }

  .dates-card__group {
    display: grid;
    gap: 0.75rem;
  }

  .dates-card ul {
    display: grid;
    gap: 0.75rem;
  }

  .dates-card li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding-bottom: 0.75rem;
  }

  .dates-card strong {
    color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .course-card {
      min-height: 180px;
    }

    .dates-card {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .course-card,
    .course-card::before {
      transition-duration: 0.01ms;
    }
  }
</style>
