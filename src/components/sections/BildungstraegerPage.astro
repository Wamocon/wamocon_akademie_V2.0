  const sin = Math.sin(angle);
  const side = cos > 0.3 ? 'r' : cos < -0.3 ? 'l' : sin < 0 ? 't' : 'b';
  return {
    ...sector,
    side,
    sx: Math.round(500 + cos * 300),
    sy: Math.round(400 + sin * 320),
    x: (50 + cos * 30).toFixed(2),
    y: (50 + sin * 40).toFixed(2),
  };
});
