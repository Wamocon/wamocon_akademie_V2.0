  [c.proofRows.validity, validity],
  [c.proofRows.measures, approved ? c.measuresCount(bt.massnahmen.length) : c.measuresNone],
].filter(([, value]) => value) as Array<[string, string]>;
const hasCertificate = bt.zertifikatDatei.trim() !== '';
const certificateIsPdf = zertifikatIstPdf();
const certificateHasSize = bt.zertifikatBreite !== null && bt.zertifikatHoehe !== null;

