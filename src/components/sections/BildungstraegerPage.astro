          <p class="bt-showcase__text">{c.showcaseText}</p>
          <ul class="bt-showcase__formats">
            {[...new Set(bt.massnahmenGeplant.map((m) => m.format))].map((format) => <li>{c.format[format]}</li>)}
          </ul>
          <p class:list={['bt-showcase__status', { 'bt-showcase__status--open': !approved }]}>
            {approved ? c.showcaseStatusApproved : c.showcaseStatusPlanned}
          </p>
          <div class="bt-showcase__actions">
            <Button href={`#${formAnchor}`}>{cta}</Button>
          </div>
        </div>
        <div class="bt-showcase__stages">
          <h3>{c.showcaseStagesLabel}</h3>
          <ol>
            {bt.seminar.etappen.map(([from, to], index) => (
              <li>
                <span class="bt-steps__number">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <p>{c.stageRange(from, to)}</p>
                  <h4>{c.showcaseStages[index]}</h4>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </article>
    </div>
  </section>

  <section class="section bt-calendar" id="termine" aria-labelledby="bt-calendar-title">
    <div class="container bt-calendar__grid">
      <div class="bt-calendar__copy" data-reveal>
        <p class="eyebrow">{c.calEyebrow}</p>
        <h2 id="bt-calendar-title"><span>{c.calLead(ns.jahr)}</span> {c.calRest}</h2>
        <p class="bt-calendar__text">{startSet ? c.calTextSet(formatDate(ns.datum)) : c.calTextPending}</p>
        <ul class="bt-calendar__facts">
          <li>{c.calLast(ns.jahr)}</li>
          <li>{c.calSeats(ns.plaetzeVorOrt)}</li>
        </ul>
        <Button href={`#${formAnchor}`}>{cta}</Button>
      </div>
      <div class:list={['bt-calendar__board', { 'is-pending': !startSet }]} data-reveal>
        <div class="bt-calendar__months" aria-hidden={startSet ? undefined : 'true'}>
          {calendarMonths.map((month) => (
            <table class="bt-cal">
              <caption>{month.label}</caption>
              <thead>
                <tr>{c.weekdays.map((day) => <th scope="col">{day}</th>)}</tr>
              </thead>
              <tbody>
                {month.weeks.map((week) => (
                  <tr>
                    {week.map((day) =>
                      day === month.startDay ? (
                        <td class="is-start"><span class="bt-cal__label">{c.calStart}: </span>{day}</td>
                      ) : (
                        <td>{day ?? ''}</td>
                      ),
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          ))}
        </div>
        {!startSet && <p class="bt-calendar__pending"><span>{c.calPending}</span></p>}
      </div>
    </div>
  </section>

  <section class="section bt-benefits" aria-labelledby="bt-benefits-title">
    <div class="container">
      <div class="bt-head" data-reveal>
        <h2 id="bt-benefits-title"><span>{c.benefitsLead}</span> {c.benefitsRest}</h2>
      </div>
      <div class="bt-cards bt-cards--three">
        {c.benefits.map(([title, text], index) => (
          <article class="bt-card" data-reveal>
            <span class="bt-steps__number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bt-trust" aria-label={c.trustLabel}>
    <ul class="container bt-trust__list">
      {trust.map(([value, label]) => (
        <li data-reveal>
          <strong>{value}</strong>
          <span>{label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section bt-meaning" aria-labelledby="bt-meaning-title">
    <div class="container">
      <div class="bt-head" data-reveal>
        <h2 id="bt-meaning-title"><span>{c.meaningLead}</span> {c.meaningRest}</h2>
        <p>{c.meaningIntro}</p>
      </div>
      <div class="bt-meaning__grid">
        <article class="bt-panel" data-reveal>
          <p class="bt-status bt-status--done">{c.providerStatus}</p>
          <h3>{c.providerTitle}</h3>
          <p>{c.providerText}</p>
          <div class="bt-panel__meaning">
            <h4>{c.meaningFor}</h4>
            <p>{c.providerMeaning}</p>
          </div>
        </article>
        <article class:list={['bt-panel', { 'bt-panel--open': !approved }]} data-reveal>
          <p class:list={['bt-status', approved ? 'bt-status--done' : 'bt-status--open']}>
            {approved ? c.measureStatusApproved : c.measureStatusPlanned}
          </p>
          <h3>{c.measureTitle}</h3>
          <p>{c.measureText}</p>
          <div class="bt-panel__meaning">
            <h4>{c.meaningFor}</h4>
            <p>{approved ? c.measureMeaningApproved : c.measureMeaningPlanned}</p>
          </div>
        </article>
      </div>
      <p class="bt-rule" data-reveal>{c.meaningRule}</p>
    </div>
  </section>

  <section class="section bt-steps" aria-labelledby="bt-steps-title">
    <div class="container">
      <div class="bt-head" data-reveal>
        <h2 id="bt-steps-title"><span>{c.stepsLead}</span> {c.stepsRest}</h2>
      </div>
      <ol class="bt-steps__list">
        {c.steps.map(([title, text], index) => (
          <li data-reveal>
            <span class="bt-steps__number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bt-support" aria-labelledby="bt-support-title">
    <div class="container">
      <div class="bt-head" data-reveal>
        <h2 id="bt-support-title"><span>{c.supportLead}</span> {c.supportRest}</h2>
        <p>{c.supportIntro}</p>
      </div>
      <div class="bt-cards bt-cards--three">
        {c.support.map(([title, text]) => (
          <article class="bt-card" data-reveal>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bt-courses" id={coursesAnchor} aria-labelledby="bt-courses-title">
    <div class="container">
      <div class="bt-head" data-reveal>
        <h2 id="bt-courses-title">
          <span>{approved ? c.coursesLeadApproved : c.coursesLeadPlanned}</span> {c.coursesRest}
        </h2>
        <p class:list={['bt-notice', { 'bt-notice--open': !approved }]}>
          {approved ? c.coursesNoteApproved : c.coursesNotePlanned}
        </p>
      </div>

      {approved ? (
        <div class="bt-course-grid">
          {bt.massnahmen.map((m) => (
            <article class="bt-course" data-reveal>
              <span class="bt-course__format">{c.format[m.format]}</span>
              <span class="bt-course__badge">{m.dauer}</span>
              <h3>{m.name}</h3>
              <dl class="bt-course__facts">
                <div><dt>{c.measureNumber}</dt><dd>{m.massnahmenummer}</dd></div>
                <div><dt>{c.place}</dt><dd>{m.ort}</dd></div>
                <div><dt>{c.degree}</dt><dd>{m.abschluss}</dd></div>
              </dl>
              <p class="bt-course__note">{c.fundingNote}</p>
            </article>
          ))}
        </div>
      ) : (
        plannedGroups.map((group) => (
          <div class="bt-course-group">
            <p class="bt-course-group__label">{c.variants}</p>
            <div class="bt-course-grid">
              {group.variants.map((m) => (
                <article class="bt-course" data-reveal>
                  <span class="bt-course__format">{c.format[m.format]}</span>
                  <span class="bt-course__badge">{c.statusPlanned}</span>
                  <h3>{group.name}</h3>
                  <p class="bt-course__meta">{bt.seminar.tage} {c.showcaseDays}, {bt.seminar.titel}</p>
                  <p class="bt-course__note">{c.planNote}</p>
                </article>
              ))}
            </div>
          </div>
        ))
      )}

      <div class="bt-courses__actions" data-reveal>
        <Button href={`#${formAnchor}`}>{cta}</Button>
      </div>
    </div>
  </section>

  <section class="section bt-why" aria-labelledby="bt-why-title">
    <div class="container">
      <div class="bt-head" data-reveal>
        <h2 id="bt-why-title"><span>{c.whyLead}</span> {c.whyRest}</h2>
      </div>
      <div class="bt-cards bt-cards--two">
        {c.why.map(([title, text]) => (
          <article class="bt-card" data-reveal>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section surface-light bt-proof" aria-labelledby="bt-proof-title">
    <div class:list={['container', 'bt-proof__grid', { 'bt-proof__grid--single': !hasCertificate || certificateIsPdf }]}>
      <div data-reveal>
        <div class="bt-head">
          <h2 id="bt-proof-title"><span>{c.proofLead}</span> {c.proofRest}</h2>
        </div>
        {showMark && (
          <img
            class="bt-proof__mark"
            src={bt.zeichenDatei}
            alt={c.markAlt}
            width={bt.zeichenBreite ?? undefined}
            height={bt.zeichenHoehe ?? undefined}
            loading="lazy"
          />
        )}
        <dl class="bt-proof__list">
          <div>
            <dt>{c.proofRows.body}</dt>
            <dd>
              {bt.fachkundigeStelle.name}, {bt.fachkundigeStelle.ort}<br />
              <a href={bt.fachkundigeStelle.url} target="_blank" rel="noopener noreferrer">{bt.fachkundigeStelle.urlLabel}</a>
            </dd>
          </div>
          {proofRows.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        {hasCertificate && certificateIsPdf && (
          <div class="bt-proof__actions">
            <Button href={bt.zertifikatDatei} target="_blank">{c.certPdf}</Button>
          </div>
        )}
      </div>
      {hasCertificate && !certificateIsPdf && (
        <figure class="bt-proof__certificate" data-reveal>
          <img
            src={bt.zertifikatDatei}
            alt={c.certAlt}
            width={certificateHasSize ? bt.zertifikatBreite! : undefined}
            height={certificateHasSize ? bt.zertifikatHoehe! : undefined}
            loading="lazy"
          />
        </figure>
      )}
    </div>
  </section>

  <section class="section bt-groups" aria-labelledby="bt-groups-title">
    <div class="container">
      <div class="bt-head" data-reveal>
        <h2 id="bt-groups-title"><span>{c.groupsLead}</span> {c.groupsRest}</h2>
      </div>
      <div class="bt-cards bt-cards--three">
        {c.groups.map(([title, text]) => (
          <article class="bt-card" data-reveal>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqSection
    heading={c.faqHeading}
    intro={c.faqIntro}
    items={faq}
    lang={lang}
    bylineName={bt.pruefer}
    bylineRole={c.bylineRole}
    lastReviewed={bt.pruefdatum || undefined}
  />

  <LeadForm
    lang={lang}
    type="bildungstraeger"
    title={cta}
    intro={approved ? c.formIntroApproved : c.formIntroPlanned}
    anchorId={formAnchor}
  />
</div>

<style>
  /* Section rhythm, surfaces, cards and type all reuse the tokens and the
     patterns of the home page (steps, facts, compare panels), the About page
     (advantages grid) and the course catalogue (course cards). Where a block
     mirrors one of those, the source is named next to it. */
  .bt-page { background: var(--color-bg); }

  /* ---- Hero ---------------------------------------------------------------
     Geometry is owned by .page-hero in global.css; only the art and the
     kicker are styled here (pattern: IstqbCertificationPage hero). */
  .bt-hero__kicker,
  .bt-hero__mark span {
    color: var(--color-accent);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .page-hero .bt-hero__kicker,
  .page-hero .bt-hero__mark { margin-bottom: 1.25rem; font-size: var(--fs-sm); }
  .bt-hero__mark { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); }
  /* The GZQ mark is embedded unchanged: height-bounded only, width follows the
     file's own aspect ratio, no crop, no filter. */
  /* If the GZQ usage rules set a minimum size, that size wins over this cap. */
  .bt-hero__mark img { width: auto; height: auto; max-height: 48px; }
  .bt-hero h1 span { color: var(--color-accent); }
  .bt-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: 1.75rem; }
  .bt-hero__ring,
  .bt-hero__curve { will-change: transform; }
  .bt-hero__ring {
    left: 56%;
    max-height: min(84%, 470px);
    max-width: 58%;
    opacity: 0.9;
    animation: bt-ring-drift 10s ease-in-out infinite alternate;
  }
  .bt-hero__curve {
    left: 38%;
    top: 62%;
    max-height: min(48%, 280px);
    max-width: 46%;
    animation: bt-curve-drift 9s ease-in-out infinite alternate;
  }

  /* ---- Showcase: the 45-day seminar ----------------------------------------
     The page's one feature panel. Same card surface, radius and elevation as
     every other card, lifted by the hero's own red glow and an accent border
     so it reads as the headline offer. Stage badges reuse .bt-steps__number. */
  .bt-showcase { padding-block: 0 var(--space-lg); }
  .bt-showcase__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 5rem);
    overflow: hidden;
    padding: clamp(28px, 4vw, 64px);
    border: 1px solid var(--color-accent-surface);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60% 70% at 0% 0%, var(--glow-top), transparent 70%),
      var(--surface-card);
    box-shadow: var(--shadow-card), var(--shadow-accent);
  }
  .bt-showcase__days { display: flex; align-items: baseline; gap: var(--space-xs); margin-top: var(--space-sm); }
  .bt-showcase__days strong {
    color: var(--color-accent);
    font-size: var(--fs-display);
    font-weight: var(--fw-bold);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }
  .bt-showcase__days span { color: var(--color-text); font-size: var(--fs-h3); font-weight: var(--fw-semibold); }
  .bt-showcase h2 { margin-top: var(--space-xs); font-size: var(--fs-h2); }
  .bt-showcase__sub { margin-top: var(--space-sm); color: var(--color-text); font-size: var(--fs-lead); line-height: var(--lh-snug); }
  .bt-showcase__text { max-width: 62ch; margin-top: var(--space-sm); color: var(--color-muted); font-size: var(--fs-body); }
  .bt-showcase__formats { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-md); }
  .bt-showcase__formats li {
    padding: 0.35rem 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .bt-showcase__status {
    margin-top: var(--space-sm);
    padding-left: var(--space-sm);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text);
    font-size: var(--fs-sm);
  }
  .bt-showcase__actions { margin-top: var(--space-md); }
  .bt-showcase__stages {
    align-self: center;
    padding: clamp(22px, 2.4vw, 36px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.035);
  }
  .bt-showcase__stages > h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .bt-showcase__stages ol { display: grid; gap: var(--space-sm); }
  .bt-showcase__stages li { display: flex; align-items: center; gap: var(--space-sm); }
  .bt-showcase__stages li + li { padding-top: var(--space-sm); border-top: 1px solid var(--border-subtle); }
  .bt-showcase__stages p { color: var(--color-muted); font-size: var(--fs-sm); }
  .bt-showcase__stages h4 { font-size: var(--fs-h5); }
  .bt-showcase .bt-steps__number { flex: 0 0 auto; }

  /* ---- Calendar: next seminar start ----------------------------------------
     A real month grid. While the date is open the grid is greyed out under a
     "date coming soon" label, so the scarcity message ("one start left this
     year") stays truthful without inventing a date. */
  .bt-calendar { background: var(--color-bg-elevated); }
  .bt-calendar__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .bt-calendar__copy h2 { margin-top: var(--space-sm); font-size: var(--fs-h1); line-height: var(--lh-tight); }
  .bt-calendar__copy h2 span { display: block; color: var(--color-accent); }
  .bt-calendar__text { max-width: 56ch; margin-top: 1.2rem; color: var(--color-muted); font-size: var(--fs-lead); line-height: var(--lh-relaxed); }
  .bt-calendar__facts { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-block: var(--space-md); }
  .bt-calendar__facts li {
    padding: 0.4rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .bt-calendar__facts li:first-child { border-color: var(--color-accent-surface); background: var(--color-accent-surface); }
  .bt-calendar__board {
    position: relative;
    padding: clamp(20px, 2.4vw, 36px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
  }
  .bt-calendar__months { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-md); }
  .bt-cal { width: 100%; border-collapse: separate; border-spacing: 4px; text-align: center; font-variant-numeric: tabular-nums; }
  .bt-cal caption {
    padding: 0 4px var(--space-xs);
    color: var(--color-text);
    font-size: var(--fs-h5);
    font-weight: var(--fw-semibold);
    text-align: left;
  }
  .bt-cal th { padding-bottom: 4px; color: var(--color-muted); font-size: var(--fs-xs); font-weight: var(--fw-semibold); }
  .bt-cal td {
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text);
    font-size: var(--fs-sm);
  }
  .bt-cal td:empty { background: transparent; }
  .bt-cal td.is-start {
    background: var(--color-accent-surface);
    font-weight: var(--fw-bold);
    box-shadow: var(--shadow-accent);
  }
  .bt-cal__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .is-pending .bt-cal { opacity: 0.35; filter: grayscale(1); }
  .bt-calendar__pending { position: absolute; inset: 0; display: grid; place-items: center; padding: var(--space-sm); pointer-events: none; }
  .bt-calendar__pending span {
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--color-accent-surface);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    text-align: center;
    box-shadow: var(--shadow-accent);
  }

  /* Benefit cards carry the step badge so the six reasons read as a list. */
  .bt-benefits .bt-card .bt-steps__number { margin-bottom: var(--space-sm); }

  /* ---- Trust bar (pattern: AcademyHome .online-course__facts) ------------- */
  .bt-trust { padding-block: 0 var(--space-lg); }
  .bt-trust__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(18px, 1.6vw, 30px);
  }
  .bt-trust__list li {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 0.8vw, 14px);
    padding: clamp(22px, 1.8vw, 34px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
  }
  .bt-trust__list strong {
    color: var(--color-accent);
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .bt-trust__list span { color: var(--color-muted); font-size: var(--fs-sm); line-height: var(--lh-snug); }

  /* ---- Section heads (pattern: AcademyHome .steps .section-head) ---------- */
  .bt-head { max-width: 1100px; margin-bottom: clamp(2rem, 3vw, 3rem); }
  .bt-head h2 { margin: 0; font-size: var(--fs-h1); line-height: var(--lh-tight); }
  .bt-head h2 span { display: block; color: var(--color-accent); }
  .bt-head p {
    max-width: 68ch;
    margin-top: 1.2rem;
    color: var(--color-muted);
    font-size: var(--fs-lead);
    line-height: var(--lh-relaxed);
  }

  /* ---- Meaning panels (pattern: AcademyHome .compare-panel) --------------- */
  .bt-meaning__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 2.5vw, 40px); }
  .bt-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: clamp(28px, 2.5vw, 44px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
  }
  /* The open half stays recessive, like the "without" comparison panel. */
  .bt-panel--open { background: rgba(255, 255, 255, 0.035); box-shadow: none; }
  .bt-panel h3 { font-size: var(--fs-h3); }
  .bt-panel > p:not(.bt-status) { color: var(--color-muted); font-size: var(--fs-body); }
  .bt-panel__meaning {
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border-subtle);
  }
