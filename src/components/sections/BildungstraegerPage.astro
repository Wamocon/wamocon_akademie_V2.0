  .bt-quiz__result { display: grid; gap: var(--space-sm); justify-items: start; padding: var(--space-md); border-left: 3px solid var(--color-accent); border-radius: var(--radius-md); background: rgba(255, 255, 255, 0.04); animation: bt-pop var(--dur-med) var(--ease-out); }
  .bt-quiz__result strong { color: var(--color-accent); font-size: var(--fs-h4); }
  .bt-quiz__result p { margin-top: 4px; }

  /* ---- Team photo ------------------------------------------------------------------- */
  .bt-team { position: relative; overflow: hidden; margin-bottom: clamp(24px, 3vw, 48px); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .bt-team img { width: 100%; height: auto; aspect-ratio: 1680 / 681; object-fit: cover; transition: transform var(--dur-slow) var(--ease-out); }
  .bt-team:hover img { transform: scale(1.03); }
  .bt-team figcaption { position: absolute; left: var(--space-sm); bottom: var(--space-sm); padding: 0.45rem 1rem; border-radius: var(--radius-pill); background: var(--color-bg); font-size: var(--fs-sm); font-weight: var(--fw-semibold); }

  /* ---- Timeline --------------------------------------------------------------------- */
  .bt-timeline { margin-top: clamp(48px, 6vw, 96px); }
  .bt-timeline .bt-head h3 { font-size: var(--fs-h2); line-height: var(--lh-tight); }
  .bt-timeline .bt-head h3 span { color: var(--color-accent); }
  .bt-timeline__list {
    position: relative;
    display: grid;
    grid-auto-columns: minmax(200px, 1fr);
    grid-auto-flow: column;
    gap: var(--space-sm);
    overflow-x: auto;
    padding: 28px 2px 8px;
    scroll-snap-type: x mandatory;
  }
  .bt-timeline__list::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 0;
    width: max(100%, calc(var(--n, 9) * 212px));
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-surface), var(--color-accent) 50%, var(--color-accent-surface));
    background-size: 200% 100%;
    animation: bt-flow 6s linear infinite;
  }
  .bt-timeline__list li { position: relative; scroll-snap-align: start; padding: var(--space-sm); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-card); }
  .bt-timeline__list li::before { content: ''; position: absolute; top: -24px; left: var(--space-sm); width: 12px; height: 12px; border-radius: 50%; background: var(--color-accent-surface); box-shadow: 0 0 0 4px rgba(244, 14, 14, 0.18); }
  .bt-timeline__year { display: block; color: var(--color-accent); font-size: var(--fs-h3); font-weight: var(--fw-bold); line-height: 1; font-variant-numeric: tabular-nums; }
  .bt-timeline__list p { margin-top: var(--space-xs); color: var(--color-muted); font-size: var(--fs-sm); line-height: var(--lh-snug); overflow-wrap: break-word; hyphens: auto; }

  /* ---- Motion ------------------------------------------------------------------ */
  @keyframes bt-grid { to { background-position: 280px 140px; } }
  @keyframes bt-sheen { 0%, 60% { background-position: 100% 0; } 100% { background-position: -150% 0; } }
  @keyframes bt-flow { to { background-position: -200% 0; } }
  @keyframes bt-pop { from { opacity: 0; transform: translateY(8px); } }
  @keyframes bt-kenburns { from { transform: scale(1.04); } to { transform: scale(1.14) translate3d(-1.5%, -1%, 0); } }
  @keyframes bt-drift { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(12%, 8%, 0) scale(1.15); } }
  @keyframes bt-pulse { 0%, 100% { box-shadow: var(--shadow-accent); } 50% { box-shadow: 0 0 0 6px rgba(244, 14, 14, 0.18), var(--shadow-accent); } }
  @keyframes bt-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @keyframes bt-spin { to { rotate: 360deg; } }
  @keyframes bt-marquee { to { transform: translateX(-100%); } }
  @keyframes bt-dash { to { stroke-dashoffset: -32; } }
  @keyframes bt-ring { 0% { transform: scale(1); opacity: 0.8; } 100% { transform: scale(2.4); opacity: 0; } }

  /* ---- Breakpoints (site ladder: 1200, 1050, 900, 620, 479) --------------------- */
  @media (max-width: 1200px) {
    .bt-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 1050px) {
    .bt-steps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bt-steps__list li:nth-child(2n)::after { content: none; }
    .bt-tiles, .bt-cards, .bt-testi__grid, .bt-groups__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bt-trainer { grid-template-columns: minmax(0, 1fr); }
    .bt-trainer figure { height: auto; min-height: 0; aspect-ratio: 4 / 3; }
    .bt-card--feature { grid-column: span 2; }
  }
  @media (max-width: 900px) {
    .bt-showcase__panel, .bt-calendar__grid, .bt-formats__grid, .bt-fund__grid, .bt-trainers__grid,
    .bt-why__grid, .bt-proof__grid, .bt-proof__grid.has-certificate, .bt-groups__grid, .bt-approved__grid, .bt-entry__grid, .bt-quiz__questions {
      grid-template-columns: minmax(0, 1fr);
    }
    .bt-proof__seal-wrap { justify-items: start; }
    .bt-proof__seal { width: 220px; }
  }
  @media (max-width: 620px) {
    .bt-hero__inner { padding-top: 120px; }
    .bt-hero h1 { font-size: var(--fs-h1); overflow-wrap: break-word; hyphens: auto; }
    .bt-hero__stats { gap: var(--space-sm) var(--space-md); }
    .bt-tiles, .bt-cards, .bt-testi__grid, .bt-steps__list, .bt-why__facts { grid-template-columns: minmax(0, 1fr); }
    .bt-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bt-card--feature { grid-column: auto; }
    .bt-steps__list li::after, .bt-steps__list li:nth-child(2n)::after {
      content: '↓'; top: auto; right: auto; bottom: clamp(-26px, -5vw, -20px); left: 50%; transform: translateX(-50%);
    }
    .bt-steps__list li:last-child::after { content: none; }
    .bt-glance div, .bt-proof__list div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .bt-net svg { display: none; }
    .bt-net figcaption { display: block; }
    .bt-net figcaption span { color: var(--color-muted); font-size: var(--fs-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
    .bt-net figcaption ul { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-xs); }
    .bt-net figcaption li { padding: 0.4rem 0.9rem; border: 1px solid var(--color-accent-surface); border-radius: var(--radius-pill); font-size: var(--fs-sm); }
    .bt-clients__track li { font-size: var(--fs-h4); }
    /* Long labels wrap on a phone; the button's line-height of 1 would stack
       the two lines on top of each other. */
    .bt-page :global(.btn) { width: 100%; padding-block: var(--space-xs); line-height: var(--lh-snug); text-align: center; }
  }
  @media (max-width: 479px) {
    .bt-kpis strong { font-size: var(--fs-h4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-new, .bt-aurora span, .bt-hero__media img, .bt-format::before, .bt-clients__track ul, .bt-net__line,
    .bt-net__pulse, .bt-net__core-ring, .bt-calendar__pending span, .bt-calendar__facts li, .bt-proof__seal::after,
    .is-open .bt-fund__check, .bt-hero::after, .bt-hero h1 span, .bt-timeline__list::before, .bt-quiz__result { animation: none; }
    .bt-net__pulse { opacity: 0; }
  }
</style>

<script>
  // KPI count-up. The final value is already in the HTML (for search engines,
  // AI crawlers and visitors without JavaScript); this only animates up to it
  // once the row scrolls into view.
  const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count-to]'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (counters.length && !reduced && 'IntersectionObserver' in window) {
    const format = new Intl.NumberFormat(document.documentElement.lang || 'de');
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.countTo) || 0;
      const suffix = el.dataset.countSuffix || '';
      const start = performance.now();
      const duration = 1600;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = `${format.format(Math.round(target * eased))}${suffix}`;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        run(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      }),
      { threshold: 0.4 },
    );
    counters.forEach((el) => observer.observe(el));
  }

  // Scroll progress bar.
  const progress = document.querySelector<HTMLElement>('[data-bt-progress]');
  if (progress) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.setProperty('--p', String(max > 0 ? Math.min(1, window.scrollY / max) : 0));
    };
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }, { passive: true });
    update();
  }

  // Spotlight: the card glow follows the pointer. Pointer devices only.
  if (!reduced && window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('.bt-spot').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        card.style.setProperty('--my', `${event.clientY - rect.top}px`);
      });
    });
  }

  // Funding check. Pure orientation, nothing is sent or stored.
  const quiz = document.querySelector<HTMLFormElement>('[data-bt-quiz]');
  if (quiz) {
    const result = quiz.querySelector<HTMLElement>('[data-bt-quiz-result]');
    quiz.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!quiz.reportValidity() || !result) return;
      const data = new FormData(quiz);
      const situation = String(data.get('situation'));
      const residence = String(data.get('residence'));
      const key = residence === 'no' ? 'abroad' : situation === 'unemployed' || situation === 'risk' ? 'good' : 'check';
      result.querySelectorAll<HTMLElement>('[data-result]').forEach((block) => {
        block.hidden = block.dataset.result !== key;
      });
      result.hidden = false;
      result.style.animation = 'none';
      void result.offsetWidth;
      result.style.animation = '';
      result.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
    });
  }
</script>
