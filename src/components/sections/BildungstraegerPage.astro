<script>
  // KPI count-up. The final value is already in the HTML (for search engines,
  // AI crawlers and visitors without JavaScript); this only animates up to it
  // once the row scrolls into view.
  const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count-to]'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (counters.length && !reduced && 'IntersectionObserver' in window) {
    const format = new Intl.NumberFormat(document.documentElement.lang || 'de');
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.countTo) || 0;
      const suffix = el.dataset.countSuffix || '';
      const start = performance.now();
      const duration = 1600;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = `${format.format(Math.round(target * eased))}${suffix}`;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        run(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      }),
      { threshold: 0.4 },
    );
    counters.forEach((el) => observer.observe(el));
  }

  // Scroll progress bar.
  const progress = document.querySelector<HTMLElement>('[data-bt-progress]');
  if (progress) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.setProperty('--p', String(max > 0 ? Math.min(1, window.scrollY / max) : 0));
    };
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }, { passive: true });
    update();
  }

  // Spotlight: the card glow follows the pointer. Pointer devices only.
  if (!reduced && window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('.bt-spot').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        card.style.setProperty('--my', `${event.clientY - rect.top}px`);
      });
    });
  }

  // Industry explorer. The orbit nodes are tabs; one panel shows at a time.
  // It advances on its own while in view, pauses while a panel is hovered or
  // focused, and stops for good once the visitor picks an industry.
  const sectorRoot = document.querySelector<HTMLElement>('[data-sectors]');
  if (sectorRoot) {
    const tabs = Array.from(sectorRoot.querySelectorAll<HTMLButtonElement>('[data-sector-tab]'));
    const panels = Array.from(sectorRoot.querySelectorAll<HTMLElement>('[data-sector-panel]'));
    const beams = Array.from(sectorRoot.querySelectorAll<SVGLineElement>('[data-sector-beam]'));
    const side = sectorRoot.querySelector<HTMLElement>('.bt-explorer__side');
    const bar = sectorRoot.querySelector<HTMLElement>('[data-sector-progress]');
    const orbit = sectorRoot.querySelector<HTMLElement>('[data-orbit]');
    const interval = 5000;
    let current = 0;
    let timer = 0;
    let autoplay = !reduced;
    let visible = false;
    let paused = false;
    const restartBar = () => {
      if (!bar) return;
      bar.style.animation = 'none';
      void bar.offsetWidth;
      bar.style.animation = '';
    };
    const show = (index: number, focus = false) => {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const on = i === current;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === current));
      beams.forEach((beam, i) => beam.classList.toggle('is-active', i === current));
      if (focus) tabs[current].focus();
      restartBar();
    };
    const sync = () => {
      window.clearInterval(timer);
      timer = 0;
      if (autoplay && visible && !paused) {
        timer = window.setInterval(() => show(current + 1), interval);
        restartBar();
      }
      sectorRoot.classList.toggle('is-playing', timer !== 0);
    };
    const pick = (index: number, focus = false) => {
      autoplay = false;
      sync();
      show(index, focus);
    };
    tabs.forEach((tab, i) => tab.addEventListener('click', () => pick(i)));
    sectorRoot.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      const moves: Record<string, number> = { ArrowRight: current + 1, ArrowDown: current + 1, ArrowLeft: current - 1, ArrowUp: current - 1, Home: 0, End: tabs.length - 1 };
      if (!(key in moves)) return;
      event.preventDefault();
      pick(moves[key], true);
    });
    side?.addEventListener('pointerenter', () => { paused = true; sync(); });
    side?.addEventListener('pointerleave', () => { paused = false; sync(); });
    sectorRoot.addEventListener('focusin', () => { paused = true; sync(); });
    sectorRoot.addEventListener('focusout', (event) => {
      if (sectorRoot.contains(event.relatedTarget as Node | null)) return;
      paused = false;
      sync();
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        sync();
      }, { threshold: 0.35 }).observe(sectorRoot);
    }
    // A gentle 3D tilt of the orbit follows the pointer.
    if (orbit && !reduced && window.matchMedia('(hover: hover)').matches) {
      orbit.addEventListener('pointermove', (event) => {
        const rect = orbit.getBoundingClientRect();
        const dx = (event.clientX - rect.left) / rect.width - 0.5;
        const dy = (event.clientY - rect.top) / rect.height - 0.5;
        orbit.classList.add('is-tilting');
        orbit.style.setProperty('--ry', `${(dx * 10).toFixed(2)}deg`);
        orbit.style.setProperty('--rx', `${(-dy * 8).toFixed(2)}deg`);
      });
      orbit.addEventListener('pointerleave', () => {
        orbit.classList.remove('is-tilting');
        orbit.style.removeProperty('--rx');
        orbit.style.removeProperty('--ry');
      });
    }
  }

  // Funding check. Pure orientation, nothing is sent or stored.
  const quiz = document.querySelector<HTMLFormElement>('[data-bt-quiz]');
  if (quiz) {
    const body = quiz.querySelector<HTMLElement>('[data-bt-quiz-body]');
    const questions = quiz.querySelector<HTMLElement>('[data-bt-quiz-questions]');
    const result = quiz.querySelector<HTMLElement>('[data-bt-quiz-result]');
    quiz.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!quiz.reportValidity() || !result || !body || !questions) return;
      const data = new FormData(quiz);
      const situation = String(data.get('situation'));
      const residence = String(data.get('residence'));
      const key = residence === 'no' ? 'abroad' : situation === 'unemployed' || situation === 'risk' ? 'good' : 'check';
      result.querySelectorAll<HTMLElement>('[data-result]').forEach((block) => {
        block.hidden = block.dataset.result !== key;
      });
      // The result takes the place of the questions; focus moves to it so
      // keyboard and screen-reader users land on the answer.
      body.classList.add('is-done');
      questions.inert = true;
      result.hidden = false;
      result.style.animation = 'none';
      void result.offsetWidth;
      result.style.animation = '';
      result.focus({ preventScroll: true });
      result.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
    });
    quiz.querySelector('[data-bt-quiz-back]')?.addEventListener('click', () => {
      if (!result || !body || !questions) return;
      quiz.reset();
      result.hidden = true;
      body.classList.remove('is-done');
      questions.inert = false;
      questions.querySelector<HTMLInputElement>('input')?.focus();
    });
  }
</script>
