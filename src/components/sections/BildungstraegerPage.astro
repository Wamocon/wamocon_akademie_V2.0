  const [year, month] = ym.split('-').map(Number);
  const first = new Date(Date.UTC(year, month - 1, 1));
  const days = new Date(Date.UTC(year, month, 0)).getUTCDate();
  const offset = (first.getUTCDay() + 6) % 7; // weeks start on Monday
  const cells: Array<number | null> = [
    ...Array<null>(offset).fill(null),
    ...Array.from({ length: days }, (_, i) => i + 1),
  ];
  while (cells.length % 7) cells.push(null);
  const weeks = Array.from({ length: cells.length / 7 }, (_, i) => cells.slice(i * 7, i * 7 + 7));
  return {
    key: ym,
    label: new Intl.DateTimeFormat(intlLocale, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(first),
    weeks,
    startDay: startSet && ns.datum.startsWith(ym) ? Number(ns.datum.slice(8, 10)) : null,
  };
});
const stats = home.hero.stats.map((stat) => [stat.value, stat[lang]] as const);
