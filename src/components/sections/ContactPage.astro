---
import { assets } from '../../data/academy';
import { company, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = lang === 'de'
  ? {
      title: 'Kontakt',
      location: 'Standort:',
      phone: 'Telefon:',
      email: 'E-Mail:',
      hours: 'Öffnungszeiten:',
      follow: 'Folgen Sie uns auf sozialen Medien',
      alt: 'Arbeitsplatz der WAMOCON Academy',
      rating: 'Google Bewertung 5,0 von 5 Sternen',
    }
  : {
      title: 'Contact us',
      location: 'Location:',
      phone: 'Phone:',
      email: 'E-Mail:',
      hours: 'Opening hours:',
      follow: 'Follow us on social media',
      alt: 'WAMOCON Academy workplace',
      rating: 'Google rating 5.0 out of 5 stars',
    };

const socialLinks = [
  { label: 'YouTube', href: company.social.youtube, icon: '/images/icon-youtube.svg' },
  { label: 'LinkedIn', href: company.social.linkedin, icon: '/images/icon-linkedin.svg' },
  { label: 'Instagram', href: company.social.instagram, icon: '/images/icon-instagram.svg' },
  { label: 'Facebook', href: company.social.facebook, icon: '/images/icon-facebook.svg' },
];
---

<section class="contact-page" aria-labelledby="contact-title">
  <div class="contact-page__inner container">
    <div class="contact-page__copy">
      <h1 id="contact-title">{copy.title}</h1>
      <p class="contact-page__company">{company.name}</p>

      <address class="contact-page__details">
        <div>
          <strong>{copy.location}</strong>
          <span>{company.street}<br />{company.city}</span>
        </div>
        <div>
          <strong>{copy.phone}</strong>
          <a href={company.phoneHref}>{company.phone}</a>
        </div>
        <div>
          <strong>{copy.email}</strong>
          <a href={company.emailHref}>{company.email}</a>
        </div>
        <div>
          <strong>{copy.hours}</strong>
          <span>{company.hours[lang].map((line) => <>{line}<br /></>)}</span>
        </div>
      </address>

      <div class="contact-page__socials">
        <span>{copy.follow}</span>
        <ul>
          {socialLinks.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
                <img src={social.icon} alt="" width="38" height="38" />
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <figure class="contact-page__media">
      <img src={assets.workspace} alt={copy.alt} width="1680" height="1120" loading="eager" />
      <figcaption aria-label={copy.rating}>
        <svg width="25" height="25" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24s.92 7.54 2.56 10.78l7.97-6.19z" />
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
        </svg>
        <b>{lang === 'de' ? '5,0' : '5.0'}</b>
        <span aria-hidden="true">★★★★★</span>
      </figcaption>
    </figure>
  </div>
  <img class="contact-page__shape" src={assets.accentCurve} alt="" width="300" height="300" aria-hidden="true" />
</section>

<style>
  .contact-page {
    position: relative;
    overflow: hidden;
    background: #101010;
    padding-top: 180px;
  }

  .contact-page__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(390px, .82fr) minmax(0, 1.18fr);
    gap: clamp(3rem, 4.5vw, 6rem);
    align-items: center;
    width: 100%;
    max-width: 1640px;
    min-height: 620px;
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .contact-page__copy {
    min-width: 0;
    max-width: 620px;
    padding-top: 2px;
  }

  .contact-page h1 {
    margin: 0 0 22px;
    font-size: clamp(52px, 3.2vw, 66px);
    line-height: 1.08;
  }

  .contact-page__company {
    margin-bottom: 32px;
    color: #fff;
    font-size: clamp(22px, 1.3vw, 27px);
    line-height: 1.45;
  }

  .contact-page__details {
    display: grid;
    gap: 18px;
    font-style: normal;
  }

  .contact-page__details div {
    display: grid;
  }

  .contact-page__details strong {
    color: var(--color-accent);
    font-size: clamp(19px, 1.05vw, 22px);
    font-weight: var(--fw-regular);
    line-height: 1.4;
  }

  .contact-page__details span,
  .contact-page__details a {
    color: #fff;
    font-size: clamp(22px, 1.28vw, 27px);
    line-height: 1.32;
  }

  .contact-page__socials {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 32px;
  }

  .contact-page__socials > span {
    max-width: 220px;
    color: var(--color-accent);
    font-size: clamp(19px, 1.05vw, 22px);
    line-height: 1.35;
  }

  .contact-page__socials ul {
    display: flex !important;
    flex-flow: row nowrap !important;
    align-items: center;
    gap: 10px;
    width: auto;
  }

  .contact-page__socials li {
    display: block;
    flex: 0 0 auto;
  }

  .contact-page__socials a,
  .contact-page__socials img {
    display: block;
    width: 38px;
    height: 38px;
  }

  .contact-page__media {
    position: relative;
    min-width: 0;
    justify-self: end;
    width: 100%;
    max-width: 840px;
    min-height: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .contact-page__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .contact-page__media figcaption {
    position: absolute;
    left: 24px;
    bottom: 23px;
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0 4px;
    padding: 7px 9px 4px;
    border: 2px solid #fff;
    background: #080808;
    color: #fff;
    font-size: 22px;
    line-height: 1;
  }

  .contact-page__media figcaption svg {
    grid-row: 1 / 3;
  }

  .contact-page__media figcaption b {
    font-weight: var(--fw-semibold);
  }

  .contact-page__media figcaption span {
    color: var(--color-accent);
    font-size: 10px;
    letter-spacing: 1px;
  }

  .contact-page__shape {
    position: absolute;
    z-index: 1;
    right: clamp(38%, 42vw, 47%);
    bottom: -70px;
    width: clamp(170px, 14vw, 270px);
    height: auto;
    opacity: 0.84;
    pointer-events: none;
    transform: rotate(132deg);
    filter: drop-shadow(0 22px 28px rgba(0, 0, 0, 0.52));
    animation: contact-shape-drift 9s ease-in-out infinite;
  }

  @keyframes contact-shape-drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(132deg); }
    50% { transform: translate3d(14px, -16px, 0) rotate(140deg); }
  }

  @media (max-width: 900px) {
    .contact-page {
      padding-top: 120px;
    }

    .contact-page__inner {
      grid-template-columns: 1fr;
      gap: 34px;
      width: 100%;
      min-height: 0;
      padding-inline: var(--container-pad);
    }

    .contact-page__media {
      justify-self: stretch;
      width: 100%;
    }

    .contact-page__shape { display: none; }
  }

  @media (min-width: 2200px) {
    .contact-page__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: 850px;
    }

    .contact-page__media { width: 100%; max-width: 900px; min-height: 0; }
    .contact-page__shape { right: 31%; width: min(13vw, 390px); }
  }

  @media (max-width: 620px) {
    .contact-page__inner {
      padding-inline: 24px;
    }

    .contact-page h1 {
      margin-bottom: 24px;
      font-size: 30px;
    }

    .contact-page__company {
      margin-bottom: 22px;
      font-size: 15px;
    }

    .contact-page__details {
      gap: 12px;
    }

    .contact-page__details strong {
      font-size: 15px;
    }

    .contact-page__details span,
    .contact-page__details a {
      font-size: 18px;
      line-height: 1.28;
    }

    .contact-page__socials {
      gap: 16px;
      margin-top: 24px;
    }

    .contact-page__socials > span {
      max-width: 155px;
      font-size: 18px;
    }

    .contact-page__media {
      width: calc(100% + 24px);
      min-height: 0;
      aspect-ratio: 16 / 9;
      margin-inline: -12px;
    }

    .contact-page__media figcaption {
      left: 24px;
      bottom: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-page__shape { animation: none; }
  }
</style>
