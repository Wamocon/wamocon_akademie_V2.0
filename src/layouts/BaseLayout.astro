---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import ChatWidget from '../components/ui/ChatWidget.astro';
import { assets } from '../data/academy';
import { getAlternateLangUrls, pick } from '../i18n/utils';
import { company, langCodes, localeTags, ogLocales, thanksHref, type Lang } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  showFooterContact?: boolean;
  noindex?: boolean;
  /** Extra JSON-LD nodes (e.g. Course, FAQPage) merged into the page @graph. */
  schema?: Record<string, unknown>[];
  /** Breadcrumb trail, excluding Home which is prepended automatically. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  lang,
  image = assets.hero,
  showFooterContact = true,
  noindex = false,
  schema = [],
  breadcrumbs = [],
} = Astro.props;
const site = Astro.site ?? new URL('https://test-it-academy.com');
const canonical = new URL(Astro.url.pathname, site).href;
const altPaths = getAlternateLangUrls(Astro.url.pathname, lang);
// Every locale except the current one, for the reciprocal hreflang tags.
const altLangs = langCodes.filter((code) => code !== lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const origin = site.origin;
const isDe = lang === 'de';
// Single source of truth for the visible byline and schema dateModified.
const lastReviewed = '2026-07-22';

// ---------------------------------------------------------------------------
// Structured data. AI answer engines lean heavily on JSON-LD to resolve a site
// to a real-world entity, so the organisation node carries the full legal
// identity, accreditation and contact block rather than just a name.
// ---------------------------------------------------------------------------
const organization = {
  '@type': ['EducationalOrganization', 'Organization', 'LocalBusiness'],
  '@id': `${origin}/#organization`,
  name: company.name,
  legalName: 'WAMOCON Academy GmbH',
  alternateName: ['WAMOCON Academy', 'WMA', 'Test-IT Academy'],
  url: `${origin}/`,
  logo: `${origin}${assets.logo}`,
  image: `${origin}${assets.hero}`,
  description: pick(lang, {
    de: 'IT-Bildungszentrum in Eschborn für Softwaretesting und Testmanagement. Von ISTQB als akkreditierter Trainingsanbieter für deutschsprachige CTFL 4.0- und Agile-Tester-1.0-Materialien gelistet.',
    en: 'IT training centre in Eschborn for software testing and test management. Listed by ISTQB as an accredited training provider for German-language CTFL 4.0 and Agile Tester 1.0 materials.',
  }),
  telephone: company.phone,
  email: company.email,
  vatID: 'DE344930486',
  identifier: 'Amtsgericht Frankfurt am Main, HRB 123666',
  foundingLocation: { '@type': 'Place', name: 'Eschborn, Germany' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mergenthalerallee 79–81',
    postalCode: '65760',
    addressLocality: 'Eschborn',
    addressRegion: 'Hessen',
    addressCountry: 'DE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 50.1350963, longitude: 8.5722177 },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '09:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '14:00' },
  ],
  areaServed: ['Germany', 'Austria', 'Switzerland', 'European Union'],
  knowsLanguage: ['de', 'en'],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'ISTQB Accredited Training Provider',
    credentialCategory: 'Accreditation',
    recognizedBy: {
      '@type': 'Organization',
      name: 'International Software Testing Qualifications Board (ISTQB)',
      url: 'https://www.istqb.org/',
    },
  },
  knowsAbout: [
    'Software testing',
    'ISTQB Certified Tester Foundation Level',
    'ISTQB Agile Tester',
    'Test management',
    'Test automation',
    'Quality assurance',
    'IT career entry',
  ],
  parentOrganization: {
    '@type': 'Organization',
    name: 'WAMOCON GmbH',
    url: 'https://www.wamocon.com/',
  },
  // sameAs asserts entity identity. The parent company's LinkedIn page must NOT
  // appear here — it would tell every AI model that WAMOCON Academy GmbH (HRB
  // 123666) and WAMOCON GmbH (HRB 103893) are the same legal entity.
  sameAs: [
    'https://www.youtube.com/@WAMOCONACADEMY',
    'https://www.facebook.com/WAMOCONACADEMY/',
    'https://www.instagram.com/bildungszentrum_wma/',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: company.phone,
      email: company.email,
      contactType: 'admissions',
      availableLanguage: ['German', 'English'],
      areaServed: 'EU',
    },
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  url: `${origin}/`,
  name: 'WAMOCON Academy',
  description,
  inLanguage: Object.values(localeTags),
  publisher: { '@id': `${origin}/#organization` },
};

const isHome = ['/', '/en/', '/tr/'].includes(Astro.url.pathname);
const trail = [
  {
    name: pick(lang, { de: 'Startseite', en: 'Home' }),
    path: pick(lang, { de: '/', en: '/en/' }),
  },
  ...breadcrumbs,
  // A breadcrumb that never names the current page conveys no position and is
  // ineligible for the breadcrumb rich result.
  ...(!isHome && breadcrumbs.length === 0
    ? [{ name: title.split('|')[0].trim(), path: Astro.url.pathname }]
    : []),
];
const breadcrumbList = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: trail.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.path, site).href,
  })),
};

const webPage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: localeTags[lang],
  isPartOf: { '@id': `${origin}/#website` },
  about: { '@id': `${origin}/#organization` },
  breadcrumb: { '@id': `${canonical}#breadcrumb` },
  datePublished: '2026-07-01',
  dateModified: lastReviewed,
  reviewedBy: { '@id': `${origin}/#waleri-moretz` },
  publisher: { '@id': `${origin}/#organization` },
  primaryImageOfPage: { '@type': 'ImageObject', url: new URL(image, site).href },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.faq__item h3', '.faq__item > p'],
  },
};

// Named expert behind the training content. E-E-A-T signals (a real person with
// verifiable credentials) are what let AI systems treat the content as
// authoritative rather than anonymous marketing copy.
const expert = {
  '@type': 'Person',
  '@id': `${origin}/#waleri-moretz`,
  name: 'Waleri Moretz',
  honorificPrefix: 'Dipl.-Ing.',
  jobTitle: pick(lang, {
    de: 'Geschäftsführer und Trainer',
    en: 'Managing Director and Trainer',
  }),
  description: pick(lang, {
    de: 'Diplom-Ingenieur, Geschäftsführer der WAMOCON Academy GmbH und der WAMOCON GmbH. Leitet seit 2015 Testmanagement-Projekte für Konzerne und unterrichtet ISTQB-Lehrpläne.',
    en: 'Graduate engineer, managing director of WAMOCON Academy GmbH and WAMOCON GmbH. Has led enterprise test-management projects since 2015 and teaches the ISTQB syllabi.',
  }),
  worksFor: { '@id': `${origin}/#organization` },
  knowsAbout: ['Software testing', 'Test management', 'ISTQB Certified Tester', 'Quality assurance'],
  knowsLanguage: ['de', 'en'],
  url: `${origin}/`,
  // Resolves this Person to the same human on the sister site.
  sameAs: ['https://www.wamocon.com/#waleri-moretz'],
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, breadcrumbList, webPage, expert, ...schema],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- The brand face, self-hosted (see styles/fonts.css for why not the
         Google CDN). Preloading only the latin subset: it carries all of German
         and English, so latin-ext would be bytes almost no visitor renders.
         crossorigin is required even same-origin, because fonts are always
         fetched in CORS mode; without it the preload is discarded and
         refetched. -->
    <link
      rel="preload"
      href="/fonts/open-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title.includes('WAMOCON') ? title : `${title} | WAMOCON Academy`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={lang} href={canonical} />
        {altLangs.map((code) => (
          <link rel="alternate" hreflang={code} href={new URL(altPaths[code], site).href} />
        ))}
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site).href} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="WAMOCON Academy" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {altLangs.map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)}
    <meta name="author" content="WAMOCON Academy GmbH" />
    <meta name="theme-color" content="#0d0d0d" />
    {!noindex && (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    {!noindex && (
      <link rel="alternate" hreflang="x-default" href={isDe ? canonical : new URL(altPaths.de, site).href} />
    )}
    <!-- Favicons (WAMOCON Academy wordmark logo) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Marks the document as scripted before first paint, so the scroll-reveal
         start state (opacity: 0) only applies where JS can undo it. Without
         this, a visitor with JavaScript disabled sees an empty page. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {pick(lang, { de: 'Zum Inhalt springen', en: 'Skip to content' })}
    </a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} showContact={showFooterContact} />
    <CookieBanner lang={lang} />
    <ChatWidget lang={lang} />

    <script>
      const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));
      const show = (el: Element) => el.classList.add('is-visible');
      // Siblings that reveal together are staggered so a grid of cards arrives
      // as a sequence rather than a single block. An explicit data-reveal-delay
      // always wins. The cap keeps a long list from crawling in.
      const seen = new Map<Element, number>();
      revealEls.forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        if (el.dataset.revealDelay) {
          el.style.transitionDelay = `${Number(el.dataset.revealDelay) || 0}ms`;
          return;
        }
        const parent = el.parentElement;
        if (!parent) return;
        const index = seen.get(parent) ?? 0;
        seen.set(parent, index + 1);
        if (index > 0) el.style.transitionDelay = `${Math.min(index * 80, 400)}ms`;
      });
      // Safety sweep. The observer alone is not deterministic: on a very tall
      // page a fast flick-scroll or a jump to an anchor can coalesce entries to
      // a final "not intersecting" state, leaving content stuck at opacity 0.
      // This reveals anything the reader has already scrolled to, and is cheap
      // because revealed elements are dropped from the list.
      let pending = revealEls.slice();
      let queued = false;
      const sweep = () => {
        queued = false;
        const vh = window.innerHeight;
        pending = pending.filter((el) => {
          if (el.classList.contains('is-visible')) return false;
          const rect = el.getBoundingClientRect();
          if (rect.width === 0 && rect.height === 0) return true;
          if (rect.top < vh * 0.92 && rect.bottom > 0) {
            show(el);
            return false;
          }
          return true;
        });
        if (!pending.length) {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        }
      };
      const onScroll = () => {
        if (queued) return;
        queued = true;
        window.requestAnimationFrame(sweep);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            show(entry.target);
            observer.unobserve(entry.target);
          }),
          // Fire slightly before the element reaches the fold so the motion has
          // finished by the time the reader's eye arrives.
          { threshold: 0.08, rootMargin: '0px 0px -8% 0px' }
        );
        revealEls.forEach((el) => observer.observe(el));
        // Last-resort guard only. An element that never intersects — inside a
        // collapsed or zero-height container, say — must not stay invisible
        // forever. This used to fire at 1s, which revealed the whole page
        // before the reader could scroll to any of it.
        window.setTimeout(() => revealEls.forEach(show), 15000);
      } else revealEls.forEach(show);
    </script>

    <script is:inline define:vars={{ turnstileSiteKey, thanksHref }}>
      // @ts-nocheck
      // Form status messages, per locale. Falls back to German for unknown values.
      const FORM_MESSAGES = {
        de: {
          captcha: 'Bitte bestätigen Sie die Sicherheitsprüfung.',
          failed: 'Die Anfrage konnte nicht gesendet werden. Bitte versuchen Sie es erneut oder rufen Sie uns an.',
        },
        en: {
          captcha: 'Please complete the security check.',
          failed: 'The request could not be sent. Please try again or call us.',
        },
      };
      const messagesFor = (code) => FORM_MESSAGES[code] || FORM_MESSAGES.de;

      const isLocalPreview = window.location.hostname === '127.0.0.1' || window.location.hostname === 'localhost';
      // The production key is domain-locked; on localhost use Cloudflare's always-pass
      // test key so the captcha still renders and can be tested.
      const ACTIVE_TURNSTILE_SITE_KEY = isLocalPreview ? '1x00000000000000000000AA' : turnstileSiteKey;
      let turnstileLoader;

      const loadTurnstile = () => {
        if (!ACTIVE_TURNSTILE_SITE_KEY || window.turnstile) return Promise.resolve();
        if (turnstileLoader) return turnstileLoader;
        turnstileLoader = new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
          script.async = true;
          script.defer = true;
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });
        return turnstileLoader;
      };

      const ensureTurnstile = async (form) => {
        if (!ACTIVE_TURNSTILE_SITE_KEY || form.querySelector('.cf-turnstile')) return;
        await loadTurnstile();
        if (!window.turnstile || form.querySelector('.cf-turnstile')) return;
        const container = document.createElement('div');
        container.className = 'cf-turnstile';
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'cf-turnstile-response';
        const submit = form.querySelector('button[type="submit"]');
        if (submit) submit.before(container, hidden);
        else form.append(container, hidden);
        form.dataset.turnstileWidget = String(window.turnstile.render(container, {
          sitekey: ACTIVE_TURNSTILE_SITE_KEY,
          theme: 'dark',
          size: window.matchMedia('(max-width: 479px)').matches ? 'compact' : 'flexible',
          callback: (token) => { hidden.value = token; },
          'error-callback': () => { hidden.value = ''; },
          'expired-callback': () => { hidden.value = ''; },
        }));
      };

      document.querySelectorAll('form.js-lead-form').forEach((form) => {
        const startProtection = () => ensureTurnstile(form).catch(() => {});
        form.addEventListener('focusin', startProtection, { once: true });
        form.addEventListener('pointerenter', startProtection, { once: true });
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const status = form.querySelector('.lead-form__status');
          const language = form.querySelector('input[name="lang"]')?.value || 'de';
          if (ACTIVE_TURNSTILE_SITE_KEY) {
            await ensureTurnstile(form).catch(() => {});
            if (!form.querySelector('input[name="cf-turnstile-response"]')?.value) {
              if (status) {
                status.textContent = messagesFor(language).captcha;
                status.hidden = false;
              }
              return;
            }
          }
          const button = form.querySelector('button[type="submit"]');
          if (button) button.disabled = true;
          const data = new FormData(form);
          const payload = {
            type: String(data.get('type') || 'lead'),
            source: window.location.pathname,
            lang: String(data.get('lang') || 'de'),
            name: String(data.get('name') || ''),
            phone: String(data.get('phone') || ''),
            email: String(data.get('email') || ''),
            comment: String(data.get('comment') || data.get('message') || ''),
            publicationConsent: data.get('publicationConsent') === 'on',
            company: String(data.get('company') || ''),
            'cf-turnstile-response': String(data.get('cf-turnstile-response') || ''),
          };
          const redirect = form.dataset.redirect || thanksHref[payload.lang] || thanksHref.de;
          try {
            const response = await fetch('/api/lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-WAMOCON-Form': 'academy' },
              body: JSON.stringify(payload),
            });
            if (!response.ok) throw new Error(`Lead endpoint returned ${response.status}`);
            window.location.assign(redirect);
          } catch {
            if (status) {
              status.textContent = messagesFor(language).failed;
              status.hidden = false;
            }
            if (button) button.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
