# Microsoft Graph application credentials
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Optional delegated-token alternative
GRAPH_REFRESH_TOKEN=
GRAPH_PUBLIC_CLIENT=false

# Mailboxes
GRAPH_SENDER=info@test-it-academy.de
LEAD_RECIPIENT=info@test-it-academy.de

# Comma-separated, no trailing slash
SITE_ORIGINS=https://test-it-academy.com,https://www.test-it-academy.com
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Website assistant (Open WebUI / LiteLLM) ----
# The browser never sees these: api/chat.js is the only caller.
AI_API_KEY=
AI_BASE_URL=https://sokrates.test-qualitaetsmanagement.com
# Optional. Must match a model id served by AI_BASE_URL.
AI_MODEL=sokrates-fable-qwen27
# Optional. Upstream timeout in ms (default 8500, sized for Vercel Hobby's 10s
# function limit). Raise it, and the function's maxDuration, on a longer plan.
AI_TIMEOUT_MS=8500
# Only if the AI hostname sits behind Cloudflare Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
